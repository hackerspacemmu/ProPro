<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "tailwind", "new_tailwind" %>
<% end %>
<% breadcrumb :course_settings, @course %>

<% content_for :title, "Course Settings - #{@course.course_name.truncate(TITLE_NAME_LIMIT)} | ProPro" %>

<!-- Full-screen modal overlay mimicking Google Classroom Settings -->
<div class="fixed inset-0 z-50 bg-white overflow-y-auto flex flex-col font-sans">
  
  <%= form_with url: handle_settings_course_path(@course), model: @course, method: :post, id: "course-settings-form", class: "flex flex-col min-h-screen" do |form| %>

    <!-- Sticky Top Navigation -->
    <div class="sticky top-0 z-40 bg-white border-b border-gray-300 px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <%= link_to course_path(@course), class: "p-2 rounded-full hover:bg-gray-100 text-gray-600 transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        <% end %>
        <h1 class="text-xl font-medium text-gray-800">Class settings</h1>
      </div>
      <div>
        <%= form.submit "Save", class: "bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-sm px-6 py-2 rounded-full cursor-pointer transition-colors" %>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="flex-1 w-full max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-10 pb-24">
      
      <div id="flash">
        <%= render "courses/flash" %>
      </div>

      <% if @course.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 mb-6">
          <div class="flex">
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= pluralize(@course.errors.count, "error") %> prohibited saving:
              </h3>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                <% @course.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <%= render "copy_course_overlay", course: @course, mode: "settings" %>

      <!-- SECTION 1: Class Details -->
      <section class="border border-gray-300 rounded-xl overflow-hidden bg-white">
        <div class="p-6 sm:p-8 space-y-6">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">Class Details</h2>
          
          <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all">
            <%= form.label :course_name, "Class name", class: "block text-xs font-medium text-gray-600" %>
            <%= form.text_field :course_name, required: true, class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm mt-1" %>
          </div>

          <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all">
            <%= form.label :course_description, "Project Details", class: "block text-xs font-medium text-gray-600" %>
            <%= form.text_area :course_description, rows: 2, class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm mt-1 resize-none overflow-hidden", data: { controller: "textarea-resize", action: "input->textarea-resize#resize" } %>
          </div>

          <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all">
            <%= form.label :file_link, "Project File Link (URL)", class: "block text-xs font-medium text-gray-600" %>
            <%= form.text_field :file_link, class: "w-full bg-transparent border-none p-0 focus:ring-0 text-blue-600 text-sm mt-1 underline" %>
          </div>

          <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all w-full sm:w-1/2">
            <%= form.label :starting_week, "Starting Week", class: "block text-xs font-medium text-gray-600" %>
            <%= form.text_field :starting_week, required: true, class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm mt-1" %>
          </div>
        </div>
      </section>

      <!-- SECTION 2: General -->
      <section class="border border-gray-300 rounded-xl overflow-hidden bg-white">
        <div class="p-6 sm:p-8 space-y-8">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">General</h2>
          
          <!-- SUBSECTION: Coursecode -->
          <div class="border-b border-gray-200 pb-8">
            <h3 class="text-lg font-medium text-gray-800 mb-4">Coursecode</h3>
            <%= render "course_code_form", course: @course %>
          </div>

          <!-- SUBSECTION: Supervisor Capacity -->
          <div>
            <h3 class="text-lg font-medium text-gray-800 mb-4">Supervisor Capacity</h3>
            
            <div class="space-y-6">
              <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all w-full sm:w-1/2">
                <%= form.label :supervisor_projects_limit, "Maximum Projects per Supervisor", class: "block text-xs font-medium text-gray-600" %>
                <%= form.hidden_field :supervisor_projects_limit %>
                <%= form.number_field :supervisor_projects_limit, id: "supervisor_projects_limit_visible", required: true, disabled: @course.supervisor_auto_calculate_enabled?, class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm mt-1" %>
              </div>

              <!-- Manage Project Allocations and Lecturer exclusions -->
              <%= render "supervisor_capacity_settings", form: form %>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 3: Permissions and Rules -->
      <section class="border border-gray-300 rounded-xl overflow-hidden bg-white">
        <div class="p-6 sm:p-8 space-y-6">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">Permissions and Rules</h2>
          
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden divide-y divide-gray-200">
            
            <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 hover:bg-gray-50 transition-colors">
              <span class="text-sm font-medium text-gray-800 mb-2 sm:mb-0">Allow lecturers to add topics for students to base their proposals on.</span>
              <div class="flex items-center space-x-6">
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :toggle_topics, true, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> Yes
                </label>
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :toggle_topics, false, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> No
                </label>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 hover:bg-gray-50 transition-colors">
              <span class="text-sm font-medium text-gray-800 mb-2 sm:mb-0">Lecturer topics require approval?</span>
              <div class="flex items-center space-x-6">
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :require_coordinator_approval, true, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> Yes
                </label>
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :require_coordinator_approval, false, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> No
                </label>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 hover:bg-gray-50 transition-colors">
              <span class="text-sm font-medium text-gray-800 mb-2 sm:mb-0">Auto-approve unchanged copied topics?</span>
              <div class="flex items-center space-x-6">
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :auto_approve_copied_topics_without_changes, true, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> Yes
                </label>
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :auto_approve_copied_topics_without_changes, false, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> No
                </label>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 hover:bg-gray-50 transition-colors">
              <span class="text-sm font-medium text-gray-800 mb-2 sm:mb-0">Use progress updates?</span>
              <div class="flex items-center space-x-6">
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :use_progress_updates, true, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> Yes
                </label>
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :use_progress_updates, false, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> No
                </label>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 hover:bg-gray-50 transition-colors">
              <span class="text-sm font-medium text-gray-800 mb-2 sm:mb-0">Lecturer views public?</span>
              <div class="flex items-center space-x-6">
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :lecturer_access, true, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> Yes
                </label>
                <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                  <%= form.radio_button :lecturer_access, false, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> No
                </label>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 hover:bg-gray-50 transition-colors">
              <span class="text-sm font-medium text-gray-800 mb-2 sm:mb-0">Number of progress updates</span>
              <div class="w-full sm:w-32 bg-[#f1f3f4] rounded-t-md px-3 py-1 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all mt-2 sm:mt-0">
                <%= form.number_field :number_of_updates, class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm text-center" %>
              </div>
            </div>

          </div>

          <div class="pt-4">
            <span class="block text-sm font-medium text-gray-800 mb-3">Student can see projects from:</span>
            <div class="bg-gray-50 rounded-lg p-5 space-y-3 border border-gray-200">
              <% Course.student_accesses.keys.map { |key| [key, key.to_s.humanize] }.each_with_index do |(value, label_text), idx| %>
                <div class="flex items-center">
                  <%= form.radio_button :student_access, value, id: "student_access_#{idx}", class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300" %>
                  <%= form.label :student_access, label_text, value: value, for: "student_access_#{idx}", class: "ml-3 block text-sm text-gray-800 cursor-pointer" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4: Grouping (Inlined and Restyled) -->
      <section class="border border-gray-300 rounded-xl overflow-hidden bg-white">
        <div class="p-6 sm:p-8 space-y-6"
             data-controller="grouping-settings"
             data-grouping-settings-enabled-value="<%= @course.grouping_enabled? %>"
             data-grouping-settings-finalised-value="<%= @course.student_list_finalised? %>">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-200 pb-4 gap-2">
            <div>
              <h2 class="text-3xl font-normal text-gray-800 tracking-tight">Student Self-Grouping <span class="text-xs font-semibold px-2 py-0.5 rounded bg-amber-100 text-amber-800 align-middle">Beta</span></h2>
              <p class="text-xs text-amber-600 mt-1">Group formation in ProPro is still in progress!</p>
            </div>
          </div>

          <!-- Toggle: Allow students to form their own groups -->
          <div class="bg-gray-50 rounded-lg p-4 border border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <span class="text-sm font-medium text-gray-800">Allow students to form their own groups?</span>
            <div class="flex items-center space-x-6">
              <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                <%= form.radio_button :grouping_enabled, true,
                      class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2",
                      data: { action: "change->grouping-settings#toggleEnabled" } %> Yes
              </label>
              <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                <%= form.radio_button :grouping_enabled, false,
                      class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2",
                      data: { action: "change->grouping-settings#toggleEnabled" } %> No
              </label>
            </div>
          </div>

          <!-- Options Section: hidden until grouping enabled -->
          <div data-grouping-settings-target="groupingOptions" class="space-y-8 pl-4 border-l-2 border-blue-200 pt-2">

            <!-- Sub-block: Group Configuration -->
            <div class="space-y-6">
              <span class="block text-xs font-semibold uppercase tracking-wide text-gray-400">
                Group Configuration
              </span>

              <!-- Mode Selection -->
              <div>
                <span class="block text-sm font-medium text-gray-800 mb-1">Student list mode</span>
                <p class="text-xs text-gray-500 mb-4">
                  Choose whether the coordinator knows the exact final count of students.
                </p>

                <div class="space-y-3">
                  <!-- Default Mode Card -->
                  <label class="flex items-start gap-3 p-4 border rounded-lg cursor-pointer transition-colors <%= @course.student_list_finalised? ? 'border-gray-200 bg-white hover:border-blue-300' : 'border-blue-500 bg-blue-50/40 ring-1 ring-blue-500' %>">
                    <%= form.radio_button :student_list_finalised, false,
                          class: "mt-0.5 focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 shrink-0",
                          data: { action: "change->grouping-settings#toggleMode" } %>
                    <div>
                      <span class="block text-sm font-medium text-gray-800">Default</span>
                      <span class="block text-xs text-gray-500 mt-1 leading-relaxed">
                        Students join by code, or the student list may still change. Students form groups within the min/max limits — any leftover students will need lecturer intervention.
                      </span>
                    </div>
                  </label>

                  <!-- Fixed List Mode Card -->
                  <% if @course.persisted? && @course.grouping_enabled? && !@course.student_list_finalised? %>
                    <div class="flex items-start gap-3 p-4 border border-gray-200 rounded-lg bg-gray-50 opacity-60">
                      <div class="mt-0.5 h-4 w-4 shrink-0"></div>
                      <div>
                        <span class="block text-sm font-medium text-gray-400">Final student list</span>
                        <span class="block text-xs text-gray-400 mt-1 leading-relaxed">
                          Fixed list mode cannot be enabled once default mode has been saved.
                        </span>
                      </div>
                    </div>
                  <% else %>
                    <label class="flex items-start gap-3 p-4 border rounded-lg cursor-pointer transition-colors <%= @course.student_list_finalised? ? 'border-blue-500 bg-blue-50/40 ring-1 ring-blue-500' : 'border-gray-200 bg-white hover:border-blue-300' %>">
                      <%= form.radio_button :student_list_finalised, true,
                            class: "mt-0.5 focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 shrink-0",
                            data: { action: "change->grouping-settings#toggleMode" } %>
                      <div>
                        <span class="block text-sm font-medium text-gray-800">Final student list</span>
                        <span class="block text-xs text-gray-500 mt-1 leading-relaxed">
                          I will import students and the student list is final — no new students will be added. The system can automatically determine legal group sizes for every student.
                        </span>
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>

              <!-- Min / Max Group Sizes -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all">
                  <%= form.label :group_min, "Minimum group size", class: "block text-xs font-medium text-gray-600" %>
                  <%= form.number_field :group_min, min: 1, placeholder: "e.g. 3",
                        class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm mt-1",
                        data: { grouping_settings_target: "minMax", action: "input->grouping-settings#clearPreview" } %>
                </div>

                <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all">
                  <%= form.label :group_max, "Maximum group size", class: "block text-xs font-medium text-gray-600" %>
                  <%= form.number_field :group_max, min: 1, placeholder: "e.g. 4",
                        class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm mt-1",
                        data: { grouping_settings_target: "minMax", action: "input->grouping-settings#clearPreview" } %>
                </div>
              </div>

              <!-- Preview Section -->
              <div data-grouping-settings-target="previewSection" class="bg-gray-50 border border-gray-200 rounded-lg p-5 space-y-4">
                <div>
                  <p class="text-sm font-medium text-gray-800">Preview group distribution</p>
                  <p class="text-xs text-gray-500 mt-0.5">
                    Enter an expected student count to see how legal groups would form. Actual numbers will come from enrolled students.
                  </p>
                </div>
                <div class="flex items-center gap-3">
                  <div class="bg-[#f1f3f4] rounded-t-md px-3 py-1 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all w-36">
                    <input type="number" id="grouping_preview_count" name="student_count" min="1" placeholder="e.g. 30" autocomplete="off"
                           class="w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm"
                           hx-get="<%= grouping_preview_course_path(@course) %>"
                           hx-include="[name='student_count'], [name='course[group_min]'], [name='course[group_max]']"
                           hx-params="student_count,course[group_min],course[group_max]"
                           hx-target="#grouping_preview_result"
                           hx-trigger="input changed delay:400ms"
                           data-grouping-settings-target="previewInput">
                  </div>
                  <span class="text-xs font-medium text-gray-600">students</span>
                </div>
                <div id="grouping_preview_result" class="text-sm pt-1"></div>
              </div>
            </div>

            <!-- Sub-block: Student Access -->
            <div class="space-y-6 pt-4 border-t border-gray-100">
              <span class="block text-xs font-semibold uppercase tracking-wide text-gray-400">
                Student Access
              </span>

              <!-- Allow Student Grouping Now Toggle -->
              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 border border-gray-200 rounded-lg bg-white gap-3">
                <div>
                  <span class="block text-sm font-medium text-gray-800">Allow student grouping now</span>
                  <span class="block text-xs text-gray-500 mt-0.5">
                    Students can join, leave, and form groups only when this is on.
                  </span>
                </div>
                <div class="flex items-center gap-6 shrink-0">
                  <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                    <%= form.radio_button :grouping_open, true, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> Open
                  </label>
                  <label class="flex items-center text-sm text-gray-700 cursor-pointer">
                    <%= form.radio_button :grouping_open, false, class: "focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 mr-2" %> Closed
                  </label>
                </div>
              </div>

              <!-- Datetime Window -->
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <div>
                    <span class="block text-sm font-medium text-gray-800">Auto-close window (optional)</span>
                    <span class="block text-xs text-gray-500 mt-0.5">
                      Optionally set specific dates to open and close student access automatically.
                    </span>
                  </div>
                  <button type="button" class="text-xs font-medium text-blue-600 hover:text-blue-800 hover:underline shrink-0"
                          data-action="click->grouping-settings#toggleWindow"
                          data-grouping-settings-target="windowToggleBtn">
                    <%= (@course.grouping_opens_at.present? || @course.grouping_closes_at.present?) ? 'Remove window' : 'Set a window' %>
                  </button>
                </div>

                <div data-grouping-settings-target="windowFields" class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1">
                  <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all">
                    <%= form.label :grouping_opens_at, "Open from", class: "block text-xs font-medium text-gray-600" %>
                    <%= form.datetime_local_field :grouping_opens_at,
                          class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm mt-1",
                          value: @course.grouping_opens_at&.strftime('%Y-%m-%dT%H:%M') %>
                  </div>
                  <div class="bg-[#f1f3f4] rounded-t-md px-4 py-2 border-b border-gray-400 focus-within:bg-[#e8eaed] focus-within:border-blue-600 focus-within:border-b-2 transition-all">
                    <%= form.label :grouping_closes_at, "Close at", class: "block text-xs font-medium text-gray-600" %>
                    <%= form.datetime_local_field :grouping_closes_at,
                          class: "w-full bg-transparent border-none p-0 focus:ring-0 text-gray-800 text-sm mt-1",
                          value: @course.grouping_closes_at&.strftime('%Y-%m-%dT%H:%M') %>
                  </div>
                </div>
              </div>

            </div>

          </div>
        </div>
      </section>

      <!-- Roster and Course Action Footers -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-8 pt-4 border-t border-gray-200">
        <div class="flex gap-3 w-full sm:w-auto">
          <%= link_to "Add Students", add_students_course_path(@course), class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= link_to "Add Lecturers", add_lecturers_course_path(@course), class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>

        <%= link_to "Delete Course", course_path(@course), class: "w-full sm:w-auto inline-flex justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-red-700 bg-red-50 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors", data: { turbo_method: :delete, turbo_confirm: "Are you sure? This cannot be undone." } %>
      </div>

    </main>
  <% end %>
</div>
