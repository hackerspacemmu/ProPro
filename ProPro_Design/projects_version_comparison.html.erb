<% content_for :hide_toggler, true %>
<% content_for :no_sidebar, true %>
<% content_for :hide_breadcrumbs, true %>
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@100..900&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
<!-- ========================================== -->
<!-- APP LAYOUT AREA (WITH DIFF VIEWER APPLIED) -->
<!-- ========================================== -->

<div class="min-h-screen bg-[#f8fafd] text-[#3C4043] font-['Roboto',sans-serif] flex flex-col">

  <!-- 1. GLOBAL HEADER -->
  <header class="flex items-center justify-between px-4 py-3 shrink-0">
    <div class="flex items-center gap-2">
      <button class="p-2 rounded-full hover:bg-[#EEF0F4] text-[#5F6368] transition-colors">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <span class="text-[24px] text-[#5F6368] font-medium tracking-normal">ProPro</span>
      <span class="material-symbols-outlined text-[#5F6368] text-[20px] mx-1">chevron_right</span>
      <span class="text-[24px] text-[#3C4043] font-normal tracking-normal">Grouped Topic Approval Enabled</span>
    </div>
    <div class="flex items-center gap-4 pr-2">
      <button class="text-[15px] font-medium text-[#5F6368] hover:text-[#3C4043] transition-colors">
        Log out
      </button>
    </div>
  </header>

  <!-- 2. LAYOUT WRAPPER -->
  <div class="flex flex-1 overflow-hidden h-[calc(100vh-64px)]">

    <!-- SIDEBAR (Transparent background, sits on #f8fafd) -->
    <aside class="w-[280px] shrink-0 py-3 overflow-y-auto">
      <nav class="flex flex-col gap-1 pr-3">
        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors text-[#3C4043] hover:bg-white/60 font-medium text-[14px] leading-5 tracking-normal">
          <span class="material-symbols-outlined">home</span>
          <span>Home</span>
        </a>
        
        <div class="px-6 py-2 flex items-center justify-between text-[#5F6368] mt-2 cursor-pointer">
          <span style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="font-medium text-[14px] leading-5 tracking-normal">Enrolled</span>
          <span class="material-symbols-outlined text-sm">expand_less</span>
        </div>

        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors text-[#3C4043] hover:bg-white/60 font-medium text-[14px] leading-5 tracking-normal">
          <div class="w-9 h-9 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-sm font-bold shrink-0">F</div>
          <span class="truncate">Foundation 2026</span>
        </a>

        <!-- Active Sidebar Item: Inset Pill -->
        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="flex items-center gap-4 mx-3 px-4 py-3.5 rounded-full bg-[#D3E3FD] text-[#0B57D0] font-medium text-[14px] leading-5 tracking-normal">
          <div class="w-9 h-9 rounded-full bg-[#E1E3E1] text-[#3C4043] flex items-center justify-center text-sm font-bold shrink-0">G</div>
          <span class="truncate font-semibold">Grouped Topic Approval Enabled</span>
        </a>

        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors text-[#3C4043] hover:bg-white/60 font-medium text-[14px] leading-5 tracking-normal">
          <div class="w-9 h-9 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-sm font-bold shrink-0">D</div>
          <span class="truncate">Data Structures</span>
        </a>

        <div class="py-2">
          <div class="border-t border-[#DADCE0]"></div>
        </div>

        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors text-[#3C4043] hover:bg-white/60 font-medium text-[14px] leading-5 tracking-normal">
          <span class="material-symbols-outlined text-[#5F6368]">person</span>
          <span>Edit profile</span>
        </a>
      </nav>
    </aside>

    <!-- MAIN APP CANVAS (No borders or shadows against the sidebar/header edge) -->
    <main class="flex-1 bg-white rounded-tl-[28px] flex overflow-hidden">
      
      <!-- LEFT PANE: Content Area (70% width) -->
      <div class="flex-1 flex flex-col overflow-y-auto">
        
        <!-- Context Header (Sticky Info) -->
        <div class="px-8 pt-8 pb-4">
          <div class="flex items-start justify-between mb-2">
            <div>
              <div class="flex items-center gap-3 mb-1">
                <span class="bg-[#FFF8E1] text-[#F57F17] px-3 py-1 rounded-full text-xs font-medium tracking-wide">Redo</span>
                <span class="text-[14px] text-[#444746]">Returned for revision yesterday</span>
              </div>
              <h1 style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif; font-size: 2.25rem; font-weight: 400; letter-spacing: 0; line-height: 2.75rem; color: #1f1f1f;">Difficult Group Project Group 4</h1>
            </div>
            
            <div class="flex items-center gap-4">
              <!-- Version Selector inside Header -->
              <div class="flex items-center gap-2 mr-2">
                <span class="text-sm font-medium text-[#5F6368]">Version:</span>
                <select class="bg-white border border-[#DADCE0] rounded-[4px] px-3 py-2 text-sm text-[#3C4043] focus:outline-none focus:ring-2 focus:ring-[#1A73E8] focus:border-transparent cursor-pointer">
                  <option>2 of 2 (Current)</option>
                </select>
              </div>
              
              <!-- Split Button Container -->
              <div class="relative group">
                <!-- Button Group -->
                <div class="inline-flex shadow-sm rounded-full">
                  <button class="bg-[#137333] hover:bg-[#0f5c29] text-white pl-5 pr-4 py-2.5 rounded-l-full font-medium text-[14px] transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">check</span>
                    Approve
                  </button>
                  <div class="w-[1px] bg-white/30"></div>
                  <button class="bg-[#137333] hover:bg-[#0f5c29] text-white pl-2 pr-3 py-2.5 rounded-r-full transition-colors flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">arrow_drop_down</span>
                  </button>
                </div>

                <!-- Dropdown Menu (Popover) -->
                <div class="absolute right-0 top-full mt-1.5 w-56 bg-white border border-[#E0E0E0] rounded-lg shadow-lg overflow-hidden z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all origin-top-right">
                  <div class="py-1">
                    <button class="w-full text-left px-4 py-2.5 hover:bg-[#F8F9FA] flex items-center gap-3 transition-colors">
                      <span class="material-symbols-outlined text-[18px] text-[#5F6368]">replay</span>
                      <div class="flex flex-col">
                        <span class="text-[14px] text-[#3C4043] font-medium">Request Changes</span>
                        <span class="text-xs text-[#5F6368]">Return to group for redo</span>
                      </div>
                    </button>
                    <div class="border-t border-[#E0E0E0] my-1"></div>
                    <button class="w-full text-left px-4 py-2.5 hover:bg-[#FCE8E6] flex items-center gap-3 transition-colors">
                      <span class="material-symbols-outlined text-[18px] text-[#C5221F]">block</span>
                      <div class="flex flex-col">
                        <span class="text-[14px] text-[#C5221F] font-medium">Reject Proposal</span>
                        <span class="text-xs text-[#C5221F]/70">Close out permanently</span>
                      </div>
                    </button>
                  </div>
                </div>
                
              </div>
            </div>
          </div>
        </div>

        <!-- Sticky Tabs (Compare Versions Active) -->
        <div class="border-b border-[#E0E0E0] px-8 sticky top-0 bg-white z-10">
          <div class="flex gap-8">
            <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent text-[14px] font-medium leading-5 tracking-normal transition-colors">Project Details</a>
            <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="pb-3 text-[#1A73E8] border-b-4 border-[#1A73E8] text-[14px] font-medium leading-5 tracking-normal">Compare Versions</a>
            <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent text-[14px] font-medium leading-5 tracking-normal transition-colors">Progress Updates</a>
          </div>
        </div>

        <!-- Content Area: Compare Versions -->
        <div class="p-8 max-w-[85rem] w-full mx-auto space-y-8 relative">

          <!-- Compare Toolbar -->
          <div class="flex justify-center mb-8">
             <div class="inline-flex items-center gap-4">
                
                <!-- Left Side: Older Base Version (Yellow / Redo Status Style) -->
                <div class="bg-[#FFF8E1] text-[#F57F17] rounded-full px-4 py-1.5 flex items-center gap-2 transition-colors cursor-pointer border border-transparent hover:border-[#F57F17]/30">
                    <div class="w-1.5 h-1.5 rounded-full bg-[#F57F17]"></div>
                    <select class="bg-transparent text-sm font-medium text-[#F57F17] focus:outline-none cursor-pointer appearance-none">
                       <option>Version 1 (22 Aug 2026)</option>
                       <option>Version 0 (Draft)</option>
                    </select>
                </div>
                
                <!-- Swap/Compare Icon -->
                <div class="text-[#5F6368] flex items-center justify-center shrink-0">
                   <span class="material-symbols-outlined text-[20px]">sync_alt</span>
                </div>
                
                <!-- Right Side: Newer/Current Version (Green / Approved Status Style) -->
                <div class="bg-[#E6F4EA] text-[#137333] rounded-full px-4 py-1.5 flex items-center gap-2 transition-colors cursor-pointer border border-transparent hover:border-[#137333]/30">
                    <div class="w-1.5 h-1.5 rounded-full bg-[#137333]"></div>
                    <select class="bg-transparent text-sm font-medium text-[#137333] focus:outline-none cursor-pointer appearance-none">
                       <option>Version 2 (Current)</option>
                    </select>
                </div>
                
             </div>
          </div>

          <!-- Side-by-Side Diff Layout -->
          <div class="grid grid-cols-2 gap-8 relative">
             <!-- Divider line in the middle -->
             <div class="absolute left-1/2 top-0 bottom-0 w-[1px] bg-[#E0E0E0] -translate-x-1/2 hidden md:block"></div>

             <!-- LEFT COLUMN (V1 / OLDER) -->
             <div class="space-y-8 pr-2">
                
                <!-- Field 1 -->
                <div>
                   <div class="text-xs font-medium text-[#5F6368] mb-2 uppercase tracking-wide">Project Title</div>
                   <div class="p-3 border border-[#E0E0E0] rounded-md bg-[#F8F9FA] text-[#5F6368] text-[14px]">
                      Group Project Group 4
                   </div>
                </div>
                
                <!-- Field 2 -->
                <div>
                   <div class="text-xs font-medium text-[#5F6368] mb-2 uppercase tracking-wide">Target Platform</div>
                   <div class="p-3 border border-[#E0E0E0] rounded-md bg-[#F8F9FA] text-[#5F6368] text-[14px]">
                      Mobile App
                   </div>
                </div>

                <!-- Field 3 (Rich Text) -->
                <div>
                   <div class="text-xs font-medium text-[#5F6368] mb-2 uppercase tracking-wide">Group Project Description</div>
                   <div class="p-5 border border-[#E0E0E0] rounded-md bg-[#F8F9FA] text-[#5F6368] text-[14px] leading-relaxed min-h-[300px]">
                      <h2 class="text-base font-medium text-[#3C4043] mb-2">1. User Account Management</h2>
                      <p class="mb-4">Users can create and manage their accounts. <span class="bg-[#FCE8E6] text-[#C5221F] px-1 rounded line-through">Basic authentication is included.</span></p>
                      
                      <h2 class="text-base font-medium text-[#3C4043] mb-2">2. Item Management</h2>
                      <p>Users can upload items for display.</p>
                   </div>
                </div>
             </div>

             <!-- RIGHT COLUMN (V2 / NEWER) -->
             <div class="space-y-8 pl-2">
                
                <!-- Field 1 -->
                <div>
                   <div class="text-xs font-medium text-[#5F6368] mb-2 uppercase tracking-wide">Project Title</div>
                   <div class="p-3 border border-[#E0E0E0] rounded-md bg-white text-[#3C4043] text-[14px] shadow-sm">
                      <span class="bg-[#E6F4EA] text-[#137333] px-1 rounded font-medium">Difficult</span> Group Project Group 4
                   </div>
                </div>
                
                <!-- Field 2 -->
                <div>
                   <div class="text-xs font-medium text-[#5F6368] mb-2 uppercase tracking-wide">Target Platform</div>
                   <div class="p-3 border border-[#E0E0E0] rounded-md bg-white text-[#3C4043] text-[14px] shadow-sm">
                      <span class="bg-[#FCE8E6] text-[#C5221F] px-1 rounded line-through mr-1">Mobile App</span> <span class="bg-[#E6F4EA] text-[#137333] px-1 rounded font-medium">Web App</span>
                   </div>
                </div>

                <!-- Field 3 (Rich Text) -->
                <div>
                   <div class="text-xs font-medium text-[#5F6368] mb-2 uppercase tracking-wide">Group Project Description</div>
                   <div class="p-5 border border-[#E0E0E0] rounded-md bg-white text-[#3C4043] text-[14px] leading-relaxed min-h-[300px] shadow-sm">
                      <h2 class="text-base font-medium text-[#1f1f1f] mb-2">1. User Account Management</h2>
                      <p class="mb-4">Users can create and manage their accounts. <span class="bg-[#E6F4EA] text-[#137333] px-1 rounded font-medium">OAuth2 authentication and role-based permissions are included.</span></p>
                      
                      <h2 class="text-base font-medium text-[#1f1f1f] mb-2">2. Item Management <span class="bg-[#E6F4EA] text-[#137333] px-1 rounded text-sm font-medium ml-1">and Trading</span></h2>
                      <p>Users can upload items for display<span class="bg-[#E6F4EA] text-[#137333] px-1 rounded font-medium">, request trades, and process transactions securely via the marketplace flow.</span></p>
                   </div>
                </div>
             </div>
          </div>
        </div>
      </div>

      <!-- RIGHT PANE: Persistent Comments Sidebar (30% width) -->
      <div class="w-[380px] bg-[#f8fafd] border-l border-[#E0E0E0] flex flex-col shrink-0">
        
        <div class="px-6 py-4 border-b border-[#E0E0E0] flex items-center justify-between bg-white shrink-0">
          <h2 style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif; font-size: 1rem; font-weight: 500; letter-spacing: 0; line-height: 1.5rem; color: #1f1f1f;">Comments</h2>
          <span class="bg-[#F1F3F4] text-[#3C4043] px-2 py-0.5 rounded-full text-xs font-medium">7</span>
        </div>

        <div class="flex-1 overflow-y-auto p-6 space-y-6">
          
          <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-4 flex items-center gap-2">
            Comments for V1
          </div>
          
          <!-- Comment 1 -->
          <div class="flex gap-3 group">
            <div class="w-8 h-8 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-xs font-medium shrink-0">L1</div>
            <div class="flex-1">
              <div class="flex justify-between items-start mb-1">
                <span class="text-sm font-medium text-[#137333]">lecturer1</span>
                <span class="text-[14px] text-[#444746]">1 day ago</span>
              </div>
              <p class="text-[14px] text-[#3C4043]">Hey everyone, please expand on the historical reporting aspect in your description.</p>
            </div>
            <button class="text-[#5F6368] hover:text-[#C5221F] opacity-0 group-hover:opacity-100 transition-opacity self-start mt-0.5">
              <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
          </div>

          <!-- Comment 2 -->
          <div class="flex gap-3 group">
            <div class="w-8 h-8 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-xs font-medium shrink-0">L1</div>
            <div class="flex-1">
              <div class="flex justify-between items-start mb-1">
                <span class="text-sm font-medium text-[#137333]">lecturer1</span>
                <span class="text-[14px] text-[#444746]">1 day ago</span>
              </div>
              <p class="text-[14px] text-[#3C4043]">Also make sure you attach the mockups before the deadline.</p>
            </div>
            <button class="text-[#5F6368] hover:text-[#C5221F] opacity-0 group-hover:opacity-100 transition-opacity self-start mt-0.5">
              <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
          </div>

        </div>

        <!-- Comment Input Box -->
        <div class="p-4 bg-white border-t border-[#E0E0E0] shrink-0">
          <div class="border border-[#DADCE0] rounded-lg focus-within:border-[#1A73E8] focus-within:ring-1 focus-within:ring-[#1A73E8] transition-all bg-white flex items-end">
            <textarea rows="1" class="w-full bg-transparent border-none p-3 text-[#3C4043] focus:ring-0 text-[14px] resize-none min-h-[44px] outline-none" placeholder="Write a comment..."></textarea>
            <button class="p-2 m-1 text-[#1A73E8] hover:bg-[#F1F3F4] rounded-full transition-colors flex items-center justify-center">
              <span class="material-symbols-outlined text-[20px]">send</span>
            </button>
          </div>
        </div>

      </div>

    </main>
  </div>
</div>