  <!-- ============================================== -->
  <!-- RECORD UPDATE MODAL (Hidden by default)          -->
  <!-- In a real app, remove the 'hidden' class to show -->
  <!-- ============================================== -->
  <div id="progress-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden">
    <!-- Dark Backdrop -->
    <div class="absolute inset-0 bg-black/50 transition-opacity"></div>
    
    <!-- Modal Dialog (Material 3 standard rounded-3xl / 28px) -->
    <div class="relative bg-white rounded-[28px] shadow-xl w-full max-w-lg overflow-hidden flex flex-col m-4">
      
      <!-- Modal Header -->
      <div class="px-6 pt-6 pb-4 flex items-center justify-between">
        <h2 style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="text-[22px] font-normal text-[#1f1f1f]">Record Progress Update</h2>
        <button class="text-[#5F6368] hover:bg-[#F1F3F4] rounded-full p-2 transition-colors flex items-center justify-center">
          <span class="material-symbols-outlined text-[24px]">close</span>
        </button>
      </div>

      <!-- Modal Body (Form Fields) -->
      <div class="px-6 py-2 space-y-6">
        
        <!-- Status Dropdown -->
        <div>
          <label class="block text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-2">Status</label>
          <div class="relative">
            <select class="w-full bg-white border border-[#DADCE0] rounded-[4px] pl-4 pr-10 py-3.5 text-[#3C4043] focus:outline-none focus:ring-2 focus:ring-[#1A73E8] focus:border-transparent appearance-none cursor-pointer text-[14px]">
              <option value="" disabled selected>Select an overall status...</option>
              <option value="no_progress">No Progress</option>
              <option value="unsatisfactory">Unsatisfactory</option>
              <option value="satisfactory">Satisfactory</option>
              <option value="excellent">Excellent</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#5F6368] pointer-events-none">arrow_drop_down</span>
          </div>
        </div>

        <!-- Feedback Textarea -->
        <div>
          <label class="block text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-2">Feedback</label>
          <textarea rows="5" class="w-full bg-white border border-[#DADCE0] rounded-[4px] px-4 py-3.5 text-[#3C4043] focus:outline-none focus:ring-2 focus:ring-[#1A73E8] focus:border-transparent resize-none text-[14px]" placeholder="Provide details on the group's progress..."></textarea>
          <p class="text-xs text-[#5F6368] mt-2">Markdown formatting is supported.</p>
        </div>

      </div>

      <!-- Modal Footer (Actions) -->
      <div class="px-6 py-6 flex justify-end gap-2">
        <button class="text-[#1A73E8] hover:bg-[#F8F9FA] px-5 py-2.5 rounded-full font-medium text-[14px] transition-colors">
          Cancel
        </button>
        <button class="bg-[#1A73E8] hover:bg-[#1B66C9] text-white px-5 py-2.5 rounded-full font-medium text-[14px] transition-colors shadow-sm">
          Save Update
        </button>
      </div>

    </div>
  </div>

