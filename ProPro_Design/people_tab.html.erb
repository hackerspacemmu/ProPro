<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>People - ProPro</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Material Symbols for Google Material Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap');
    
    .g-checkbox {
      accent-color: #1A73E8;
      width: 18px;
      height: 18px;
      cursor: pointer;
    }
  </style>
</head>
<body class="bg-[#f8fafd] text-[#3C4043] font-['Roboto',sans-serif] h-screen flex flex-col overflow-hidden">

  <!-- ========================================== -->
  <!-- HEADER                                     -->
  <!-- ========================================== -->
  <header class="flex items-center justify-between gap-3 px-4 py-3 shrink-0">
    <div class="flex items-center gap-2 min-w-0">
      <button type="button" aria-label="Toggle sidebar" class="lg:hidden shrink-0 p-2 rounded-full hover:bg-[#EEF0F4] text-[#5F6368] transition-colors">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <span class="shrink-0 text-[24px] text-[#5F6368] font-medium" style="font-family: 'DM Sans', Roboto, Arial, sans-serif;">ProPro</span>
      <nav class="hidden md:flex items-center ml-4 text-sm text-[#5F6368]" style="font-family: 'DM Sans', Roboto, Arial, sans-serif;">
        <a href="#" class="hover:text-gray-900 transition-colors">Home</a>
        <span class="mx-2 material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-[#3C4043] font-medium">Scatting class (G11)</span>
      </nav>
    </div>
    <button type="button" class="shrink-0 m-0 text-[15px] font-medium text-[#5F6368] hover:text-[#3C4043] transition-colors pr-2 bg-transparent border-0 cursor-pointer" style="font-family: 'DM Sans', Roboto, Arial, sans-serif;">
      Log out
    </button>
  </header>

  <!-- ========================================== -->
  <!-- MAIN LAYOUT                                -->
  <!-- ========================================== -->
  <div class="flex flex-1 overflow-hidden">
    
    <!-- SIDEBAR -->
    <aside id="app-sidebar" class="w-[280px] shrink-0 py-3 bg-[#f8fafd] hidden lg:flex flex-col h-full overflow-y-auto">
      <nav class="flex flex-col gap-1 pr-3">
        <a href="#" class="flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors text-[#3C4043] hover:bg-black/5" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">
          <span class="material-symbols-outlined">home</span>
          <span>Home</span>
        </a>
        <div class="px-6 py-2 flex items-center justify-between text-[#5F6368] cursor-pointer">
          <span style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Enrolled</span>
          <span class="material-symbols-outlined text-sm">expand_less</span>
        </div>
        <a href="#" class="flex items-center gap-4 transition-colors truncate mx-3 px-4 py-3.5 rounded-full bg-[#D3E3FD] text-[#0B57D0]" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">
          <div class="w-9 h-9 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-sm font-bold shrink-0">S</div>
          <span class="truncate">Scatting class</span>
        </a>
        <a href="#" class="flex items-center gap-4 transition-colors truncate px-6 py-3.5 rounded-r-full text-[#3C4043] hover:bg-black/5" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">
          <div class="w-9 h-9 rounded-full bg-[#E1E3E1] text-[#3C4043] flex items-center justify-center text-sm font-bold shrink-0">D</div>
          <span class="truncate">Database Systems</span>
        </a>
        <div class="py-2"><div class="border-t border-[#DADCE0]"></div></div>
        <a href="#" class="flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors text-[#3C4043] hover:bg-black/5" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">
          <span class="material-symbols-outlined text-[#5F6368]">person</span>
          <span>Edit profile</span>
        </a>
      </nav>
    </aside>

    <!-- MAIN WORKSPACE -->
    <main class="flex-1 flex flex-col bg-white rounded-tl-[28px] shadow-[-2px_0_12px_rgba(0,0,0,0.03)] border border-gray-100 overflow-hidden">
      
      <!-- TABS -->
      <div class="border-b border-[#E0E0E0] px-6 pt-4 shrink-0 bg-white z-10">
        <div class="flex gap-8 overflow-x-auto no-scrollbar">
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Project Details</button>
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">To Review</button>
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Supervised Projects</button>
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Topic Directory</button>
          
          <!-- Active Tab -->
          <button type="button" class="pb-3 text-[#0B57D0] border-b-4 border-[#0B57D0] transition-colors whitespace-nowrap" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">People</button>
          
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Groups</button>
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Settings</button>
        </div>
      </div>

      <!-- CONTENT -->
      <div class="flex-1 overflow-y-auto bg-white p-6 md:p-10">
        <div class="max-w-5xl mx-auto w-full">

          <!-- 1. TEACHERS SECTION -->
          <section class="mb-14">
            <div class="flex items-center justify-between border-b border-gray-300 pb-4 mb-4">
              <h2 class="text-3xl font-normal text-gray-900 tracking-tight" style="font-family: 'DM Sans', Roboto, Arial, sans-serif;">Teachers</h2>
              <button class="inline-flex items-center justify-center p-2 rounded-full hover:bg-gray-100 text-gray-500 hover:text-[#1A73E8] transition-colors" title="Add Teacher">
                <span class="material-symbols-outlined">person_add</span>
              </button>
            </div>

            <div class="flex flex-col gap-1">
              <!-- CHIAM JUIN HOONG (Exceeding capacity: 2/1) -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 px-4 hover:bg-gray-50 rounded-lg transition-colors group gap-3 sm:gap-0">
                <div class="flex items-center gap-4">
                  <div class="w-9 h-9 rounded-full bg-[#E8F0FE] flex items-center justify-center text-sm font-medium text-[#1A73E8] shrink-0">C</div>
                  <span class="text-sm font-medium text-gray-900">CHIAM JUIN HOONG</span>
                </div>
                <div class="flex items-center gap-4 sm:ml-auto">
                  <div class="flex items-center gap-1.5 text-[#C5221F]" title="Capacity exceeded">
                    <span class="material-symbols-outlined text-[18px]">error</span>
                  </div>
                  <div class="w-24 h-1.5 bg-[#E1E3E1] rounded-full overflow-hidden flex shrink-0">
                    <div class="bg-[#C5221F] w-[100%] h-full rounded-full"></div>
                  </div>
                  <span class="text-sm font-medium text-[#C5221F] w-10 text-right shrink-0">2/1</span>
                  <button class="p-1.5 text-gray-400 hover:bg-gray-200 rounded-full opacity-0 group-hover:opacity-100 transition-all ml-1 shrink-0">
                    <span class="material-symbols-outlined text-[20px]">more_vert</span>
                  </button>
                </div>
              </div>
              
              <!-- Test Lecturer 1 (Normal) -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 px-4 hover:bg-gray-50 rounded-lg transition-colors group gap-3 sm:gap-0">
                <div class="flex items-center gap-4">
                  <div class="w-9 h-9 rounded-full bg-[#E6F4EA] flex items-center justify-center text-sm font-medium text-[#1E8E3E] shrink-0">T</div>
                  <span class="text-sm font-medium text-gray-900">Test Lecturer 1</span>
                </div>
                <div class="flex items-center gap-4 sm:ml-auto">
                  <div class="w-6"></div> <!-- Spacer to align with warning icon above -->
                  <div class="w-24 h-1.5 bg-[#E1E3E1] rounded-full overflow-hidden flex shrink-0">
                    <div class="bg-[#137333] w-[0%] h-full rounded-full"></div>
                  </div>
                  <span class="text-sm font-medium text-[#137333] w-10 text-right shrink-0">0/1</span>
                  <button class="p-1.5 text-gray-400 hover:bg-gray-200 rounded-full opacity-0 group-hover:opacity-100 transition-all ml-1 shrink-0">
                    <span class="material-symbols-outlined text-[20px]">more_vert</span>
                  </button>
                </div>
              </div>

              <!-- Excluded from supervising teacher -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 px-4 hover:bg-gray-50 rounded-lg transition-colors group gap-3 sm:gap-0">
                <div class="flex items-center gap-4">
                  <div class="w-9 h-9 rounded-full bg-[#F1F3F4] flex items-center justify-center text-sm font-medium text-[#5F6368] shrink-0">D</div>
                  <span class="text-sm font-medium text-gray-900">DR. TAN WEE KIAN</span>
                </div>
              </div>
            </div>
          </section>

          <!-- 2. STUDENTS SECTION -->
          <section>
            <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-gray-300 pb-4 mb-4 gap-4">
              <div class="flex items-baseline gap-4 shrink-0">
                <h2 class="text-3xl font-normal text-gray-900 tracking-tight" style="font-family: 'DM Sans', Roboto, Arial, sans-serif;">Students</h2>
                <span class="text-sm font-medium text-gray-500">8 students</span>
              </div>

              <!-- Search Utilities -->
              <div class="flex items-center gap-3 w-full md:w-auto">
                <div class="relative flex items-center flex-1 md:w-[240px]">
                  <span class="material-symbols-outlined absolute left-3 text-gray-400 text-[18px]">search</span>
                  <input type="text" placeholder="Search students..." class="bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md focus:bg-white focus:ring-2 focus:ring-[#1A73E8] focus:border-transparent block w-full pl-9 pr-4 py-2 transition-all outline-none">
                </div>
                <button class="inline-flex items-center justify-center p-2 rounded-full hover:bg-gray-100 text-gray-500 hover:text-[#1A73E8] transition-colors shrink-0" title="Add Student">
                  <span class="material-symbols-outlined">person_add</span>
                </button>
              </div>
            </div>

            <!-- Action Bar Above Table -->
            <div class="flex items-center justify-between mb-3 px-1">
              <div class="flex items-center gap-4">
                <input type="checkbox" class="g-checkbox" title="Select All">
                
                <!-- Actions Dropdown Pill Button -->
                <div class="relative group">
                  <button type="button" class="inline-flex items-center px-4 py-1.5 bg-white border border-gray-300 rounded-full text-sm font-medium text-[#1A73E8] hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-[#1A73E8] transition-colors">
                    <span>Actions</span>
                    <span class="material-symbols-outlined text-[20px] ml-1">arrow_drop_down</span>
                  </button>
                  <!-- Dropdown Menu -->
                  <div class="hidden group-hover:block group-focus-within:block absolute left-0 mt-1 w-44 bg-white border border-gray-200 rounded-md shadow-lg z-20 py-1">
                    <a href="#" class="flex items-center gap-3 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors">
                      <span class="material-symbols-outlined text-[18px] text-gray-500">mail</span>
                      <span>Email students</span>
                    </a>
                    <a href="#" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors">
                      <span class="material-symbols-outlined text-[18px] text-red-500">person_remove</span>
                      <span>Remove</span>
                    </a>
                  </div>
                </div>
              </div>

              <!-- Sort Icon -->
              <button class="p-1.5 text-gray-600 hover:bg-gray-100 rounded-full transition-colors flex items-center justify-center" title="Sort by">
                <span class="material-symbols-outlined text-[20px]">sort_by_alpha</span>
              </button>
            </div>

            <!-- Student Data Table -->
            <div class="overflow-x-auto pb-8 border border-gray-200 rounded-lg">
              <table class="min-w-full table-fixed">
                <thead class="bg-white">
                  <tr>
                    <th class="w-[4%] px-4 py-3 border-b border-gray-200 text-center"></th>
                    <th class="w-[36%] px-4 py-3 text-left text-xs font-medium text-[#5F6368] border-b border-gray-200 uppercase tracking-wider">Student</th>
                    <th class="w-[30%] px-4 py-3 text-left text-xs font-medium text-[#5F6368] border-b border-gray-200 uppercase tracking-wider">Email</th>
                    <th class="w-[22%] px-4 py-3 text-left text-xs font-medium text-[#5F6368] border-b border-gray-200 uppercase tracking-wider">Group</th>
                    <th class="w-[8%] px-4 py-3 border-b border-gray-200"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  
                  <tr class="hover:bg-gray-50 transition-colors group">
                    <td class="px-4 py-3 align-middle text-center">
                      <input type="checkbox" class="g-checkbox">
                    </td>
                    <td class="px-4 py-3 align-middle">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-medium text-gray-700 shrink-0">T</div>
                        <span class="text-sm font-medium text-gray-900">Test Student 1</span>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 align-middle truncate">test.student1@propro.edu</td>
                    <td class="px-4 py-3 text-sm text-gray-700 align-middle font-medium">Group 1</td>
                    <td class="px-4 py-3 align-middle text-right">
                      <button class="p-1.5 text-gray-400 hover:bg-gray-200 rounded-full opacity-0 group-hover:opacity-100 transition-all shrink-0">
                        <span class="material-symbols-outlined text-[20px]">more_vert</span>
                      </button>
                    </td>
                  </tr>

                  <tr class="hover:bg-gray-50 transition-colors group">
                    <td class="px-4 py-3 align-middle text-center">
                      <input type="checkbox" class="g-checkbox">
                    </td>
                    <td class="px-4 py-3 align-middle">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-medium text-gray-700 shrink-0">S</div>
                        <span class="text-sm font-medium text-gray-900">SOO SHI JIAN</span>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 align-middle truncate">soo.shi@propro.edu</td>
                    <td class="px-4 py-3 text-sm text-gray-700 align-middle font-medium">Group 1</td>
                    <td class="px-4 py-3 align-middle text-right">
                      <button class="p-1.5 text-gray-400 hover:bg-gray-200 rounded-full opacity-0 group-hover:opacity-100 transition-all shrink-0">
                        <span class="material-symbols-outlined text-[20px]">more_vert</span>
                      </button>
                    </td>
                  </tr>

                  <tr class="hover:bg-gray-50 transition-colors group">
                    <td class="px-4 py-3 align-middle text-center">
                      <input type="checkbox" class="g-checkbox">
                    </td>
                    <td class="px-4 py-3 align-middle">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-medium text-gray-700 shrink-0">N</div>
                        <span class="text-sm font-medium text-gray-900">NIILESH A/L SARAVANA</span>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 align-middle truncate">niilesh.s@propro.edu</td>
                    <td class="px-4 py-3 text-sm text-gray-700 align-middle font-medium">Group 2</td>
                    <td class="px-4 py-3 align-middle text-right">
                      <button class="p-1.5 text-gray-400 hover:bg-gray-200 rounded-full opacity-0 group-hover:opacity-100 transition-all shrink-0">
                        <span class="material-symbols-outlined text-[20px]">more_vert</span>
                      </button>
                    </td>
                  </tr>

                  <!-- Student without a group -->
                  <tr class="hover:bg-gray-50 transition-colors group">
                    <td class="px-4 py-3 align-middle text-center">
                      <input type="checkbox" class="g-checkbox">
                    </td>
                    <td class="px-4 py-3 align-middle">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-xs font-medium text-gray-700 shrink-0">A</div>
                        <span class="text-sm font-medium text-gray-900">ALICE WONG</span>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 align-middle truncate">alice.wong@propro.edu</td>
                    <td class="px-4 py-3 text-sm text-gray-400 italic align-middle">No group</td>
                    <td class="px-4 py-3 align-middle text-right">
                      <button class="p-1.5 text-gray-400 hover:bg-gray-200 rounded-full opacity-0 group-hover:opacity-100 transition-all shrink-0">
                        <span class="material-symbols-outlined text-[20px]">more_vert</span>
                      </button>
                    </td>
                  </tr>

                  <!-- Invited student with actual name -->
                  <tr class="hover:bg-gray-50 transition-colors group">
                    <td class="px-4 py-3 align-middle text-center">
                      <input type="checkbox" class="g-checkbox">
                    </td>
                    <td class="px-4 py-3 align-middle">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-[#E0E0E0] flex items-center justify-center text-gray-500 shrink-0">
                          <span class="material-symbols-outlined text-[20px]">person</span>
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-medium text-gray-700">Marcus Vance</span>
                          <span class="text-xs text-gray-500">(invited)</span>
                        </div>
                      </div>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 align-middle truncate">vocalfreak525@gmail.com</td>
                    <td class="px-4 py-3 text-sm text-gray-400 italic align-middle">-</td>
                    <td class="px-4 py-3 align-middle text-right">
                      <button class="p-1.5 text-gray-400 hover:bg-gray-200 rounded-full opacity-0 group-hover:opacity-100 transition-all shrink-0">
                        <span class="material-symbols-outlined text-[20px]">more_vert</span>
                      </button>
                    </td>
                  </tr>

                </tbody>
              </table>
            </div>

          </section>
        </div>
      </div>
    </main>
  </div>
</body>
</html>