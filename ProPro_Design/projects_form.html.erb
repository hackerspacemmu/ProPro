<% content_for :hide_toggler, true %>
<% content_for :no_sidebar, true %>
<% content_for :hide_breadcrumbs, true %>
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

<style>
  .font-dm-sans { font-family: 'DM Sans', Roboto, Arial, sans-serif; }
  .font-roboto { font-family: 'Roboto', sans-serif; }
</style>

<div class="min-h-screen bg-[#f8fafd] text-[#3C4043] font-roboto flex flex-col">

  <!-- 1. FULL-SCREEN TAKEOVER HEADER -->
  <header class="sticky top-0 z-30 bg-white border-b border-[#E0E0E0] px-6 py-3.5 flex items-center justify-between shadow-xs">
    
    <!-- Left: Exit & Context Title -->
    <div class="flex items-center gap-4">
      <a href="#" class="p-2 -ml-2 rounded-full hover:bg-[#F1F3F4] text-[#5F6368] hover:text-[#3C4043] transition-colors flex items-center justify-center" title="Close and return to project">
        <span class="material-symbols-outlined text-[22px]">close</span>
      </a>
      
      <div class="h-5 w-[1px] bg-[#DADCE0]"></div>

      <div class="flex items-center gap-3">
        <h1 class="text-[18px] text-[#1f1f1f] font-medium tracking-tight font-dm-sans">Edit Proposal — <span class="text-[#5F6368] font-normal">Pineapple das</span></h1>
        <span class="bg-[#FEF7E0] text-[#B06000] px-2.5 py-0.5 rounded-full text-[11px] font-semibold tracking-wide uppercase font-dm-sans border border-[#F2DE8A]">Pending</span>
      </div>
    </div>

    <!-- Right: Header Actions -->
    <div class="flex items-center gap-3">
      <button type="button" class="px-5 py-2 rounded-full text-[#5F6368] hover:bg-[#F1F3F4] hover:text-[#3C4043] font-medium text-[14px] transition-colors font-dm-sans">
        Discard Changes
      </button>
      <button type="submit" class="bg-[#1A73E8] hover:bg-[#1557B0] text-white px-6 py-2 rounded-full font-medium text-[14px] transition-all flex items-center gap-2 shadow-sm font-dm-sans">
        <span class="material-symbols-outlined text-[18px]">check</span>
        Update Proposal
      </button>
    </div>
  </header>

  <!-- 2. MAIN FORM CANVAS -->
  <main class="flex-1 py-10 px-4 sm:px-6 overflow-y-auto">
    <!-- Increased width to max-w-4xl -->
    <div class="max-w-4xl mx-auto space-y-8">

      <!-- SECTION 1: PROPOSAL METHOD SELECTOR -->
      <section class="bg-white border border-[#E0E0E0] rounded-[12px] p-8 shadow-xs space-y-6">
        <div>
          <h2 class="text-[16px] font-semibold text-[#1f1f1f] tracking-tight font-dm-sans">Proposal Method</h2>
          <p class="text-[13px] text-[#5F6368] mt-1">Select how your proposal is submitted for approval.</p>
        </div>

        <!-- 2-Grid Interactive Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          
          <!-- Card A: Direct Lecturer (ACTIVE) -->
          <div class="border-2 border-[#1A73E8] bg-[#F8F9FA] rounded-[10px] p-5 relative cursor-pointer flex flex-col justify-between transition-all shadow-xs">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 rounded-full bg-[#E8F0FE] text-[#1A73E8] flex items-center justify-center">
                  <span class="material-symbols-outlined text-[20px]">person</span>
                </div>
                <!-- Selection Radio indicator -->
                <div class="w-5 h-5 rounded-full bg-[#1A73E8] text-white flex items-center justify-center">
                  <span class="material-symbols-outlined text-[14px]">check</span>
                </div>
              </div>
              <h3 class="text-[15px] font-semibold text-[#1f1f1f] font-dm-sans">Propose to Lecturer</h3>
              <p class="text-[13px] text-[#5F6368] mt-1">Submit your original project proposal directly to a supervisor.</p>
            </div>

            <!-- Embedded Selected Lecturer Surface -->
            <div class="mt-5 pt-4 border-t border-[#E0E0E0]">
              <div class="text-[11px] font-semibold text-[#5F6368] uppercase tracking-wide mb-2 font-dm-sans">Assigned Supervisor</div>
              <div class="bg-white border border-[#DADCE0] rounded-[8px] p-3 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-[13px] font-bold font-dm-sans">L1</div>
                  <div>
                    <div class="text-[14px] font-medium text-[#1f1f1f] font-dm-sans">Test Lecturer 1</div>
                    <div class="text-[12px] text-[#5F6368]">2/3 approved &middot; <span class="text-[#B06000]">1 pending</span></div>
                  </div>
                </div>
                <button type="button" class="text-[13px] text-[#1A73E8] font-medium hover:underline font-dm-sans">Change</button>
              </div>
            </div>
          </div>

          <!-- Card B: Topic Preset (INACTIVE) -->
          <div class="border border-[#DADCE0] hover:border-[#1A73E8] bg-white rounded-[10px] p-5 cursor-pointer flex flex-col justify-between transition-all">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 rounded-full bg-[#F1F3F4] text-[#5F6368] flex items-center justify-center">
                  <span class="material-symbols-outlined text-[20px]">article</span>
                </div>
                <!-- Selection Radio indicator -->
                <div class="w-5 h-5 rounded-full border border-[#DADCE0]"></div>
              </div>
              <h3 class="text-[15px] font-semibold text-[#1f1f1f] font-dm-sans">Base on a Topic</h3>
              <p class="text-[13px] text-[#5F6368] mt-1">Select from a pre-defined course topic template curated by lecturers.</p>
            </div>

            <div class="mt-5 pt-4 border-t border-[#E0E0E0]/60">
              <button type="button" class="w-full py-2.5 px-3 rounded-[6px] bg-[#F1F3F4] hover:bg-[#E8F0FE] text-[#3C4043] hover:text-[#1A73E8] text-[13px] font-medium transition-colors font-dm-sans flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-[18px]">search</span>
                Browse Topic Catalog
              </button>
            </div>
          </div>

        </div>
      </section>

      <!-- SECTION 2: DYNAMIC PROJECT TEMPLATE FIELDS -->
      <section class="bg-white border border-[#E0E0E0] rounded-[12px] p-8 shadow-xs space-y-8">
        <div class="border-b border-[#E0E0E0] pb-4">
          <h2 class="text-[16px] font-semibold text-[#1f1f1f] tracking-tight font-dm-sans">Project Details</h2>
          <p class="text-[13px] text-[#5F6368] mt-1">Fill out the template fields required for this project category.</p>
        </div>

        <!-- Dynamic Field 1: Short Text -->
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-[#3C4043] uppercase tracking-wide font-dm-sans mb-1.5">
            Project Title <span class="text-[#C5221F]">*</span>
          </label>
          <input type="text" value="Pineapple das" autocomplete="off" class="w-full border border-[#DADCE0] rounded-[6px] px-3.5 py-2.5 text-[14px] text-[#3C4043] focus:outline-none focus:border-[#1A73E8] focus:ring-1 focus:ring-[#1A73E8] transition-shadow">
          <div class="text-[12px] text-[#5F6368] mt-1">*Required</div>
        </div>

        <!-- Dynamic Field 2: Dropdown Selection -->
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-[#3C4043] uppercase tracking-wide font-dm-sans mb-1.5">
            Target Platform <span class="text-[#C5221F]">*</span>
          </label>
          <div class="relative">
            <select class="w-full border border-[#DADCE0] rounded-[6px] px-3.5 py-2.5 pr-10 text-[14px] text-[#3C4043] appearance-none focus:outline-none focus:border-[#1A73E8] focus:ring-1 focus:ring-[#1A73E8] bg-white cursor-pointer">
              <option>Web App</option>
              <option>Mobile App (iOS / Android)</option>
              <option>Desktop Software</option>
              <option>Embedded System</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-[#5F6368]">
              <span class="material-symbols-outlined text-[20px]">expand_more</span>
            </div>
          </div>
          <div class="text-[12px] text-[#5F6368] mt-1">*Required</div>
        </div>

        <!-- Dynamic Field 3: Radio Selection -->
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-[#3C4043] uppercase tracking-wide font-dm-sans mb-1.5">
            Development Methodology <span class="text-[#C5221F]">*</span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-1">
            <label class="flex items-center gap-2.5 p-3 rounded-[6px] border border-[#DADCE0] cursor-pointer hover:bg-[#F8F9FA] transition-colors">
              <input type="radio" name="methodology" class="text-[#1A73E8] border-[#DADCE0] focus:ring-[#1A73E8]">
              <span class="text-[14px] text-[#3C4043]">Agile / Scrum</span>
            </label>
            <label class="flex items-center gap-2.5 p-3 rounded-[6px] border border-[#1A73E8] bg-[#E8F0FE]/40 cursor-pointer transition-colors">
              <input type="radio" name="methodology" checked class="text-[#1A73E8] border-[#DADCE0] focus:ring-[#1A73E8]">
              <span class="text-[14px] font-medium text-[#1A73E8]">Waterfall</span>
            </label>
            <label class="flex items-center gap-2.5 p-3 rounded-[6px] border border-[#DADCE0] cursor-pointer hover:bg-[#F8F9FA] transition-colors">
              <input type="radio" name="methodology" class="text-[#1A73E8] border-[#DADCE0] focus:ring-[#1A73E8]">
              <span class="text-[14px] text-[#3C4043]">Kanban</span>
            </label>
          </div>
          <div class="text-[12px] text-[#5F6368] mt-1">*Required</div>
        </div>

        <!-- Dynamic Field 4: Rich Text Paragraph -->
        <div class="space-y-1">
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-[#3C4043] uppercase tracking-wide font-dm-sans">
              Detailed Description & Specifications <span class="text-[#C5221F]">*</span>
            </label>
            <span class="text-[11px] text-[#5F6368]">Markdown supported</span>
          </div>
          
          <!-- WYSIWYG Container -->
          <div class="border border-[#DADCE0] rounded-[6px] overflow-hidden focus-within:border-[#1A73E8] focus-within:ring-1 focus-within:ring-[#1A73E8] transition-shadow">
            <div class="bg-[#F8F9FA] border-b border-[#DADCE0] px-2 py-1.5 flex items-center gap-1 flex-wrap">
              <button type="button" class="p-1.5 text-[#5F6368] hover:bg-[#E8F0FE] hover:text-[#1A73E8] rounded-[4px] transition-colors"><span class="material-symbols-outlined text-[18px]">format_bold</span></button>
              <button type="button" class="p-1.5 text-[#5F6368] hover:bg-[#E8F0FE] hover:text-[#1A73E8] rounded-[4px] transition-colors"><span class="material-symbols-outlined text-[18px]">format_italic</span></button>
              <button type="button" class="p-1.5 text-[#5F6368] hover:bg-[#E8F0FE] hover:text-[#1A73E8] rounded-[4px] transition-colors"><span class="material-symbols-outlined text-[18px]">format_underlined</span></button>
              <div class="w-[1px] h-4 bg-[#DADCE0] mx-1"></div>
              <button type="button" class="p-1.5 text-[#5F6368] hover:bg-[#E8F0FE] hover:text-[#1A73E8] rounded-[4px] transition-colors"><span class="material-symbols-outlined text-[18px]">format_list_bulleted</span></button>
              <button type="button" class="p-1.5 text-[#5F6368] hover:bg-[#E8F0FE] hover:text-[#1A73E8] rounded-[4px] transition-colors"><span class="material-symbols-outlined text-[18px]">format_list_numbered</span></button>
              <div class="w-[1px] h-4 bg-[#DADCE0] mx-1"></div>
              <button type="button" class="p-1.5 text-[#5F6368] hover:bg-[#E8F0FE] hover:text-[#1A73E8] rounded-[4px] transition-colors"><span class="material-symbols-outlined text-[18px]">link</span></button>
              <button type="button" class="p-1.5 text-[#5F6368] hover:bg-[#E8F0FE] hover:text-[#1A73E8] rounded-[4px] transition-colors"><span class="material-symbols-outlined text-[18px]">code</span></button>
            </div>
            <textarea rows="8" class="w-full p-4 text-[14px] text-[#3C4043] bg-white border-none focus:ring-0 resize-y outline-none leading-relaxed">## 1. User Account Management
- User Registration (Email, Username, Password)
- Profile Management & Settings

## 2. Collectible Item Management
- Upload item images & set pricing/trade options
- Item search & filtering system</textarea>
          </div>
          <div class="text-[12px] text-[#5F6368] mt-1">*Required</div>
        </div>

      </section>

      <!-- Bottom Action Footer bar for mobile/scrolled view -->
      <div class="flex items-center justify-between pt-4 pb-8">
        <a href="#" class="text-[14px] font-medium text-[#5F6368] hover:text-[#3C4043] font-dm-sans">Cancel</a>
        <button type="submit" class="bg-[#1A73E8] hover:bg-[#1557B0] text-white px-6 py-2.5 rounded-full font-medium text-[14px] transition-all flex items-center gap-2 shadow-sm font-dm-sans">
          <span class="material-symbols-outlined text-[18px]">check</span>
          Update Proposal
        </button>
      </div>

    </div>
  </main>

</div>
