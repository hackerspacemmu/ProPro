<% content_for :no_sidebar, true %>
<% content_for :no_header, true %>
<% content_for :no_footer, true %>
<% content_for :hide_toggler, true %>
<% content_for :hide_breadcrumbs, true %>
<% content_for :body_class, "bg-surface-tint" %>
<% breadcrumb :user_profile %>

<% content_for :title, "Edit Profile | ProPro" %>

<div class="min-h-screen bg-surface-tint text-on-surface font-['Roboto',sans-serif] flex flex-col">

  <%= form_with url: user_edit_path, model: @user, method: :post, id: "edit-profile-form", class: "flex flex-col min-h-screen" do |form| %>

    <!-- Sticky Top Navigation -->
    <header class="sticky top-0 z-30 bg-white border-b border-outline-variant px-4 sm:px-6 py-3 flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-6">
        <%= link_to "/", title: "Close and return home", class: "p-2 -ml-2 rounded-full hover:bg-surface-variant text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center" do %>
          <span class="material-symbols-outlined text-[24px]">close</span>
        <% end %>
        <h1 style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="text-xl font-medium text-on-surface-strong tracking-tight">Edit Profile</h1>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "Discard Changes", "/", class: "px-5 py-2 rounded-full text-on-surface-variant hover:bg-surface-variant hover:text-on-surface font-medium text-[14px] transition-colors" %>
        <%= form.submit "Save", class: "bg-primary hover:bg-primary-hover text-white px-6 py-2 rounded-full font-medium text-[14px] transition-all shadow-sm cursor-pointer" %>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 py-10 px-4 sm:px-6 overflow-y-auto">
      <div class="max-w-4xl mx-auto space-y-8 pb-8">

        <div id="flash">
          <%= render "courses/flash" %>
        </div>

        <% if @user.errors.any? %>
          <div class="rounded-lg border border-error-container-border bg-error-container p-4">
            <h3 class="text-sm font-medium text-error">
              <%= pluralize(@user.errors.count, "error") %> prohibited saving:
            </h3>
            <ul class="mt-2 text-sm text-error list-disc list-inside">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- SECTION 1: Account Details -->
        <section class="bg-white border border-outline-variant rounded-[12px] p-8">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">Account Details</h2>

          <div class="space-y-6">
            <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :name, "Name", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
              <%= form.text_field :name, placeholder: "e.g. jdoe123", class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1" %>
            </div>

            <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :web_link, "Link to MMU Directory or Portfolio", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
              <%= form.text_field :web_link, placeholder: "https://...", class: "w-full bg-transparent border-none p-0 text-primary focus:ring-0 focus:outline-none text-[14px] mt-1 underline" %>
            </div>

            <div>
              <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
                <%= form.label :description, "Description", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
                <%= form.text_area :description, rows: 5, class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1 resize-none overflow-hidden", data: { controller: "textarea-resize", action: "input->textarea-resize#resize" } %>
              </div>
              <p class="text-[13px] text-on-surface-variant mt-2 leading-relaxed">
                Describe yourself to indicate to students what project topics you may accept for the courses you are teaching. Also indicate Consultation Hours (days of week and time) when students can meet you to request you as supervisor in case of FYP/Mini IT Project.
              </p>
            </div>
          </div>
        </section>

        <!-- SECTION 2: Change Password -->
        <section class="bg-white border border-outline-variant rounded-[12px] p-8">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">Change Password</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :new_password, "New Password", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
              <%= form.password_field :new_password, placeholder: "Leave blank to keep current", class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1" %>
            </div>

            <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :new_password_confirmation, "Confirm Password", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
              <%= form.password_field :new_password_confirmation, placeholder: "Confirm new password", class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1" %>
            </div>
          </div>
        </section>

      </div>
    </main>
  <% end %>
</div>