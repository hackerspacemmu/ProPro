<% content_for :body_class, "bg-surface-tint" %>

<%# --- Breadcrumbs --- %>
<% breadcrumb :course, @course %>
<% breadcrumb :course_participant_profile, @course, @student.name %>

<% content_for :title do %>
  <%= @student.name %>
  - Student Profile | ProPro
<% end %>

<%# --- Status pill palette (mirrors shared/_list_item) --- %>
<%
  status_display = (@status || "not_submitted").to_s.downcase
  pill_bg, pill_fg =
    case status_display
    when "approved" then ["bg-success-container", "text-success"]
    when "pending"  then ["bg-primary-container", "text-primary-soft"]
    when "redo"     then ["bg-warning-container", "text-warning"]
    when "rejected" then ["bg-error-container", "text-error"]
    else                 ["bg-surface-variant", "text-on-surface-variant"]
    end
%>

<div class="flex">
  <%= render "shared/sidebar" %>
  <main class="flex-1 bg-white rounded-tl-panel overflow-x-hidden overflow-y-auto h-[calc(100vh-var(--spacing-header))]">

    <div class="w-[95%] max-w-5xl mx-auto pt-8 pb-16 flex flex-col min-h-full">
      <div class="space-y-12 flex-grow">

        <%# ═══════════════ STUDENT PROFILE ═══════════════ %>
        <div>
          <span class="block mb-4 text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">View Student</span>

          <%# Hero: banner band + overlapping avatar + identity + facts %>
          <section aria-labelledby="student-name"
                   class="bg-surface-tint border border-outline-variant rounded-panel overflow-hidden shadow-none">
            <div class="h-24 sm:h-28 bg-primary-container-alt" aria-hidden="true"></div>

            <div class="px-6 sm:px-8 pb-8">
              <div class="-mt-12 flex flex-col gap-4 sm:flex-row sm:gap-6">
                <div class="w-24 h-24 bg-surface-variant-deep text-on-surface-strong border-4 border-surface-tint rounded-full flex items-center justify-center text-4xl font-bold shrink-0 shadow-none">
                  <%= @student.name.first.upcase %>
                </div>

                <div class="min-w-0 flex-1 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6 sm:pt-14">
                  <div class="min-w-0">
                    <h1 id="student-name" class="text-[28px] leading-9 sm:text-[36px] sm:leading-[44px] font-normal text-on-surface-strong tracking-tight font-['DM_Sans'] break-words"><%= @student.name %></h1>
                    <div class="text-on-surface-variant text-[14px] mt-1 font-medium break-words">
                      <%= @student.email_address %>
                    </div>
                    <% if @student.instid.present? %>
                      <div class="text-on-surface-muted text-[13px] mt-0.5 font-mono">STUDENT ID: <%= @student.instid %></div>
                    <% end %>
                  </div>

                  <% if @course.coordinators.include?(Current.user) && @student_enrolment %>
                    <%= link_to "Remove From Course",
                        enrolment_path(coordinator_id: Current.user, course_id: @course, id: @student_enrolment),
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure?\nThe user will be removed from the COURSE.\nTheir associated PROJECT HISTORY and COMMENTS will be DELETED if they're the last member." },
                        class: "shrink-0 self-start inline-flex items-center justify-center px-5 py-2.5 bg-surface border border-outline rounded-full text-error text-[14px] font-medium whitespace-nowrap hover:bg-error-container transition-colors no-underline shadow-none" %>
                  <% end %>
                </div>
              </div>

              <%# Facts strip: Project Status | Supervisor %>
              <div class="mt-8 pt-6 border-t border-outline-variant flex flex-col gap-6 sm:flex-row sm:gap-0">
                <div class="flex flex-col gap-2 sm:pr-10 sm:w-1/2">
                  <span class="text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">Project Status</span>
                  <div class="flex items-center min-h-8">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[12px] font-medium tracking-wide <%= pill_bg %> <%= pill_fg %>"><%= status_display.humanize %></span>
                  </div>
                </div>

                <div class="flex flex-col gap-2 sm:pl-10 sm:w-1/2 relative before:content-[''] before:absolute before:left-0 before:top-0 before:bottom-0 before:w-px before:bg-outline-variant max-sm:before:hidden">
                  <span class="text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">Supervisor</span>
                  <div class="flex items-center min-h-8">
                    <% if @supervisor.present? %>
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-surface-variant-deep flex items-center justify-center text-[12px] font-bold text-on-surface-strong shrink-0 border border-outline-variant">
                          <%= @supervisor.name.first.upcase %>
                        </div>
                        <span class="text-on-surface text-[14px] font-medium"><%= @supervisor.name %></span>
                      </div>
                    <% else %>
                      <span class="text-on-surface-variant text-[14px]">—</span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <%# Current Project %>
          <section id="current-project" aria-labelledby="current-project-heading" class="mt-10">
            <h2 id="current-project-heading" class="pb-3 mb-5 border-b border-outline-variant text-[22px] leading-7 font-normal text-on-surface-strong font-['DM_Sans']">Current Project</h2>

            <% if @project.present? %>
              <%= render "projects/list_item",
                  project: @project,
                  path: course_project_path(@course, @project),
                  linkable: policy(@project).show? %>
            <% else %>
              <%= render "shared/empty_state",
                  heading: "No project has been submitted yet.",
                  description: "When a project is submitted, it will appear here." %>
            <% end %>
          </section>

          <%# Back to Course %>
          <footer class="mt-10 flex justify-start">
            <%= link_to course_path(@course), class: "group inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-outline text-on-surface-variant hover:bg-surface-variant hover:text-on-surface-strong text-[14px] font-medium transition-colors duration-150 no-underline" do %>
              <span class="material-symbols-outlined text-[18px] transition-transform group-hover:-translate-x-1">arrow_back</span>
              Back to Course
            <% end %>
          </footer>
        </div>

      </div>
    </div>
  </main>
</div>
