<div class="mb-10">
  <div class="flex items-center justify-between mb-4">
    <h2 style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: 1.375rem; font-weight: 400; letter-spacing: 0; line-height: 1.75rem; color: var(--gm3-sys-color-on-surface, #1f1f1f);">Pending Proposals</h2>
    <span class="text-[15px] text-[#5F6368]"><%= pluralize(@pending_proposals.size, "proposal") %> awaiting action</span>
  </div>

  <% if @pending_proposals.any? %>
    <%= render "shared/row_list", rows: @pending_proposals, partial: "projects/proposal_list_item", item: :proposal %>
  <% else %>
    <p class="text-[15px] text-[#5F6368] italic">No proposals awaiting review.</p>
  <% end %>
</div>

<div class="<%= 'mb-10' if @pending_topics.present? %>">
  <div class="flex items-center justify-between mb-4">
    <h2 style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: 1.375rem; font-weight: 400; letter-spacing: 0; line-height: 1.75rem; color: var(--gm3-sys-color-on-surface, #1f1f1f);">Reviewed Proposals</h2>
    <span class="text-[15px] text-[#5F6368]"><%= pluralize(@reviewed_proposals.size, "proposal") %></span>
  </div>

  <% if @reviewed_proposals.any? %>
    <%= render "shared/row_list", rows: @reviewed_proposals, partial: "projects/proposal_list_item", item: :proposal %>
  <% else %>
    <p class="text-[15px] text-[#5F6368] italic">No reviewed proposals yet.</p>
  <% end %>
</div>

<% if @pending_topics.present? %>
  <div>
    <div class="flex items-center justify-between mb-4">
      <h2 style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: 1.375rem; font-weight: 400; letter-spacing: 0; line-height: 1.75rem; color: var(--gm3-sys-color-on-surface, #1f1f1f);">Pending Topics</h2>
      <span class="text-[15px] text-[#5F6368]"><%= pluralize(@pending_topics.size, "topic") %> awaiting action</span>
    </div>

    <%= render "shared/row_list", rows: @pending_topics, partial: "courses/topic_card", item: :topic %>
  </div>
<% end %>
