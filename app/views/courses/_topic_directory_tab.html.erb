<%# Topics panel of courses/show — an ivar->locals seam (the same pattern as the
    other tab partials): reads the controller's ivars ONCE and passes them down
    as locals, so the render tree below never touches an ivar again. Gated on
    @course.toggle_topics, same as the previous tab content. %>
<% if @course.toggle_topics %>
  <%= render "courses/topics_section",
             course: @course,
             lecturers: @lecturers,
             topics_by_supervisor: @topics_by_supervisor,
             current_user_enrolment: @current_user_enrolment %>
<% end %>