<% topic_instance = topic.topic_instances.order(:version).last %>

<% if topic_instance %>
  <% status_key = topic.status.to_s.downcase

  path =
    if local_assigns[:lecturer].present?
      course_lecturer_topic_path(course, lecturer, topic)
    elsif params[:from_edit_project].present?
      course_topic_path(@course, topic, from_edit_project: true, project_id: params[:project_id])
    else
      course_topic_path(@course, topic, from_new_project: params[:from_new_project])
    end

  hide_owner = local_assigns.fetch(:hide_owner, false)
  render_options = {
    path: path,
    linkable: policy(topic).show?,
    icon: "topic",
    title: topic_instance.title.presence || "Untitled Topic",
    meta_parts: hide_owner ? [] : [topic.owner_name],
    time_meta: "Updated #{time_ago_in_words(topic.updated_at)} ago",
    status: status_key
  }

  # Topics Directory-only: when an approved topic is unclaimed, swap its status
  # pill for the green "Available" pill (approved is already green). Never pass
  # pill_label: nil — _row_item's fetch(:pill_label, ...) would render an empty pill.
  if local_assigns.fetch(:available_pill, false) && topic.available?
    render_options[:pill_label] = "Available"
  end

  %>
  <%= render "shared/row_item", render_options %>
<% end %>
