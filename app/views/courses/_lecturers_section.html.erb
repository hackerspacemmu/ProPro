<%# locals: course, lecturers, capacity_result, lecturer_capacity_info %>

<section class="@container mb-14">
  <div class="flex items-center justify-between border-b border-outline-variant pb-4 mb-4">
    <h2 style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-weight: 400;" class="text-[22px] leading-7 text-on-surface-strong"><%= course.solo_supervisor? ? "Instructor" : "Lecturers" %></h2>
    <% if policy(course).manage_lecturers? %>
      <%= link_to add_lecturers_course_path(course),
            title: "Add Lecturer",
            class: "inline-flex items-center justify-center p-2 rounded-full hover:bg-surface-hover text-on-surface-variant hover:text-primary transition-colors" do %>
        <span class="material-symbols-outlined">person_add</span>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 @4xl:grid-cols-2 gap-x-8 gap-y-1">
    <% lecturers.each do |lecturer| %>
      <% lecturer_capacity = lecturer_capacity_info[lecturer.id] %>
      <% excluded = lecturer_capacity.present? && lecturer_capacity.excluded? %>
      <% show_capacity = lecturer_capacity.present? && !course.solo_supervisor? && !excluded %>
      <% name_text_class = excluded ? "text-on-surface-disabled" : "text-on-surface" %>

      <% if show_capacity %>
        <% ratio = lecturer_capacity.effective_cap.zero? ? 0 : lecturer_capacity.approved_count.to_f / lecturer_capacity.effective_cap %>
        <% color =
             case
             when ratio >= 1.0 then "var(--color-error)"
             when ratio >= 0.7 then "var(--color-warning)"
             else "var(--color-success)"
             end %>
        <% exceeding = lecturer_capacity.effective_cap.positive? && lecturer_capacity.approved_count > lecturer_capacity.effective_cap %>
      <% end %>

      <div class="flex flex-col sm:flex-row sm:items-center justify-between py-3 px-4 hover:bg-surface-hover rounded-lg transition-colors gap-3 sm:gap-0">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-9 h-9 rounded-full bg-primary-container flex items-center justify-center text-sm font-medium text-primary shrink-0<%= " opacity-60" if excluded %>"><%= lecturer.name.first.upcase %></div>
          <div class="min-w-0">
            <%= link_to course_lecturer_path(course, lecturer),
                        title: lecturer.name,
                        class: "block text-sm font-medium #{name_text_class} hover:underline truncate min-w-0" do %>
              <%= lecturer.name %>
            <% end %>
            <% if show_capacity && lecturer_capacity.pending_count.positive? %>
              <p class="text-xs font-normal text-on-surface-muted">
                <%= lecturer_capacity.pending_count %> pending
              </p>
            <% end %>
          </div>
        </div>

        <% if show_capacity %>
          <div class="flex items-center gap-3 sm:ml-auto shrink-0">
            <% if exceeding %>
              <div class="flex items-center text-error" title="Capacity exceeded">
                <span class="material-symbols-outlined text-[18px]">error</span>
              </div>
            <% else %>
              <div class="w-[18px]"></div>
            <% end %>

            <div class="w-20 h-1.5 bg-surface-variant-deep rounded-full overflow-hidden flex shrink-0">
              <% fill_width = [[ratio * 100, 100].min, 0].max.round(2) %>
              <div class="h-full rounded-full" style="width: <%= fill_width %>% ; background-color: <%= color %>"></div>
            </div>

            <span class="text-sm font-medium w-10 text-right shrink-0" style="color: <%= color %>">
              <%= lecturer_capacity.approved_count %>/<%= lecturer_capacity.effective_cap %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if course.supervisor_auto_calculate_enabled? && capacity_result && capacity_result.remainder.positive? %>
    <p class="flex items-center gap-1.5 text-sm text-on-surface-variant mt-5">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>You will need to allocate an additional <%= capacity_result.remainder %> project(s) to supervisors using offsets</span>
    </p>
  <% end %>
</section>
