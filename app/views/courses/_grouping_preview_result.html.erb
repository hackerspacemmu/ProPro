<% if preview[:error] %>
  <p class="text-red-600 text-xs mt-1"><%= preview[:error] %></p>
<% else %>
  <div class="space-y-0.5">
    <p>
      <%= student_count %> student<%= student_count == 1 ? '' : 's' %> &rarr; <%= preview[:total_groups] %> group<%= preview[:total_groups] == 1 ? '' : 's' %>
    </p>
    <span class="text-[12px] text-on-surface-variant font-normal">
      <%= preview[:groups].map { |entry| "#{entry[:count]} of #{entry[:size]}" }.join(', ') %>
    </span>
  </div>
<% end %>
