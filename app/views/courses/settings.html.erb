<% content_for :no_sidebar, true %>
<% content_for :hide_toggler, true %>
<% content_for :hide_breadcrumbs, true %>
<% content_for :body_class, "bg-[#f8fafd]" %>
<% breadcrumb :course_settings, @course %>

<% content_for :title,
"Course Settings - #{@course.course_name.truncate(TITLE_NAME_LIMIT)} | ProPro" %>

<div class="min-h-screen bg-[#f8fafd] text-[#3C4043] font-['Roboto',sans-serif] flex flex-col">

  <%= form_with url: handle_settings_course_path(@course), model: @course, method: :post, id: "course-settings-form", class: "flex flex-col min-h-screen" do |form| %>

    <!-- Sticky Top Navigation -->
    <header class="sticky top-0 z-30 bg-white border-b border-[#E0E0E0] px-4 sm:px-6 py-3 flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-6">
        <%= link_to course_path(@course), title: "Close and return to course", class: "p-2 -ml-2 rounded-full hover:bg-[#F1F3F4] text-[#5F6368] hover:text-[#3C4043] transition-colors flex items-center justify-center" do %>
          <span class="material-symbols-outlined text-[24px]">close</span>
        <% end %>
        <h1 style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="text-xl font-medium text-[#1f1f1f] tracking-tight">Course Settings</h1>
      </div>
      <div>
        <%= form.submit "Save", class: "bg-[#1A73E8] hover:bg-[#1B66C9] text-white px-6 py-2 rounded-full font-medium text-[14px] transition-all shadow-sm cursor-pointer" %>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 py-10 px-4 sm:px-6 overflow-y-auto">
      <div class="max-w-4xl mx-auto space-y-8 pb-8">

        <div id="flash">
          <%= render "courses/flash" %>
        </div>

        <% if @course.errors.any? %>
          <div class="rounded-lg border border-[#F9D2CE] bg-[#FCE8E6] p-4">
            <h3 class="text-sm font-medium text-[#C5221F]">
              <%= pluralize(@course.errors.count, "error") %> prohibited saving:
            </h3>
            <ul class="mt-2 text-sm text-[#C5221F] list-disc list-inside">
              <% @course.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= render "copy_course_overlay", course: @course, mode: "settings", courses: @courses %>

        <!-- SECTION 1: Class Details -->
        <section class="bg-white border border-[#E0E0E0] rounded-[12px] p-8 shadow-xs">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">Class Details</h2>

          <div class="space-y-6">
            <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :course_name, "Course Name", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
              <%= form.text_field :course_name, required: true, class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] mt-1" %>
            </div>

            <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :course_description, "Project Details", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
              <%= form.text_area :course_description, rows: 2, class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] mt-1 resize-none overflow-hidden", data: { controller: "textarea-resize", action: "input->textarea-resize#resize" } %>
            </div>

            <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :file_link, "Project File Link (URL)", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
              <%= form.text_field :file_link, class: "w-full bg-transparent border-none p-0 text-[#1A73E8] focus:ring-0 text-[14px] mt-1 underline" %>
            </div>

            <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4 w-full sm:w-1/2">
              <%= form.label :starting_week, "Starting Week", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
              <%= form.text_field :starting_week, required: true, class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] mt-1" %>
            </div>
          </div>
        </section>

        <!-- SECTION 2: General -->
        <section class="bg-white border border-[#E0E0E0] rounded-[12px] p-8 shadow-xs">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">General</h2>

          <!-- SUBSECTION: Coursecode -->
          <div class="border-b border-gray-200 pb-8">
            <h3 class="text-lg font-medium text-gray-800 mb-4">Coursecode</h3>

            <%= render "course_code_form", course: @course %>
          </div>

          <!-- SUBSECTION: Supervisor Capacity -->
          <div>
            <h3 class="text-lg font-medium text-gray-800 mb-4">Supervisor Capacity</h3>

            <div class="space-y-6">
              <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4 w-full sm:w-1/2">
                <%= form.label :supervisor_projects_limit, "Maximum Projects per Supervisor", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
                <%= form.hidden_field :supervisor_projects_limit %>
                <%= form.number_field :supervisor_projects_limit, id: "supervisor_projects_limit_visible", required: true, disabled: @course.supervisor_auto_calculate_enabled?, class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] mt-1" %>
              </div>

              <%= render "supervisor_capacity_settings", form: form, capacity_result: @capacity_result, lecturer_enrolments: @lecturer_enrolments %>
            </div>
          </div>
        </section>

        <!-- SECTION 3: Permissions and Rules -->
        <section class="bg-white border border-[#E0E0E0] rounded-[12px] p-8 shadow-xs">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">Permissions and Rules</h2>

          <div class="space-y-8">
            <div class="bg-white border border-[#E0E0E0] rounded-lg overflow-hidden">

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-[#E0E0E0] hover:bg-[#F8F9FA] transition-colors">
                <span class="text-sm font-medium text-[#3C4043] mb-2 sm:mb-0">Allow lecturers to add topics for students to base their proposals on.</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :toggle_topics, true, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :toggle_topics, false, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-[#E0E0E0] hover:bg-[#F8F9FA] transition-colors">
                <span class="text-sm font-medium text-[#3C4043] mb-2 sm:mb-0">Lecturer topics require approval?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :require_coordinator_approval, true, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :require_coordinator_approval, false, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-[#E0E0E0] hover:bg-[#F8F9FA] transition-colors">
                <span class="text-sm font-medium text-[#3C4043] mb-2 sm:mb-0">Auto-approve unchanged copied topics?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :auto_approve_copied_topics_without_changes, true, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :auto_approve_copied_topics_without_changes, false, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-[#E0E0E0] hover:bg-[#F8F9FA] transition-colors">
                <span class="text-sm font-medium text-[#3C4043] mb-2 sm:mb-0">Use progress updates?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :use_progress_updates, true, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :use_progress_updates, false, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-[#E0E0E0] hover:bg-[#F8F9FA] transition-colors">
                <span class="text-sm font-medium text-[#3C4043] mb-2 sm:mb-0">Lecturer views public?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :lecturer_access, true, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                    <%= form.radio_button :lecturer_access, false, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 hover:bg-[#F8F9FA] transition-colors">
                <span class="text-sm font-medium text-[#3C4043] mb-2 sm:mb-0">Number of progress updates</span>
                <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors px-3 py-1 w-full sm:w-32 mt-2 sm:mt-0">
                  <%= form.number_field :number_of_updates, class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] text-center" %>
                </div>
              </div>

            </div>

            <div class="pt-4">
              <span class="block text-sm font-medium text-[#3C4043] mb-3">Student can see projects from:</span>
              <div class="bg-[#F8F9FA] border border-[#E0E0E0] rounded-lg p-5 space-y-3">
                <% Course.student_accesses.keys.map { |key| [key, key.to_s.humanize] }.each_with_index do |(value, label_text), idx| %>
                  <div class="flex items-center">
                    <%= form.radio_button :student_access, value, id: "student_access_#{idx}", class: "text-[#1A73E8] border-[#DADCE0]" %>
                    <%= form.label :student_access, label_text, value: value, for: "student_access_#{idx}", class: "ml-3 block text-sm text-[#3C4043] cursor-pointer" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 4: Grouping (Inlined and Restyled) -->
        <section class="bg-white border border-[#E0E0E0] rounded-[12px] p-8 shadow-xs">
          <div class="space-y-8"
               data-controller="grouping-settings"
               data-grouping-settings-enabled-value="<%= @course.grouping_enabled? %>"
               data-grouping-settings-finalised-value="<%= @course.student_list_finalised? %>">

            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-gray-200 pb-4 gap-2">
              <div>
                <h2 class="text-3xl font-normal text-gray-800 tracking-tight">Student Self-Grouping <span class="text-xs font-semibold px-2 py-0.5 rounded bg-amber-100 text-amber-800 align-middle">Beta</span></h2>
                <p class="text-xs text-amber-600 mt-1">Group formation in ProPro is still in progress!</p>
              </div>
            </div>

            <!-- Toggle: Allow students to form their own groups -->
            <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border border-[#E0E0E0] rounded-lg hover:bg-[#F8F9FA] transition-colors">
              <span class="text-sm font-medium text-[#3C4043] mb-2 sm:mb-0">Allow students to form their own groups?</span>
              <div class="flex items-center gap-6">
                <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                  <%= form.radio_button :grouping_enabled, true,
                        class: "text-[#1A73E8] border-[#DADCE0] mr-2",
                        data: { action: "change->grouping-settings#toggleEnabled" } %> Yes
                </label>
                <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                  <%= form.radio_button :grouping_enabled, false,
                        class: "text-[#1A73E8] border-[#DADCE0] mr-2",
                        data: { action: "change->grouping-settings#toggleEnabled" } %> No
                </label>
              </div>
            </div>

            <!-- Options Section: hidden until grouping enabled -->
            <div data-grouping-settings-target="groupingOptions" class="space-y-8">

              <!-- Sub-block: Group Configuration -->
              <div class="space-y-6">
                <span class="block text-xs font-medium text-[#5F6368] uppercase tracking-wide">
                  Group Configuration
                </span>

                <!-- Mode Selection -->
                <div>
                  <span class="block text-sm font-medium text-[#3C4043] mb-1">Student list mode</span>
                  <p class="text-[13px] text-[#5F6368] mb-4">
                    Choose whether the coordinator knows the exact final count of students.
                  </p>

                  <div class="space-y-3">
                    <!-- Default Mode Card -->
                    <label class="flex items-start gap-3 p-4 rounded-lg cursor-pointer transition-colors <%= @course.student_list_finalised? ? 'border border-[#E0E0E0] bg-white hover:border-[#1A73E8]' : 'border border-[#1A73E8] bg-[#E8F0FE]/40' %>">
                      <%= form.radio_button :student_list_finalised, false,
                            class: "mt-0.5 text-[#1A73E8] border-[#DADCE0] shrink-0",
                            data: { action: "change->grouping-settings#toggleMode" } %>
                      <div>
                        <span class="block text-sm font-medium text-[#3C4043]">Default</span>
                        <span class="block text-xs text-[#5F6368] mt-1 leading-relaxed">
                          Students join by code, or the student list may still change. Students form groups within the min/max limits — any leftover students will need lecturer intervention.
                        </span>
                      </div>
                    </label>

                    <!-- Fixed List Mode Card -->
                    <% if @course.persisted? && @course.grouping_enabled? && !@course.student_list_finalised? %>
                      <div class="flex items-start gap-3 p-4 border border-[#E0E0E0] rounded-lg bg-[#F8F9FA] opacity-60">
                        <div class="mt-0.5 h-4 w-4 shrink-0"></div>
                        <div>
                          <span class="block text-sm font-medium text-[#9AA0A6]">Final student list</span>
                          <span class="block text-xs text-[#9AA0A6] mt-1 leading-relaxed">
                            Fixed list mode cannot be enabled once default mode has been saved.
                          </span>
                        </div>
                      </div>
                    <% else %>
                      <label class="flex items-start gap-3 p-4 rounded-lg cursor-pointer transition-colors <%= @course.student_list_finalised? ? 'border border-[#1A73E8] bg-[#E8F0FE]/40' : 'border border-[#E0E0E0] bg-white hover:border-[#1A73E8]' %>">
                        <%= form.radio_button :student_list_finalised, true,
                              class: "mt-0.5 text-[#1A73E8] border-[#DADCE0] shrink-0",
                              data: { action: "change->grouping-settings#toggleMode" } %>
                        <div>
                          <span class="block text-sm font-medium text-[#3C4043]">Final student list</span>
                          <span class="block text-xs text-[#5F6368] mt-1 leading-relaxed">
                            I will import students and the student list is final — no new students will be added. The system can automatically determine legal group sizes for every student.
                          </span>
                        </div>
                      </label>
                    <% end %>
                  </div>
                </div>

                <!-- Min / Max Group Sizes -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                  <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4">
                    <%= form.label :group_min, "Minimum group size", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
                    <%= form.number_field :group_min, min: 1, placeholder: "e.g. 3",
                          class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] mt-1",
                          data: { grouping_settings_target: "minMax", action: "input->grouping-settings#clearPreview" } %>
                  </div>

                  <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4">
                    <%= form.label :group_max, "Maximum group size", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
                    <%= form.number_field :group_max, min: 1, placeholder: "e.g. 4",
                          class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] mt-1",
                          data: { grouping_settings_target: "minMax", action: "input->grouping-settings#clearPreview" } %>
                  </div>
                </div>

                <!-- Preview Section -->
                <div data-grouping-settings-target="previewSection" class="bg-[#F8F9FA] border border-[#E0E0E0] rounded-lg p-5 space-y-4">
                  <div>
                    <p class="text-sm font-medium text-[#3C4043]">Preview group distribution</p>
                    <p class="text-xs text-[#5F6368] mt-0.5">
                      Enter an expected student count to see how legal groups would form. Actual numbers will come from enrolled students.
                    </p>
                  </div>
                  <div class="flex items-center gap-3">
                    <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors px-3 py-1 w-36">
                      <input type="number" id="grouping_preview_count" name="student_count" min="1" placeholder="e.g. 30" autocomplete="off"
                             class="w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px]"
                             hx-get="<%= grouping_preview_course_path(@course) %>"
                             hx-include="[name='student_count'], [name='course[group_min]'], [name='course[group_max]']"
                             hx-params="student_count,course[group_min],course[group_max]"
                             hx-target="#grouping_preview_result"
                             hx-trigger="input changed delay:400ms"
                             data-grouping-settings-target="previewInput">
                    </div>
                    <span class="text-xs font-medium text-[#5F6368]">students</span>
                  </div>
                  <div id="grouping_preview_result" class="text-sm text-[#3C4043] pt-1"></div>
                </div>
              </div>

              <!-- Sub-block: Student Access -->
              <div class="space-y-6 pt-4 border-t border-[#E0E0E0]">
                <span class="block text-xs font-medium text-[#5F6368] uppercase tracking-wide">
                  Student Access
                </span>

                <!-- Allow Student Grouping Now Toggle -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-4 border border-[#E0E0E0] rounded-lg bg-white gap-3">
                  <div>
                    <span class="block text-sm font-medium text-[#3C4043]">Allow student grouping now</span>
                    <span class="block text-xs text-[#5F6368] mt-0.5">
                      Students can join, leave, and form groups only when this is on.
                    </span>
                  </div>
                  <div class="flex items-center gap-6 shrink-0">
                    <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                      <%= form.radio_button :grouping_open, true, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> Open
                    </label>
                    <label class="flex items-center text-sm text-[#3C4043] cursor-pointer">
                      <%= form.radio_button :grouping_open, false, class: "text-[#1A73E8] border-[#DADCE0] mr-2" %> Closed
                    </label>
                  </div>
                </div>

                <!-- Datetime Window -->
                <div class="space-y-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <span class="block text-sm font-medium text-[#3C4043]">Auto-close window (optional)</span>
                      <span class="block text-xs text-[#5F6368] mt-0.5">
                        Optionally set specific dates to open and close student access automatically.
                      </span>
                    </div>
                    <button type="button" class="text-[13px] text-[#1A73E8] font-medium hover:underline shrink-0"
                            data-action="click->grouping-settings#toggleWindow"
                            data-grouping-settings-target="windowToggleBtn">
                      <%= (@course.grouping_opens_at.present? || @course.grouping_closes_at.present?) ? 'Remove window' : 'Set a window' %>
                    </button>
                  </div>

                  <div data-grouping-settings-target="windowFields" class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1">
                    <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4">
                      <%= form.label :grouping_opens_at, "Open from", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
                      <%= form.datetime_local_field :grouping_opens_at,
                            class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] mt-1",
                            value: @course.grouping_opens_at&.strftime('%Y-%m-%dT%H:%M') %>
                    </div>
                    <div class="bg-[#F1F3F4] rounded-t-[4px] border-b-2 border-[#5F6368] focus-within:border-[#1A73E8] transition-colors relative pt-5 pb-2 px-4">
                      <%= form.label :grouping_closes_at, "Close at", class: "absolute top-2 left-4 text-xs font-medium text-[#5F6368]" %>
                      <%= form.datetime_local_field :grouping_closes_at,
                            class: "w-full bg-transparent border-none p-0 text-[#3C4043] focus:ring-0 text-[14px] mt-1",
                            value: @course.grouping_closes_at&.strftime('%Y-%m-%dT%H:%M') %>
                    </div>
                  </div>
                </div>

              </div>

            </div>
          </div>
        </section>

        <!-- Roster and Course Action Footers -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-8 pt-4 border-t border-[#E0E0E0]">
          <div class="flex gap-3 w-full sm:w-auto">
            <%= link_to add_students_course_path(@course), class: "w-full sm:w-auto inline-flex justify-center items-center gap-2 border border-[#DADCE0] text-[#1A73E8] hover:bg-[#F8F9FA] px-6 py-2.5 rounded-full font-medium text-[14px] transition-colors" do %>
              <span class="material-symbols-outlined text-[18px]">person_add</span>
              Add Students
            <% end %>
            <%= link_to add_lecturers_course_path(@course), class: "w-full sm:w-auto inline-flex justify-center items-center gap-2 border border-[#DADCE0] text-[#1A73E8] hover:bg-[#F8F9FA] px-6 py-2.5 rounded-full font-medium text-[14px] transition-colors" do %>
              <span class="material-symbols-outlined text-[18px]">group_add</span>
              Add Lecturers
            <% end %>
          </div>

          <%= link_to course_path(@course), class: "w-full sm:w-auto inline-flex justify-center items-center gap-2 text-[#C5221F] hover:bg-[#FCE8E6] px-5 py-2.5 rounded-full font-medium text-[14px] transition-colors", data: { turbo_method: :delete, turbo_confirm: "Are you sure? This cannot be undone." } do %>
            <span class="material-symbols-outlined text-[18px]">delete</span>
            Delete Course
          <% end %>
        </div>

      </div>
    </main>
  <% end %>
</div>
