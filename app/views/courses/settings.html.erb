<% content_for :no_sidebar, true %>
<% content_for :no_header, true %>
<% content_for :no_footer, true %>
<% content_for :hide_toggler, true %>
<% content_for :hide_breadcrumbs, true %>
<% content_for :body_class, "bg-surface-tint" %>
<% breadcrumb :course_settings, @course %>

<% content_for :title,
"Course Settings - #{@course.course_name.truncate(TITLE_NAME_LIMIT)} | ProPro" %>

<div class="min-h-screen bg-surface-tint text-on-surface font-['Roboto',sans-serif] flex flex-col">

<%= form_with url: handle_settings_course_path(@course), model: @course, method: :post, id: "course-settings-form", class: "flex flex-col min-h-screen" do |form| %>

    <!-- Sticky Top Navigation -->
    <header class="sticky top-0 z-30 bg-white border-b border-outline-variant px-4 sm:px-6 py-3 flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-6">
        <%= link_to course_path(@course), title: "Close and return to course", class: "p-2 -ml-2 rounded-full hover:bg-surface-variant text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center" do %>
          <span class="material-symbols-outlined text-[24px]">close</span>
        <% end %>
        <h1 style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="text-xl font-medium text-on-surface-strong tracking-tight">Course Settings</h1>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "Discard Changes", course_path(@course), class: "px-5 py-2 rounded-full text-on-surface-variant hover:bg-surface-variant hover:text-on-surface font-medium text-[14px] transition-colors" %>
        <%= form.submit "Save", class: "bg-primary hover:bg-primary-hover text-white px-6 py-2 rounded-full font-medium text-[14px] transition-all shadow-sm cursor-pointer" %>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 py-10 px-4 sm:px-6 overflow-y-auto">
      <div class="max-w-4xl mx-auto space-y-8 pb-8">

        <div id="flash">
          <%= render "courses/flash" %>
        </div>

        <% if @course.errors.any? %>
          <div class="rounded-lg border border-error-container-border bg-error-container p-4">
            <h3 class="text-sm font-medium text-error">
              <%= pluralize(@course.errors.count, "error") %> prohibited saving:
            </h3>
            <ul class="mt-2 text-sm text-error list-disc list-inside">
              <% @course.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= render "copy_course_overlay", course: @course, mode: "settings", courses: @courses %>

        <!-- SECTION 1: Class Details -->
        <section class="bg-white border border-outline-variant rounded-[12px] p-8">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">Class Details</h2>

          <div class="space-y-6">
            <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :course_name, "Course Name", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
              <%= form.text_field :course_name, required: true, class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1" %>
            </div>

            <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :course_description, "Project Details", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
              <%= form.text_area :course_description, rows: 2, class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1 resize-none overflow-hidden", data: { controller: "textarea-resize", action: "input->textarea-resize#resize" } %>
            </div>

            <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
              <%= form.label :file_link, "Project File Link (URL)", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
              <%= form.text_field :file_link, class: "w-full bg-transparent border-none p-0 text-primary focus:ring-0 focus:outline-none text-[14px] mt-1 underline" %>
            </div>

            <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4 w-full sm:w-1/2">
              <%= form.label :starting_week, "Starting Week", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
              <%= form.text_field :starting_week, required: true, class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1" %>
            </div>
          </div>
        </section>

        <!-- SECTION 2: General -->
        <section class="bg-white border border-outline-variant rounded-[12px] p-8">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">General</h2>

          <!-- SUBSECTION: Coursecode -->
          <div class="border-b border-gray-200 pb-8">
            <h3 class="text-lg font-medium text-gray-800 mb-4">Coursecode</h3>

            <%= render "course_code_form", course: @course %>
          </div>

          <!-- SUBSECTION: Email Domain Restriction -->
          <div class="border-b border-gray-200 pb-8 mt-8">
            <h3 class="text-lg font-medium text-gray-800 mb-4">Email Domain Restriction</h3>

            <%= render "course_email_domain_restrict_form", course: @course %>
          </div>

          <!-- SUBSECTION: Supervisor Capacity -->
          <div class="mt-8">
            <h3 class="text-lg font-medium text-gray-800 mb-4">Supervisor Capacity</h3>

            <div class="space-y-6">
              <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4 w-full sm:w-1/2">
                <%= form.label :supervisor_projects_limit, "Maximum Projects per Supervisor", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
                <%= form.hidden_field :supervisor_projects_limit %>
                <%= form.number_field :supervisor_projects_limit, id: "supervisor_projects_limit_visible", required: true, disabled: @course.supervisor_auto_calculate_enabled?, class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1" %>
              </div>

              <%= render "supervisor_capacity_settings", form: form, capacity_result: @capacity_result, lecturer_enrolments: @lecturer_enrolments %>
            </div>
          </div>
        </section>

        <!-- SECTION 3: Permissions and Rules -->
        <section class="bg-white border border-outline-variant rounded-[12px] p-8">
          <h2 class="text-3xl font-normal text-gray-800 mb-6 tracking-tight">Permissions and Rules</h2>

          <div class="space-y-8">
            <div class="bg-white border border-outline-variant rounded-lg overflow-hidden">

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-outline-variant hover:bg-surface-hover transition-colors">
                <span class="text-sm font-medium text-on-surface mb-2 sm:mb-0">Allow lecturers to add topics?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :toggle_topics, true, class: "text-primary border-outline mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :toggle_topics, false, class: "text-primary border-outline mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-outline-variant hover:bg-surface-hover transition-colors">
                <span class="text-sm font-medium text-on-surface mb-2 sm:mb-0">Lecturer topics require approval?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :require_coordinator_approval, true, class: "text-primary border-outline mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :require_coordinator_approval, false, class: "text-primary border-outline mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-outline-variant hover:bg-surface-hover transition-colors">
                <span class="text-sm font-medium text-on-surface mb-2 sm:mb-0">Auto-approve unchanged copied topics?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :auto_approve_copied_topics_without_changes, true, class: "text-primary border-outline mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :auto_approve_copied_topics_without_changes, false, class: "text-primary border-outline mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-outline-variant hover:bg-surface-hover transition-colors">
                <span class="text-sm font-medium text-on-surface mb-2 sm:mb-0">Use progress updates?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :use_progress_updates, true, class: "text-primary border-outline mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :use_progress_updates, false, class: "text-primary border-outline mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 border-b border-outline-variant hover:bg-surface-hover transition-colors">
                <span class="text-sm font-medium text-on-surface mb-2 sm:mb-0">Lecturer views public?</span>
                <div class="flex items-center gap-6">
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :lecturer_access, true, class: "text-primary border-outline mr-2" %> Yes
                  </label>
                  <label class="flex items-center text-sm text-on-surface cursor-pointer">
                    <%= form.radio_button :lecturer_access, false, class: "text-primary border-outline mr-2" %> No
                  </label>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 hover:bg-surface-hover transition-colors">
                <span class="text-sm font-medium text-on-surface mb-2 sm:mb-0">Number of progress updates</span>
                <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors px-3 py-1 w-full sm:w-32 mt-2 sm:mt-0">
                  <%= form.number_field :number_of_updates, class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] text-center" %>
                </div>
              </div>

            </div>

            <div class="pt-4">
              <span class="block text-sm font-medium text-on-surface mb-3">Student can see projects from:</span>
              <div class="bg-surface-hover border border-outline-variant rounded-lg p-5 space-y-3">
                <% Course.student_accesses.keys.map { |key| [key, key.to_s.humanize] }.each_with_index do |(value, label_text), idx| %>
                  <div class="flex items-center">
                    <%= form.radio_button :student_access, value, id: "student_access_#{idx}", class: "text-primary border-outline" %>
                    <%= form.label :student_access, label_text, value: value, for: "student_access_#{idx}", class: "ml-3 block text-sm text-on-surface cursor-pointer" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 4: Group Formation -->
        <section id="grouping" class="scroll-mt-6 bg-white border border-outline-variant rounded-[12px] p-8">
          <div class="border-b border-outline-variant pb-4 mb-6 flex justify-between items-center">
            <h2 class="text-3xl font-normal text-gray-800 tracking-tight">Group Formation <span class="text-xs font-semibold px-2 py-0.5 rounded bg-amber-100 text-amber-800 align-middle ml-2">Beta</span></h2>
          </div>

          <div class="space-y-8"
               data-controller="grouping-settings"
               data-grouping-settings-enabled-value="<%= @course.group_formation_enabled? %>"
               data-grouping-settings-finalised-value="<%= @course.student_list_finalised? %>">

            <!-- Master toggle: Student self-grouping -->
            <div class="flex items-start justify-between gap-4">
              <div>
                <span class="block text-[15px] font-medium text-on-surface">Student self-grouping</span>
                <span class="block text-[13px] text-on-surface-variant mt-1 max-w-[600px] leading-relaxed">
                  Allow students to form and manage their own groups.
                </span>
              </div>
              <label class="relative flex items-center cursor-pointer shrink-0 mt-1">
                <%= form.check_box :group_formation_enabled,
                      { class: "sr-only peer", role: "switch", "aria-label": "Student self-grouping",
                        data: { action: "change->grouping-settings#toggleEnabled" } },
                      "true", "false" %>
                <div class="w-11 h-6 bg-surface-variant-deep peer-focus:outline-none peer-focus-visible:ring-2 peer-focus-visible:ring-primary/40 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border after:border-gray-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
              </label>
            </div>

            <!-- Options Section: hidden until grouping enabled -->
            <div data-grouping-settings-target="groupingOptions" class="space-y-8 border-t border-outline-variant pt-6 <%= 'hidden' unless @course.group_formation_enabled? %>">

              <!-- Sub-block: Group Configuration -->
              <div class="space-y-6">

                <!-- Prevent leftover students toggle -->
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <span class="block text-[15px] font-medium text-on-surface">Prevent leftover students</span>
                    <span class="block text-[13px] text-on-surface-variant mt-1 max-w-[600px] leading-relaxed">
                      Enforces legal group sizes for every student based on expected counts. Uncheck if the student list may still change or students can form groups freely.
                    </span>
                  </div>
                  <label class="relative flex items-center cursor-pointer shrink-0 mt-1">
                    <%= form.check_box :student_list_finalised,
                          { class: "sr-only peer", role: "switch", "aria-label": "Prevent leftover students",
                            data: { action: "change->grouping-settings#toggleMode" } },
                          "true", "false" %>
                    <div class="w-11 h-6 bg-surface-variant-deep peer-focus:outline-none peer-focus-visible:ring-2 peer-focus-visible:ring-primary/40 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border after:border-gray-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                  </label>
                </div>

                <!-- Min / Max Group Sizes -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
                    <%= form.label :group_min, class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" do %>
                      Minimum group size<span data-grouping-settings-target="optionalSuffix" class="<%= 'hidden' if @course.student_list_finalised? %>"> (optional)</span>
                    <% end %>
                    <%= form.number_field :group_min, min: 1, placeholder: "e.g. 2",
                          class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1",
                          data: { grouping_settings_target: "minMax", action: "input->grouping-settings#clearPreview" } %>
                  </div>

                  <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4">
                    <%= form.label :group_max, class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" do %>
                      Maximum group size<span data-grouping-settings-target="optionalSuffix" class="<%= 'hidden' if @course.student_list_finalised? %>"> (optional)</span>
                    <% end %>
                    <%= form.number_field :group_max, min: 1, placeholder: "e.g. 4",
                          class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1",
                          data: { grouping_settings_target: "minMax", action: "input->grouping-settings#clearPreview" } %>
                  </div>
                </div>

                <!-- Distribution Preview -->
                <div data-grouping-settings-target="previewSection" class="bg-primary-container-alt/30 border border-primary-container-alt rounded-lg p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-6 <%= 'hidden' unless @course.student_list_finalised? %>">
                  <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="material-symbols-outlined text-[20px] text-primary">groups</span>
                      <p class="text-[14px] font-medium text-on-surface-strong">Distribution preview</p>
                    </div>
                    <p class="text-[13px] text-on-surface-variant">
                      Enter an expected student count to see how legal groups would form.
                    </p>
                  </div>
                  <div class="flex flex-col sm:flex-row sm:items-center gap-4 shrink-0">
                    <div class="bg-white rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors px-3 py-1 w-24 shadow-sm">
                      <input type="number" id="grouping_preview_count" name="student_count" min="1" placeholder="Qty" autocomplete="off"
                             aria-label="Expected student count"
                             class="w-full bg-transparent border-none p-0 text-center text-on-surface focus:ring-0 focus:outline-none text-[14px]"
                             hx-get="<%= grouping_preview_course_path(@course) %>"
                             hx-include="[name='student_count'], [name='course[group_min]'], [name='course[group_max]']"
                             hx-params="student_count,course[group_min],course[group_max]"
                             hx-target="#grouping_preview_result"
                             hx-trigger="input changed delay:400ms"
                             data-grouping-settings-target="previewInput">
                    </div>
                    <div id="grouping_preview_result" class="text-[13px] text-on-surface font-medium min-w-[140px]"></div>
                  </div>
                </div>
              </div>

              <!-- Sub-block: Student Access -->
              <div class="space-y-6 pt-6 border-t border-outline-variant">
                <!-- End group formation date -->
                <div class="space-y-4">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <span class="block text-[15px] font-medium text-on-surface">End group formation (optional)</span>
                      <span class="block text-[13px] text-on-surface-variant mt-1 max-w-[600px] leading-relaxed">
                        Automatically close student access on a specific date.
                      </span>
                    </div>
                    <button type="button" class="mt-1 px-4 py-1.5 rounded-full border border-outline text-primary hover:bg-surface-variant font-medium text-[13px] transition-colors shrink-0"
                            data-action="click->grouping-settings#toggleFormation"
                            data-grouping-settings-target="formationToggleBtn">
                      <%= @course.group_formation_closes_at.present? ? 'Remove date' : 'Set date' %>
                    </button>
                  </div>

                  <div data-grouping-settings-target="formationFields" class="<%= 'hidden' unless @course.group_formation_closes_at.present? %> mt-4">
                    <div class="bg-surface-variant rounded-t-[4px] border-b-2 border-on-surface-variant focus-within:border-primary transition-colors relative pt-5 pb-2 px-4 w-full sm:w-[320px]">
                      <%= form.label :group_formation_closes_at, "Close at", class: "absolute top-2 left-4 text-xs font-medium text-on-surface-variant" %>
                      <%= form.datetime_local_field :group_formation_closes_at,
                            class: "w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 focus:outline-none text-[14px] mt-1",
                            value: @course.group_formation_closes_at&.strftime('%Y-%m-%dT%H:%M') %>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </section>

        <!-- Roster and Course Action Footers -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-8 pt-4 border-t border-outline-variant">
          <div class="flex gap-3 w-full sm:w-auto">
            <%= link_to add_students_course_path(@course), class: "w-full sm:w-auto inline-flex justify-center items-center gap-2 border border-outline text-primary hover:bg-surface-hover px-6 py-2.5 rounded-full font-medium text-[14px] transition-colors" do %>
              <span class="material-symbols-outlined text-[18px]">person_add</span>
              Add Students
            <% end %>
            <%= link_to add_lecturers_course_path(@course), class: "w-full sm:w-auto inline-flex justify-center items-center gap-2 border border-outline text-primary hover:bg-surface-hover px-6 py-2.5 rounded-full font-medium text-[14px] transition-colors" do %>
              <span class="material-symbols-outlined text-[18px]">group_add</span>
              Add Lecturers
            <% end %>
          </div>

          <%= link_to course_path(@course), class: "w-full sm:w-auto inline-flex justify-center items-center gap-2 text-error hover:bg-error-container px-5 py-2.5 rounded-full font-medium text-[14px] transition-colors", data: { turbo_method: :delete, turbo_confirm: "Are you sure? This cannot be undone." } do %>
            <span class="material-symbols-outlined text-[18px]">delete</span>
            Delete Course
          <% end %>
        </div>

      </div>
    </main>
  <% end %>
</div>
