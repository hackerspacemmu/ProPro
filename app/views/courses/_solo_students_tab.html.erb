<%# Project-oriented student directory for solo courses. Controller ivars are
    read once here; the htmx-rendered table receives explicit locals. %>
<section data-controller="modal" hx-replace-url="true">
  <div class="flex flex-col gap-4 border-b border-outline-variant pb-4 mb-4">
    <div class="flex items-baseline gap-4">
      <h2 style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-weight: 400;" class="text-[22px] leading-7 text-on-surface-strong">Students</h2>
      <span class="text-sm font-medium text-on-surface-muted"><%= pluralize(@student_list.size, "student") %></span>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <div class="relative flex items-center w-full sm:w-[240px]">
          <span class="material-symbols-outlined absolute left-3 text-on-surface-muted text-[18px]">search</span>
          <input type="text" id="students-search" name="search_query" value="<%= params[:search_query] %>"
                 autocomplete="off"
                 placeholder="Search students or projects..."
                 data-search-shortcut-target="input"
                 class="peer bg-surface-tint border border-outline text-on-surface text-sm rounded-md focus:bg-surface focus:ring-2 focus:ring-primary focus:border-transparent block w-full pl-9 pr-7 py-2 transition-all outline-none"
                 hx-get="<%= course_students_url(@course) %>"
                 hx-target="#solo-students-table-container"
                 hx-swap="outerHTML"
                 hx-trigger="input changed delay:300ms"
                 hx-include="#students-search, #students-status-filter, #students-lecturer-filter"
                 hx-indicator="#students-loading">
          <kbd aria-hidden="true"
               class="hidden md:flex peer-focus:hidden absolute right-2 top-1/2 -translate-y-1/2 items-center justify-center h-4 min-w-4 px-0.5 rounded border border-outline-variant bg-surface-tint text-[9px] leading-none font-mono text-on-surface-muted pointer-events-none select-none">/</kbd>
        </div>

        <% unless @course.solo_supervisor? %>
          <select id="students-lecturer-filter" name="lecturer_filter"
                  class="bg-surface-tint border border-outline text-on-surface text-sm rounded-md focus:bg-surface focus:ring-2 focus:ring-primary focus:border-transparent block w-full sm:w-[190px] px-4 py-2 transition-all cursor-pointer outline-none"
                  hx-get="<%= course_students_url(@course) %>"
                  hx-target="#solo-students-table-container"
                  hx-swap="outerHTML"
                  hx-trigger="change"
                  hx-include="#students-search, #students-status-filter, #students-lecturer-filter">
            <option value="all" <%= params[:lecturer_filter].blank? || params[:lecturer_filter] == "all" ? "selected" : "" %>>All Supervisors</option>
            <% @course.lecturers.each do |lecturer| %>
              <option value="<%= lecturer.id %>" <%= params[:lecturer_filter] == lecturer.id.to_s ? "selected" : "" %>><%= lecturer.name %></option>
            <% end %>
          </select>
        <% end %>

        <select id="students-status-filter" name="status_filter"
                class="bg-surface-tint border border-outline text-on-surface text-sm rounded-md focus:bg-surface focus:ring-2 focus:ring-primary focus:border-transparent block w-full sm:w-[190px] px-4 py-2 transition-all cursor-pointer outline-none"
                hx-get="<%= course_students_url(@course) %>"
                hx-target="#solo-students-table-container"
                hx-swap="outerHTML"
                hx-trigger="change"
                hx-include="#students-search, #students-status-filter, #students-lecturer-filter">
          <option value="all" <%= params[:status_filter].blank? || params[:status_filter] == "all" ? "selected" : "" %>>All Statuses</option>
          <% %w[approved pending redo rejected not_submitted].each do |project_status| %>
            <option value="<%= project_status %>" <%= params[:status_filter] == project_status ? "selected" : "" %>><%= project_status.titleize %></option>
          <% end %>
        </select>

        <span id="students-loading" class="htmx-indicator text-primary text-sm font-medium shrink-0">
          <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
        </span>
      </div>

      <div class="flex items-center gap-3 w-full md:w-auto justify-end">
        <% if policy(@course).manage_students? %>
          <button type="button" data-action="modal#open" title="Add Students" class="inline-flex items-center justify-center p-2 rounded-full hover:bg-surface-hover text-on-surface-variant hover:text-primary transition-colors shrink-0">
            <span class="material-symbols-outlined">person_add</span>
          </button>
        <% end %>

        <% if policy(@course).export_csv? %>
          <%= link_to export_csv_course_path(@course),
                title: "Export CSV",
                class: "inline-flex items-center justify-center p-2 rounded-full hover:bg-surface-hover text-on-surface-variant hover:text-primary transition-colors shrink-0" do %>
            <span class="material-symbols-outlined">download</span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "courses/solo_students_table",
             course: @course,
             students: @filtered_student_list,
             projects_by_owner: @projects_by_owner,
             total_count: @total_student_count,
             displayed_count: @filtered_student_list.count,
             show_all: @show_all,
             state: @student_list_state %>

  <%= render "courses/add_students_modal", course: @course %>
</section>
