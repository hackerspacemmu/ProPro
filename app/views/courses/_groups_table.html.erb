<%# --- locals: course, groups, projects_by_owner, total_count, displayed_count, show_all %>

<div id="groups-table-container"
     class="overflow-x-auto pb-8 border border-gray-200 rounded-lg"
     data-controller="expandable-rows">
  <table class="w-full min-w-[650px] table-fixed">
    <thead class="bg-white">
      <tr>
        <%= render "courses/sort_header", course: course, column: 'group_name', label: 'Group', width: 'w-[15%]' %>
        <th class="w-[30%] px-4 py-3 border-b border-gray-200 text-left text-xs font-medium text-[#5F6368] uppercase tracking-wider cursor-pointer select-none"
            data-expandable-toggle-all>
          <div class="flex items-center gap-1">
            Members
            <span id="groups-table-toggle-all" class="material-symbols-outlined text-[16px] text-gray-400 transition-all">unfold_more</span>
          </div>
        </th>
        <%= render "courses/sort_header", course: course, column: 'project_title', label: 'Project Title', width: 'w-[20%]' %>
        <%= render "courses/sort_header", course: course, column: 'status', label: 'Status', width: 'w-[15%]' %>
        <%= render "courses/sort_header", course: course, column: 'supervisor', label: 'Supervisor', width: 'w-[20%]' %>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% if groups.present? %>
        <% any_filter = params[:search_query].present? ||
                        (params[:lecturer_filter].present? && params[:lecturer_filter] != 'all') ||
                        (params[:status_filter].present? && params[:status_filter] != 'all') %>
        <% groups.each do |group| %>
          <% group_project = projects_by_owner[['ProjectGroup', group.id]]
             group_status = group_project&.current_status || 'not_submitted'
             supervisor = group_project&.project_instances&.order(:version)&.last&.supervisor %>
          <%= render "courses/group_row",
                     course: course,
                     group: group,
                     project: group_project,
                     status: group_status,
                     supervisor: supervisor,
                     expanded: any_filter %>
        <% end %>
      <% else %>
        <tr>
          <td colspan="5" class="px-6 py-12 text-center text-sm text-gray-500 italic">
            <%= params[:status_filter].present? && params[:status_filter] != 'all' ? "No groups found with #{params[:status_filter].titleize} status." : "No groups have been created yet." %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if total_count.positive? %>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 px-4 py-3 border-t border-gray-200 bg-white rounded-b-lg">
      <span class="text-sm text-gray-500">
        Showing <span class="font-semibold text-gray-700"><%= displayed_count %></span>
        of <span class="font-semibold text-gray-700"><%= total_count %></span> groups
      </span>

      <% if !show_all && total_count > displayed_count %>
        <button type="button"
                class="text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline transition-colors cursor-pointer"
                hx-get="<%= course_url(course) %>"
                hx-target="#groups-table-container"
                hx-swap="outerHTML"
                hx-trigger="click"
                hx-include="#groups-search, #groups-status-filter, #lecturer-filter"
                hx-vals='{"section": "groups", "show_all": "true"}'
                hx-indicator="#groups-loading">
          Show all <%= total_count %>
        </button>
      <% end %>
    </div>
  <% end %>
</div>