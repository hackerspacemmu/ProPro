<%# Project Details — the Overview tab's lead card. Three states driven by the
    presenter: filled (gradient banner + illustration + description + optional
    file pill), empty+coordinator (gradient banner + illustration + "Add
    details" CTA), empty+read-only (gradient banner + illustration, no CTA).
    The coordinator vs non-coordinator split is the presenter's
    show_project_details_add_cta? (coordinators edit; students/lecturers read).
    Keeps the #proposal-guidelines id so any legacy anchoring still works.
    Responsive rules (§13.12): illustration is a fixed crop at every width —
    the header's overflow-hidden does the clipping, never horizontal scroll. %>
<section id="proposal-guidelines" class="mb-4">
  <% if @presenter.project_details_empty? %>
    <div class="rounded-[8px] w-full overflow-hidden">
      <div class="relative px-8 py-9 overflow-hidden" style="background: linear-gradient(135deg, var(--color-primary-container-alt) 0%, var(--color-primary-container) 100%);">
        <%= image_tag "illustrations/project_details_banner.svg",
              class: "absolute right-[-70px] bottom-[-70px] h-[260px] w-auto pointer-events-none select-none",
              alt: "" %>
        <h4 class="relative z-10 text-2xl font-medium max-w-[62%]" style="color: var(--color-on-surface-strong);">
          <%= @presenter.show_project_details_add_cta? ? "No project details yet" : "No project details published yet" %>
        </h4>
        <p class="relative z-10 text-[14px] mt-1 max-w-[62%]" style="color: var(--color-on-surface-variant);">
          <%= @presenter.show_project_details_add_cta? ? "Add a description and any specification files so students know what's expected before they submit a proposal." : "Check back once your coordinator adds the brief and any specification files." %>
        </p>
        <% if @presenter.show_project_details_add_cta? %>
          <%= link_to settings_course_path(@course), class: "relative z-10 mt-5 inline-flex items-center gap-2 px-5 py-2 text-[14px] font-medium text-white bg-primary-strong rounded-full hover:bg-primary-hover transition-colors" do %>
            <span class="material-symbols-outlined text-[18px]">add</span>Add details
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="rounded-[8px] w-full overflow-hidden">
      <div class="relative px-8 py-9 overflow-hidden" style="background: linear-gradient(135deg, var(--color-primary-container-alt) 0%, var(--color-primary-container) 100%);">
        <%= image_tag "illustrations/project_details_banner.svg",
              class: "absolute right-[-70px] bottom-[-70px] h-[260px] w-auto pointer-events-none select-none",
              alt: "" %>
        <h4 class="relative z-10 text-2xl font-medium max-w-[62%]" style="color: var(--color-on-surface-strong);">Project Details</h4>
        <p class="relative z-10 text-[14px] mt-1 max-w-[62%]" style="color: var(--color-on-surface-variant);"><%= @course.course_name %></p>
      </div>
      <div class="p-6 bg-surface-tint">
        <% if @description.present? %>
          <p class="text-[0.9rem] sm:text-[1rem] leading-[1.5] whitespace-pre-line text-on-surface-variant break-words"><%= @description %></p>
        <% end %>
        <% if @course.file_link.present? %>
          <a class="text-decoration-none max-w-full text-inherit <%= "block mt-6" if @description.present? %>" href="<%= @course.file_link %>" target="_blank" rel="noopener noreferrer">
            <div class="text-file-link w-fit max-w-full flex items-center z-0 border border-outline bg-white pl-3 pr-5 py-2.5 rounded-[8px] hover:bg-surface-hover transition-colors cursor-pointer">
              <div class="file-icon flex items-center justify-center mr-3 bg-primary-container text-primary rounded-[6px] w-[36px] h-[36px] shrink-0">
                <span class="material-symbols-outlined">folder_zip</span>
              </div>
              <div class="flex flex-col justify-center min-w-0">
                <span class="font-medium text-[14px] truncate"><%= File.basename(URI.parse(@course.file_link).path.presence || "") rescue @course.file_link %></span>
              </div>
            </div>
          </a>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
