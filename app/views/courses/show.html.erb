<% content_for :hide_toggler, true %>
<% content_for :no_sidebar, true %>
<% content_for :hide_breadcrumbs, true %>

<% breadcrumb :course, @course %>

<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

<div class="min-h-screen bg-[#f8fafd] text-[#3C4043] font-['Roboto',sans-serif]">

  <div class="flex">
    <%= render "shared/sidebar" %>

    <main class="flex-1 bg-white rounded-tl-[28px] min-h-[calc(100vh-3.5rem)]"
          data-controller="tabs">

      <div class="border-b border-[#E0E0E0] px-6 pt-4">
        <div class="flex gap-8">
          <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-index-param="0"
                  style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;"
                  class="pb-3 border-b-4 transition-colors">Project Details</button>

          <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-index-param="1"
                  style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;"
                  class="pb-3 border-b-4 transition-colors">To Review</button>

          <%# Placeholder — see flag at top of file, not in the mockup. %>
          <% if @current_user_enrolment&.coordinator? || @current_user_enrolment&.lecturer? %>
            <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-index-param="2"
                    style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;"
                    class="pb-3 border-b-4 transition-colors">Supervised Projects</button>
          <% end %>

          <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-index-param="3"
                  style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;"
                  class="pb-3 border-b-4 transition-colors">Topic Directory</button>

          <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-index-param="4"
                  style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;"
                  class="pb-3 border-b-4 transition-colors">People</button>

          <%# Real navigation, not a tab panel — separate settings page. %>
          <%= link_to "Settings", settings_course_path(@course),
                style: "font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;",
                class: "pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors" %>
        </div>
      </div>

      <!-- Panel 0: Project Details -->
      <div data-tabs-target="panel" class="max-w-5xl mx-auto px-6 py-8">
        <%= render "courses/project_details_tab" %>
      </div>

      <!-- Panel 1: To Review (real redesign) -->
      <div data-tabs-target="panel" class="max-w-5xl mx-auto px-6 py-8 hidden">
        <%= render "courses/to_review_tab" %>
      </div>

      <% if @current_user_enrolment&.coordinator? || @current_user_enrolment&.lecturer? %>
        <!-- Panel 2: Supervised Projects -->
        <div data-tabs-target="panel" class="max-w-5xl mx-auto px-6 py-8 hidden">
          <%= render "courses/supervised_projects_tab" %>
        </div>
      <% end %>

      <!-- Panel 3: Topic Directory -->
      <div data-tabs-target="panel" class="max-w-5xl mx-auto px-6 py-8 hidden">
        <%= render "courses/topic_directory_tab" %>
      </div>

      <!-- Panel 4: People -->
      <div data-tabs-target="panel" class="max-w-5xl mx-auto px-6 py-8 hidden">
        <%= render "courses/people_tab" %>
      </div>

    </main>
  </div>
</div>
