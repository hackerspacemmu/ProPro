<%= link_to course_path(course), class: "group block no-underline" do %>
  <div
    class="relative overflow-hidden rounded-lg h-32 p-5 flex items-start justify-between transition-all duration-200 ease-in-out group-hover:shadow-md group-hover:-translate-y-1 cursor-pointer"
    style="background:<%= theme[:color] %>"
  >
    <h3
      style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: 1.125rem; font-weight: 500; line-height: 1.3;"
      class="relative z-10 text-white truncate group-hover:underline pr-8 max-w-[78%]"
    >
      <%= course.course_name %>
    </h3>
    <svg
      class="relative z-10 w-5 h-5 text-white/50 group-hover:text-white transition-colors shrink-0 mt-0.5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 5l7 7-7 7"
      /></svg>
    <%= image_tag theme[:illustration],
      class: "absolute right-[-18px] bottom-[-42px] w-[230px] h-auto pointer-events-none" %>
  </div>
<% end %>
