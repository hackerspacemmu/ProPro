<%# Empty-state body for the My Submission section (:no_group and :no_proposal).
    Locals: heading, description, cta_label, cta_path. Renders a centered
    decorative illustration, headline, copy, and an inline pill CTA.
    Responsive rules (§13.12): stacks and centers the column below sm,
    uniform py-14 px-6 padding at all widths. %>
<div class="flex flex-col items-center text-center gap-3 py-14 px-6">
  <%= image_tag "illustrations/submission_empty_banner.svg",
        class: "h-[180px] w-auto pointer-events-none select-none",
        alt: "" %>
  <h3 class="text-[16px] font-medium text-[#1F1F1F]"><%= heading %></h3>
  <p class="text-[14px] text-[#5F6368] max-w-[360px]"><%= description %></p>
  <%= link_to cta_path, class: "mt-2 inline-flex items-center justify-center px-5 py-2 text-[14px] font-medium text-white bg-[#0B57D0] rounded-full hover:bg-[#1B66C9] transition-colors" do %>
    <%= cta_label %>
  <% end %>
</div>
