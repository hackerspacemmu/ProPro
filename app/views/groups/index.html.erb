<%# Course/Groups tab page Only routable on grouped
    courses, GroupsController 404s otherwise. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @course, :grouping %>
<%= render "courses/tab_shell",
           course: @course,
           active: "groups",
           current_user_enrolment: @current_user_enrolment do %>
  <%= render "courses/groups_tab" %>
<% end %>
