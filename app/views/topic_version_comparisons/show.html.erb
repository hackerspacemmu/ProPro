<% content_for :title do %>
  <%= @topic.current_title.truncate(TITLE_NAME_LIMIT) %>
  - Compare Versions | ProPro
<% end %>

<%= render layout: "topics/tab_shell",
           locals: {
             topic: @topic,
             course: @course,
             active: "compare",
             current_instance: @current_instance,
             current_version: @current_version,
             latest_version: @latest_version,
             instances: @instances,
             members: @members,
             comments: @comments,
             new_comment: @new_comment,
             comments_count: @comments.size,
             is_student: @is_student
           } do %>

  <% show_source_diff =
    @instances.size == 1 &&
    @topic.source_topic.present? &&
    (@is_coordinator || @topic.owner == current_user) &&
    @topic.source_topic.current_instance.present? %>
  <% if show_source_diff %>
    <% source_instance = @topic.source_topic.current_instance %>
    <%= render "topics/source_topic_diff",
               base_fields: source_instance.project_instance_fields,
               target_fields: @current_fields,
               source_topic: @topic.source_topic %>
  <% else %>
    <%= render "topics/compare_versions_tab",
               fields: @compare_fields,
               next_fields: @compare_next_fields,
               index: @compare_index,
               instances: @instances %>
  <% end %>

<% end %>
