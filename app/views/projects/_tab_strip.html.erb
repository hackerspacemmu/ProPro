
<%# Flash messages %>
<% if flash[:notice] %>
  <div
    data-testid="flash-notice"
    class="
      mx-8 mt-8 w-[calc(100%-4rem)] p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm
      font-bold flex items-center justify-center gap-3 shadow-sm mb-4
    "
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 13l4 4L19 7"
      /></svg>
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert] %>
  <div
    data-testid="flash-alert"
    class="
      mx-8 mt-8 w-[calc(100%-4rem)] p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm
      font-bold flex items-center justify-center gap-3 shadow-sm mb-4
    "
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
      /></svg>
    <%= flash[:alert] %>
  </div>
<% end %>

<%
  version_param = current_version && current_version != 1 ? { version: current_version } : {}
  tabs = [
    { slug: "details", name: "Project Details", path: course_project_path(course, project, version_param) },
    { slug: "compare", name: "Compare Versions", path: course_project_version_comparison_path(course, project, version_param) }
  ]
  if course.use_progress_updates
    tabs << { slug: "progress", name: "Progress Updates", path: course_project_progress_updates_path(course, project, version_param) }
  end
%>

<%# Sticky Tabs %>
<div class="border-b border-outline-variant px-8 sticky top-0 bg-surface z-20">
  <div class="flex items-center gap-3">
    <div class="relative flex-1 min-w-0" data-controller="tab-fade">
      <nav
        data-testid="content-tabs"
        aria-label="Project sections"
        data-tab-fade-target="scroller"
        class="flex flex-nowrap gap-x-2 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [-webkit-overflow-scrolling:touch]"
      >
        <% tabs.each do |tab| %>
          <% selected = tab[:slug] == active %>
          <%= link_to tab[:path],
                id: "tab-#{tab[:slug]}",
                "aria-current": (selected ? "page" : nil),
                style: "font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;",
                class: "group h-[3rem] pt-[0.125rem] px-3 sm:px-6 flex items-center justify-center relative box-border whitespace-nowrap tracking-wide antialiased transition-colors #{selected ? 'text-primary-strong' : 'text-on-surface-variant hover:bg-surface-hover hover:text-on-surface'}" do %>
            <%= tab[:name] %>
            <div class="absolute bottom-0 left-0 w-full h-[3px] rounded-t-[3px] transition-colors <%= selected ? 'bg-primary-strong' : 'bg-transparent' %>"></div>
          <% end %>
        <% end %>
      </nav>

      <%# Trailing-edge fade: only shown while the strip actually overflows %>
      <div
        data-tab-fade-target="rightMask"
        class="hidden pointer-events-none absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-surface to-transparent"
      ></div>
    </div>

    <%# Comments trigger — opens the comments drawer below the desktop breakpoint %>
    <button
      type="button"
      data-comments-drawer-target="trigger"
      data-action="comments-drawer#toggle"
      aria-expanded="false"
      aria-controls="comments-drawer"
      title="Comments"
      class="min-[1245px]:hidden shrink-0 relative w-9 h-9 flex items-center justify-center rounded-full text-on-surface-variant hover:text-on-surface hover:bg-surface-variant transition-colors"
    >
      <span class="material-symbols-outlined text-[20px]">chat_bubble</span>
      <% if comments_count.positive? %>
        <span
          class="absolute -top-0.5 -right-0.5 min-w-4 h-4 px-1 rounded-full bg-primary text-white text-[10px] font-medium leading-4 flex items-center justify-center"
        ><%= comments_count %></span>
      <% end %>
    </button>
  </div>
</div>
