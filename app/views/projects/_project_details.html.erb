<% require "htmldiff" %>
<div class="w-full space-y-8" data-controller="field-expand-modal">
  <div
    class="
      bg-white rounded-xl divide-y divide-gray-100 border border-gray-100 shadow-sm
      overflow-hidden
    "
  >
    <% sorted_fields = fields.sort_by { |f| f.project_template_field&.position || 0 } %>
    <% sorted_fields.each do |field| %>

      <div
        class="
          flex flex-col sm:grid sm:grid-cols-[130px_1fr] md:grid-cols-3 group
          hover:bg-gray-50/50 transition-colors
        "
      >

        <%# Field Label %>
        <div
          class="
            px-4 py-3 sm:p-4 md:p-6 sm:col-span-1 !bg-gray-50/30 border-b sm:border-b-0
            sm:border-r border-gray-100 flex items-center sm:items-start
          "
        >
          <h4
            class="
              text-xs md:text-sm font-bold text-gray-700 uppercase tracking-wide
              leading-relaxed break-words
            "
          >
            <%= field.project_template_field.label %>
          </h4>
        </div>

        <%# Field value calculation (pre-calculated to prevent whitespace issues) %>
        <% display_text = nil
        is_markdown = false

        if field.value.present?
          if field.project_template_field.dropdown? ||
               field.project_template_field.radio?
            begin
              parsed = JSON.parse(field.value)
              display_text = parsed.is_a?(Array) ? parsed.join(", ") : parsed
            rescue JSON::ParserError
              display_text = field.value
            end
          elsif field.project_template_field.textarea?
            display_text = field.value
            is_markdown = true
          else
            display_text = field.value
          end
          display_text = display_text.to_s.strip
        end

        rendered_markdown = is_markdown && display_text.present? ? render_markdown(display_text) : nil %>

        <%# Field value container %>
        <div
          class="
            !p-4 !md:p-6 sm:col-span-1 md:col-span-2 text-gray-900 break-words text-base
            md:text-lg font-medium leading-relaxed min-w-0 !bg-white relative
            <%= is_markdown ? 'prose prose-sm max-w-none' : 'whitespace-pre-wrap' %>
          "
        ><% if rendered_markdown %>
          <button
            type="button"
            data-action="click->field-expand-modal#open"
            data-title="<%= field.project_template_field.label %>"
            class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 transition-colors bg-white/80 rounded-md p-1"
            aria-label="Expand <%= field.project_template_field.label %>"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"
              /></svg>
            <template><%= rendered_markdown %></template>
          </button>
        <% end %><% if display_text.present? %><%= rendered_markdown || display_text %><% else %><span class="text-gray-400 italic font-normal text-base md:text-lg">No content provided</span><% end %></div>
      </div>
    <% end %>

    <% if @course.toggle_topics %>
      <div
        class="
          bg-gray-50/80 p-4 text-xs text-gray-500 font-medium border-t border-gray-100
          flex items-center gap-2
        "
      >
        <svg
          class="w-4 h-4 text-gray-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          /></svg>
        Based on Topic:
        <span class="text-gray-700 font-semibold"><%= based_on_topic_name || "Own Proposal" %></span>
      </div>
    <% end %>
  </div>

  <%# --- FIELD EXPAND MODAL (native <dialog>, shared across all fields in this render) --- %>
  <dialog
    data-field-expand-modal-target="dialog"
    class="w-full max-w-3xl max-h-[85vh] m-auto p-0 rounded-xl border border-gray-100 shadow-lg bg-white backdrop:bg-black/40"
  >
    <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 sticky top-0 bg-white">
    <h4
      data-field-expand-modal-target="title"
      class="text-xs md:text-sm font-bold text-gray-700 uppercase tracking-wide"
    >Field details</h4>
      <button
        type="button"
        data-action="click->field-expand-modal#close"
        class="text-gray-400 hover:text-gray-600 transition-colors"
        aria-label="Close"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          /></svg>
      </button>
    </div>
    <div
      data-field-expand-modal-target="content"
      class="p-5 md:p-6 overflow-y-auto prose prose-sm max-w-none text-base md:text-lg"
    ></div>
  </dialog>
</div>
