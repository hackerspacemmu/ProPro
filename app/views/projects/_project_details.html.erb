<% require "htmldiff" %>
<div class="w-full" data-controller="field-expand-modal">
  <div
    class="
      bg-white border border-[#E0E0E0] rounded-[8px] overflow-hidden
    "
  >
    <% sorted_fields = fields.sort_by { |f| f.project_template_field&.position || 0 } %>
    <% sorted_fields.each do |field| %>

      <%
        display_text = nil
        is_markdown = false
        is_dropdown = false

        if field.value.present?
          if field.project_template_field.dropdown? || field.project_template_field.radio?
            begin
              parsed = JSON.parse(field.value)
              display_text = parsed.is_a?(Array) ? parsed.join(", ") : parsed
              is_dropdown = true
            rescue JSON::ParserError
              display_text = field.value
            end
          elsif field.project_template_field.textarea?
            display_text = field.value
            is_markdown = true
          else
            display_text = field.value
          end
          display_text = display_text.to_s.strip
        end

        rendered_markdown = is_markdown && display_text.present? ? render_markdown(display_text) : nil
      %>

      <% if is_markdown %>
        <%# --- Rich Text Field: stacked layout --- %>
        <div class="py-5 px-6 border-b border-[#E0E0E0] flex flex-col gap-3 hover:bg-[#F8F9FA] transition-colors">
          <div class="text-[11px] font-medium text-[#5F6368] uppercase tracking-wider">
            <%= field.project_template_field.label %>
          </div>
          <div
            class="
              text-[15px] text-[#3C4043] leading-relaxed bg-white border border-[#E0E0E0]
              rounded-[4px] p-5 prose prose-sm max-w-none relative
            "
          >
            <% if display_text.present? %><%= rendered_markdown %><% else %><span class="text-[#5F6368] italic font-normal">No content provided</span><% end %>
            <button
              type="button"
              data-action="click->field-expand-modal#open"
              data-title="<%= field.project_template_field.label %>"
              class="absolute top-3 right-3 text-[#5F6368] hover:text-[#3C4043] transition-colors bg-white/80 rounded-md p-1"
              aria-label="Expand <%= field.project_template_field.label %>"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"
                /></svg>
              <template><%= rendered_markdown %></template>
            </button>
          </div>
        </div>

      <% else %>
        <%# --- Regular Field: horizontal row --- %>
        <div class="py-4 px-6 border-b border-[#E0E0E0] flex flex-col md:flex-row md:items-start gap-2 md:gap-8 hover:bg-[#F8F9FA] transition-colors">
          <div class="text-[11px] font-medium text-[#5F6368] uppercase tracking-wider md:w-1/3 shrink-0 pt-1">
            <%= field.project_template_field.label %>
          </div>
          <div class="text-[14px] text-[#3C4043] md:w-2/3 flex flex-wrap gap-2">
            <% if display_text.present? %>
              <% if is_dropdown %>
                <span class="bg-[#F1F3F4] border border-[#DADCE0] text-[#3C4043] px-3 py-1 rounded-[4px] text-[13px] font-medium"><%= display_text %></span>
              <% else %>
                <%= display_text %>
              <% end %>
            <% else %>
              <span class="text-[#5F6368] italic font-normal">No content provided</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @course.toggle_topics %>
      <div class="p-4 bg-[#F8F9FA] rounded-b-[8px]">
        <div class="flex items-center gap-2 text-[12px] text-[#5F6368]">
          <span class="material-symbols-outlined text-[16px]">info</span>
          <span>Based on Topic: <strong class="text-[#3C4043] font-medium"><%= based_on_topic_name || "Own Proposal" %></strong></span>
        </div>
      </div>
    <% end %>
  </div>

  <%# --- FIELD EXPAND MODAL --- %>
  <dialog
    data-field-expand-modal-target="dialog"
    class="w-full max-w-3xl max-h-[85vh] m-auto p-0 rounded-xl border border-[#E0E0E0] shadow-lg bg-white backdrop:bg-black/40"
  >
    <div class="flex items-center justify-between px-5 py-4 border-b border-[#E0E0E0] sticky top-0 bg-white">
      <h4
        data-field-expand-modal-target="title"
        class="text-xs md:text-sm font-bold text-[#3C4043] uppercase tracking-wide"
      >Field details</h4>
      <button
        type="button"
        data-action="click->field-expand-modal#close"
        class="text-[#5F6368] hover:text-[#3C4043] transition-colors"
        aria-label="Close"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          /></svg>
      </button>
    </div>
    <div
      data-field-expand-modal-target="content"
      class="p-5 md:p-6 overflow-y-auto prose prose-sm max-w-none text-base md:text-lg"
    ></div>
  </dialog>
</div>
