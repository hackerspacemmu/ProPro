<%# locals: (comments:, current_instance_id:, current_version:, latest_version:, new_comment:, project:, course:) %>

<section
  id="project-comments"
  class="
    w-full flex flex-col h-full bg-white rounded-2xl shadow-sm border
    border-gray-100 overflow-hidden
  "
>

  <div
    class="
      px-5 py-4 border-b border-gray-100 bg-gray-50/50 flex items-center
      justify-between
    "
  >
    <h2 style="font-family: 'Google Sans', sans-serif;" class="text-[16px] text-[#1f1f1f]">Comments</h2>
    <% if comments.any? %>
      <span
        class="
          bg-[#F1F3F4] text-[#3C4043] px-2 py-0.5 rounded-full text-xs font-medium
        "
      ><%= comments.count %></span>
    <% end %>
  </div>

  <div
    class="
      flex-1 min-h-0 overflow-y-auto bg-[#f8fafd] p-6 custom-scrollbar relative
    "
    data-controller="scroll-to-bottom"
    data-scroll-to-bottom-enabled-value="<%= current_version == latest_version %>"
    data-scroll-to-bottom-target-version-value="<%= current_version %>"
  >

    <% if comments.any? %>
      <div class="space-y-6 relative">

        <% comments.group_by { |c| c.location.version }.each do |version, version_comments| %>
          <div class="mb-4" id="version-<%= version %>-comments">
            <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-4 flex items-center gap-2">
              Comments for V<%= version %>
            </div>
          </div>
          <% version_comments.each do |comment| %>
            <% is_current_version = comment.location_id == current_instance_id %>

            <div class="flex gap-3 group <%= is_current_version ? '' : 'opacity-60 hover:opacity-100 transition-opacity duration-300' %>">
              <div
                class="
                  w-8 h-8 rounded-full bg-[#1A73E8] text-white flex items-center
                  justify-center text-xs font-medium shrink-0
                "
              >
                <%= comment.user.name[0].upcase %>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex justify-between items-start mb-1">
                  <% if Current.user == comment.user %>
                    <span class="text-sm font-medium text-[#137333]"><%= comment.user.name %></span>
                  <% else %>
                    <span class="text-sm font-medium text-[#3C4043]"><%= comment.user.name %></span>
                  <% end %>

                  <span class="text-xs text-[#5F6368]">
                    <% if comment.created_at > 3.days.ago %>
                      <%= time_ago_in_words(comment.created_at) %> ago
                    <% else %>
                      <%= format_timestamp(comment.created_at) %>
                    <% end %>
                  </span>
                </div>

                <div class="text-[14px] text-[#3C4043] leading-relaxed break-words">
                  <% if !comment.deleted %>
                    <%= simple_format(comment.text, class: "mb-3 last:mb-0") %>
                  <% else %>
                    <span class="text-[14px] text-[#5F6368] italic">This comment was deleted</span>
                  <% end %>
                </div>
              </div>

              <%# delete button %>
              <% if Current.user == comment.user && !comment.deleted %>
                <%= link_to soft_delete_comment_path(comment),
                    data: { turbo_method: :patch, confirm: "Delete this comment?" },
                    class: "text-[#5F6368] hover:text-[#C5221F] opacity-0 group-hover:opacity-100 transition-opacity self-start mt-0.5 flex-shrink-0",
                    title: "Delete comment" do %>
                  <span class="material-symbols-outlined text-[16px]">close</span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

    <% else %>
      <div
        class="
          h-full flex flex-col items-center justify-center text-center opacity-60
        "
      >
        <span class="material-symbols-outlined text-[48px] text-gray-300 mb-2">chat_bubble_outline</span>
        <p class="text-sm text-gray-500">No comments yet.</p>
        <p class="text-xs text-gray-400">Be the first to start the discussion.</p>
      </div>
    <% end %>
  </div>

  <% if policy(new_comment).create? %>
    <div class="p-4 border-t border-[#E0E0E0] bg-white shrink-0">
      <%= form_with model: new_comment, local: true do |form| %>
        <%= form.hidden_field :source_type, value: "ProjectInstance" %>
        <%= form.hidden_field :source_id, value: current_instance_id %>

        <div
          class="
            border border-[#DADCE0] rounded-lg focus-within:border-[#1A73E8]
            focus-within:ring-1 focus-within:ring-[#1A73E8] transition-all bg-white
            flex items-end
          "
        >
          <%= form.text_area :user_comment,
                         class:
                           "w-full bg-transparent border-none p-3 text-[#3C4043] focus:ring-0 text-[14px] resize-none min-h-[44px] outline-none",
                         rows: 1,
                         data: {
                           controller: "textarea-resize",
                           action:
                             "input->textarea-resize#commentResize turbo:submit-end@window->textarea-resize#resetComment",
                         },
                         placeholder: "Write a comment..." %>

          <%= form.button type: "submit",
              class: "p-2 m-1 text-[#1A73E8] hover:bg-[#F1F3F4] rounded-full transition-colors flex items-center justify-center",
              title: "Send" do %>
            <span class="material-symbols-outlined text-[20px]">send</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

</section>
