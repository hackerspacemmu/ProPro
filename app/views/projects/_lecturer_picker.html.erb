<%# locals: (course:, lecturer_capacity_info:) %>

<% enrolments = course.enrolments.where(role: :lecturer).includes(:user).order(:id) %>

<dialog
  data-method-picker-target="lecturerDialog"
  class="rounded-[28px] shadow-xl w-full max-w-lg max-h-[85dvh] open:flex flex-col overflow-hidden m-auto backdrop:bg-black/50"
  aria-label="Choose a supervisor"
>
  <div class="px-5 sm:px-6 pt-5 sm:pt-6 pb-4 flex items-center justify-between gap-4 shrink-0">
    <h2 style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="text-[20px] sm:text-[22px] font-normal text-on-surface-strong">
      Choose a Supervisor
    </h2>
    <button
      type="button"
      data-action="click->method-picker#closeLecturer"
      class="text-on-surface-variant hover:bg-surface-variant rounded-full p-2 transition-colors flex items-center justify-center shrink-0"
    >
      <span class="material-symbols-outlined text-[24px]">close</span>
    </button>
  </div>

  <div class="px-5 sm:px-6 pb-6 overflow-y-auto flex-1 space-y-3">
    <% if enrolments.empty? %>
      <p class="text-[14px] text-on-surface-variant">No supervisors are available for this course.</p>
    <% else %>
      <% enrolments.each do |enrolment| %>
        <% lecturer = enrolment.user %>
        <% capacity = lecturer_capacity_info[enrolment.user_id] %>
        <% pending = capacity ? capacity.pending_count : 0 %>
        <% capacity_label = "#{capacity ? capacity.approved_count : 0}/#{capacity ? capacity.effective_cap : 0} approved" %>
        <% capacity_label += " · #{pending} pending" if pending.positive? %>

        <button
          type="button"
          data-method-picker-target="lecturerOption"
          data-enrolment-id="<%= enrolment.id %>"
          data-name="<%= lecturer.name %>"
          data-avatar="<%= lecturer.name.split.map(&:first).first(2).join.upcase %>"
          data-capacity="<%= capacity_label %>"
          data-action="click->method-picker#chooseLecturer"
          class="w-full flex items-center gap-3 p-3 rounded-[8px] border border-outline hover:border-primary hover:bg-surface-hover transition-colors text-left"
        >
          <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center text-[13px] font-bold shrink-0">
            <%= lecturer.name.split.map(&:first).first(2).join.upcase %>
          </div>
          <div class="min-w-0">
            <div class="text-[14px] font-medium text-on-surface-strong truncate"><%= lecturer.name %></div>
            <div class="text-[12px] text-on-surface-variant"><%= capacity_label %></div>
          </div>
        </button>
      <% end %>
    <% end %>
  </div>
</dialog>
