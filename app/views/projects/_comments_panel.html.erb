<%# locals: (project:, comments:) %>
<div class="w-[380px] bg-[#f8fafd] border-l border-[#E0E0E0] flex flex-col shrink-0">
  <div class="px-6 py-4 border-b border-[#E0E0E0] flex items-center justify-between bg-white shrink-0">
    <h2 style="font-family: 'Google Sans', sans-serif;" class="text-[16px] text-[#1f1f1f]">Comments</h2>
    <span class="bg-[#F1F3F4] text-[#3C4043] px-2 py-0.5 rounded-full text-xs font-medium"><%= comments.size %></span>
  </div>

  <div class="flex-1 overflow-y-auto p-6 space-y-6">
    <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-4">
      Comments for V<%= project.current_version_number %>
    </div>
    <%= render partial: "projects/comment", collection: comments %>
  </div>

  <div class="p-4 bg-white border-t border-[#E0E0E0] shrink-0">
    <%= form_with model: [project, Comment.new],
          class: "border border-[#DADCE0] rounded-lg focus-within:border-[#1A73E8] focus-within:ring-1 focus-within:ring-[#1A73E8] transition-all bg-white flex items-end" do |f| %>
      <%= f.text_area :body, rows: 1, class: "w-full bg-transparent border-none p-3 text-[#3C4043] focus:ring-0 text-[14px] resize-none min-h-[44px] outline-none", placeholder: "Write a comment..." %>
      <%= f.button type: "submit", class: "p-2 m-1 text-[#1A73E8] hover:bg-[#F1F3F4] rounded-full transition-colors flex items-center justify-center" do %>
        <span class="material-symbols-outlined text-[20px]">send</span>
      <% end %>
    <% end %>
  </div>
</div>
