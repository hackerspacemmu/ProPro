<% is_member = members.include?(current_user)
is_history = current_version != latest_version
has_actions = is_member || is_history %>

<section class="w-full">
  <div class="flex flex-col gap-4">

    <%# --- STUDENT ACTIONS --- %>
    <% if is_member && !is_history %>
      <% if policy(project).update? %>
        <div class="w-full">
          <p
            class="
              text-xs font-bold text-green-600 uppercase tracking-wide mb-2 flex items-center
              gap-1
            ">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            Latest Version
          </p>

          <%= link_to edit_course_project_path(course, project),
              class: "flex items-center justify-center w-full gap-2 bg-[#1A73E8] hover:bg-[#1B66C9] hover:shadow-md text-white py-2.5 px-4 rounded-full font-medium text-[14px] transition-all" do %>
            <%= image_tag "edit_white.svg", class: "w-4 h-4" %>
            <span>Edit Proposal</span>
          <% end %>
        </div>

      <% else %>
        <div
          class="
            w-full py-2.5 border border-[#DADCE0] bg-[#F1F3F4] rounded-full flex items-center
            justify-center gap-2 text-[#9AA0A6] select-none
          ">
          <%= image_tag "lock.svg", class: "w-4 h-4 opacity-50 grayscale" %>
          <span class="text-[14px] font-medium">Unable to Edit Project</span>
        </div>
      <% end %>
    <% end %>

    <%# --- VERSION JUMP ACTION --- %>
    <% if is_history %>
      <%= link_to course_project_path(course, project),
          class: "flex items-center justify-center w-full gap-2 border border-[#DADCE0] text-[#1A73E8] hover:bg-[#F8F9FA] py-2.5 px-4 rounded-full font-medium text-[14px] transition-colors group" do %>

        <div
          class="
            w-5 h-5 rounded-full bg-[#E8F0FE] flex items-center justify-center
            group-hover:bg-white transition-colors
          ">
          <%= image_tag "jump_version.svg", class: "w-3 h-3" %>
        </div>

        <span>Jump To Latest Version</span>
      <% end %>
    <% end %>

  </div>
</section>
