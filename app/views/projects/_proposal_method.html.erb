<%# locals: (course:, selected_lecturer:, selected_topic:, lecturer_capacity_info:, selected_own_proposal_lecturer_id: nil, project: nil, readonly: false, topics: [], topic_pick_values: {}) %>

<% lecturer_selected = selected_lecturer.present? %>
<% topic_selected = selected_topic.present? %>
<% has_lecturer_choice = !course.solo_supervisor? %>
<% has_topic_choice = course.toggle_topics %>

<% solo_id = course.enrolments.find_by(role: :lecturer)&.id if course.solo_supervisor? %>
<% based_on_topic_value =
     topic_selected ? selected_topic.id.to_s :
     (selected_own_proposal_lecturer_id.present? ? "own_proposal_#{selected_own_proposal_lecturer_id}" :
     (course.solo_supervisor? ? "own_proposal_#{solo_id}" : "")) %>

<% lecturer_capacity = lecturer_selected ? lecturer_capacity_info[selected_lecturer.id] : nil %>
<% pending_count = lecturer_capacity ? lecturer_capacity.pending_count : 0 %>
<% capacity_label = "#{lecturer_capacity ? lecturer_capacity.approved_count : 0}/#{lecturer_capacity ? lecturer_capacity.effective_cap : 0} approved" %>
<% capacity_label += " · #{pending_count} pending" if pending_count.positive? %>
<% lecturer_initials = lecturer_selected ? selected_lecturer.name.split.map(&:first).first(2).join.upcase : "" %>

<section
  class="bg-white border border-[#E0E0E0] rounded-[12px] p-8 shadow-xs space-y-6"
  <%= 'data-controller="method-picker"'.html_safe unless readonly %>
>
  <div>
    <h2 class="text-[16px] font-semibold text-[#1f1f1f] tracking-tight font-google-sans">
      Proposal Method
    </h2>
    <p class="text-[13px] text-[#5F6368] mt-1">
      Select how your proposal is submitted for approval.
    </p>
  </div>

  <%= hidden_field_tag :based_on_topic, based_on_topic_value,
        data: { method_picker_target: "basedOnTopic" } %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 <%= 'opacity-50 pointer-events-none' if readonly %>">

    <%# Card A: Propose to Lecturer %>
    <% if has_lecturer_choice %>
      <div
        data-method-picker-target="lecturerCard"
        data-active-classes="border-2 border-[#1A73E8] bg-[#F8F9FA] shadow-xs"
        data-inactive-classes="border border-[#DADCE0] bg-white hover:border-[#1A73E8]"
        class="rounded-[10px] p-5 relative cursor-pointer flex flex-col justify-between transition-all <%= lecturer_selected ? 'border-2 border-[#1A73E8] bg-[#F8F9FA] shadow-xs' : 'border border-[#DADCE0] bg-white hover:border-[#1A73E8]' %>"
        <%= 'data-action="click->method-picker#openLecturerPicker"'.html_safe unless readonly %>
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-full bg-[#E8F0FE] text-[#1A73E8] flex items-center justify-center">
              <span class="material-symbols-outlined text-[20px]">person</span>
            </div>
            <div
              data-method-picker-target="lecturerIndicator"
              class="w-5 h-5 rounded-full flex items-center justify-center <%= lecturer_selected ? 'bg-[#1A73E8] text-white' : 'border border-[#DADCE0]' %>"
            >
              <span data-method-picker-target="lecturerCheck" class="material-symbols-outlined text-[14px] <%= 'hidden' unless lecturer_selected %>">check</span>
            </div>
          </div>
          <h3 class="text-[15px] font-semibold text-[#1f1f1f] font-google-sans">Propose to Lecturer</h3>
          <p class="text-[13px] text-[#5F6368] mt-1">Submit your original project proposal directly to a supervisor.</p>
        </div>

        <div class="mt-5 pt-4 border-t border-[#E0E0E0]">
          <div data-method-picker-target="lecturerSurface" class="bg-white border border-[#DADCE0] rounded-[8px] p-3 flex items-center justify-between gap-3 <%= 'hidden' unless lecturer_selected %>">
            <div class="flex items-center gap-3 min-w-0">
              <div data-method-picker-target="lecturerAvatar" class="w-9 h-9 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-[13px] font-bold font-google-sans shrink-0"><%= lecturer_initials %></div>
              <div class="min-w-0">
                <div data-method-picker-target="lecturerName" class="text-[14px] font-medium text-[#1f1f1f] font-google-sans truncate"><%= lecturer_selected ? selected_lecturer.name : "" %></div>
                <div data-method-picker-target="lecturerCapacity" class="text-[12px] text-[#5F6368]"><%= capacity_label %></div>
              </div>
            </div>
            <% unless readonly %>
              <button type="button" data-action="click->method-picker#openLecturerPicker" class="text-[13px] text-[#1A73E8] font-medium hover:underline font-google-sans shrink-0">
                Change
              </button>
            <% end %>
          </div>

          <div data-method-picker-target="lecturerEmpty" class="bg-white border border-[#DADCE0] rounded-[8px] p-3 text-center <%= 'hidden' if lecturer_selected %>">
            <p class="text-[12px] text-[#5F6368] mb-2">No supervisor selected</p>
            <% unless readonly %>
              <button type="button" data-action="click->method-picker#openLecturerPicker" class="w-full py-2.5 px-3 rounded-[6px] bg-[#F1F3F4] hover:bg-[#E8F0FE] text-[#3C4043] hover:text-[#1A73E8] text-[13px] font-medium transition-colors font-google-sans flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-[18px]">search</span>
                Select a supervisor
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Card B: Base on a Topic %>
    <% if has_topic_choice %>
      <div
        data-method-picker-target="topicCard"
        data-active-classes="border-2 border-[#1A73E8] bg-[#F8F9FA] shadow-xs"
        data-inactive-classes="border border-[#DADCE0] bg-white hover:border-[#1A73E8]"
        class="rounded-[10px] p-5 relative cursor-pointer flex flex-col justify-between transition-all <%= topic_selected ? 'border-2 border-[#1A73E8] bg-[#F8F9FA] shadow-xs' : 'border border-[#DADCE0] bg-white hover:border-[#1A73E8]' %>"
        <%= 'data-action="click->method-picker#openTopicPicker"'.html_safe unless readonly %>
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-full bg-[#F1F3F4] text-[#5F6368] flex items-center justify-center">
              <span class="material-symbols-outlined text-[20px]">article</span>
            </div>
            <div
              data-method-picker-target="topicIndicator"
              class="w-5 h-5 rounded-full flex items-center justify-center <%= topic_selected ? 'bg-[#1A73E8] text-white' : 'border border-[#DADCE0]' %>"
            >
              <span data-method-picker-target="topicCheck" class="material-symbols-outlined text-[14px] <%= 'hidden' unless topic_selected %>">check</span>
            </div>
          </div>
          <h3 class="text-[15px] font-semibold text-[#1f1f1f] font-google-sans">Base on a Topic</h3>
          <p class="text-[13px] text-[#5F6368] mt-1">Select from a pre-defined course topic curated by lecturers.</p>
        </div>

        <div class="mt-5 pt-4 border-t border-[#E0E0E0]">
          <div data-method-picker-target="topicSurface" class="bg-white border border-[#DADCE0] rounded-[8px] p-3 flex items-center justify-between gap-3 <%= 'hidden' unless topic_selected %>">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-9 h-9 rounded-full bg-[#F1F3F4] text-[#5F6368] flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[18px]">article</span>
              </div>
              <div data-method-picker-target="topicName" class="text-[14px] font-medium text-[#1f1f1f] font-google-sans truncate"><%= topic_selected ? selected_topic.current_title : "" %></div>
            </div>
            <% unless readonly %>
              <button type="button" data-action="click->method-picker#openTopicPicker" class="text-[13px] text-[#1A73E8] font-medium hover:underline font-google-sans shrink-0">
                Change
              </button>
            <% end %>
          </div>

          <div data-method-picker-target="topicEmpty" class="bg-white border border-[#DADCE0] rounded-[8px] p-3 text-center <%= 'hidden' if topic_selected %>">
            <% if course.solo_supervisor? %>
              <p class="text-[12px] text-[#5F6368] mb-2">Selecting a topic is optional. If none is chosen, your proposal will default to an own proposal.</p>
            <% end %>
            <% unless readonly %>
              <button type="button" data-action="click->method-picker#openTopicPicker" class="w-full py-2.5 px-3 rounded-[6px] bg-[#F1F3F4] hover:bg-[#E8F0FE] text-[#3C4043] hover:text-[#1A73E8] text-[13px] font-medium transition-colors font-google-sans flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-[18px]">search</span>
                Browse Topic Catalog
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% unless readonly %>
    <%= render "lecturer_picker", course: course, lecturer_capacity_info: lecturer_capacity_info %>
    <%= render "topic_picker", course: course, topics: topics, topic_pick_values: topic_pick_values %>
  <% end %>
</section>
