<%# locals: (current_instance:, project:, course:, current_version:, latest_version:, instances:) %>

<%# Flash messages %>
<% if flash[:notice] %>
  <div
    data-testid="flash-notice"
    class="
      w-full p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm
      font-bold flex items-center justify-center gap-3 shadow-sm mb-4
    "
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 13l4 4L19 7"
      /></svg>
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert] %>
  <div
    data-testid="flash-alert"
    class="
      w-full p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm
      font-bold flex items-center justify-center gap-3 shadow-sm mb-4
    "
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
      /></svg>
    <%= flash[:alert] %>
  </div>
<% end %>

<%# Context Header %>
<div class="px-8 pt-8 pb-4">
  <div class="flex items-start justify-between mb-2">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <%# Status badge (pill) %>
        <% status_badge =
          case current_instance.status
          when "approved"
            "bg-[#E6F4EA] text-[#137333]"
          when "rejected"
            "bg-[#FCE8E6] text-[#C5221F]"
          when "redo"
            "bg-[#FFF8E1] text-[#F57F17]"
          else
            "bg-[#E8F0FE] text-[#1967D2]"
          end %>
        <span class="<%= status_badge %> px-3 py-1 rounded-full text-xs font-medium tracking-wide">
          <%= current_instance.status.humanize %>
        </span>

        <%# Timestamp %>
        <% if current_instance.last_status_change_time.present? %>
          <span class="text-[14px] text-[#444746]">
            <%= time_ago_in_words(current_instance.last_status_change_time) %> ago
          </span>
        <% end %>
      </div>

      <%# Title %>
      <h1
        style="font-family: 'Google Sans', sans-serif;"
        class="text-[28px] text-[#1f1f1f] font-normal tracking-tight"
      >
        <%= current_instance.title %>
      </h1>
    </div>

    <div class="flex items-center gap-4">
      <%# Version Selector %>
      <div class="flex items-center gap-2 mr-2">
        <span class="text-sm font-medium text-[#5F6368]">Version:</span>
        <%= select_tag nil,
            options_for_select(
              instances.each_with_index.map do |inst, i|
                label = "#{i + 1} of #{instances.size}"
                label += " (Current)" if i == instances.size - 1
                [label, i + 1]
              end,
              current_version
            ),
            data: {
              controller: "version-select",
              version_select_course_value: course.id,
              version_select_project_value: project.id,
              action: "change->version-select#navigate"
            },
            class: "bg-white border border-[#DADCE0] rounded-[4px] px-3 py-2 text-sm text-[#3C4043] focus:outline-none focus:ring-2 focus:ring-[#1A73E8] focus:border-transparent cursor-pointer" %>
      </div>

      <%# Split Button (Approve + dropdown) — only for supervisor on latest version %>
      <% if current_user == project.supervisor && current_version == latest_version %>
        <div class="relative" data-controller="dropdown">
          <div class="inline-flex shadow-sm rounded-full">
            <%# Primary Action (Approve) %>
            <%= button_to "Approve",
                change_status_course_project_path(course, project, status: "approved"),
                method: :patch,
                class: "bg-[#137333] hover:bg-[#0f5c29] text-white pl-5 pr-4 py-2.5 rounded-l-full font-medium text-[14px] transition-colors flex items-center gap-2" %>

            <div class="w-[1px] bg-white/30"></div>

            <%# Dropdown Trigger %>
            <button
              type="button"
              data-action="click->dropdown#toggle"
              class="bg-[#137333] hover:bg-[#0f5c29] text-white pl-2 pr-3 py-2.5 rounded-r-full transition-colors flex items-center justify-center"
            >
              <span class="material-symbols-outlined text-[20px]">arrow_drop_down</span>
            </button>
          </div>

          <%# Dropdown Menu %>
          <div
            data-dropdown-target="menu"
            class="
              absolute right-0 top-full mt-1.5 w-56 bg-white border border-[#E0E0E0]
              rounded-lg shadow-lg overflow-hidden z-50 hidden origin-top-right
            "
          >
            <div class="py-1">
              <%= button_to change_status_course_project_path(course, project, status: "redo"),
                  method: :patch,
                  class: "w-full text-left px-4 py-2.5 hover:bg-[#F8F9FA] flex items-center gap-3 transition-colors" do %>
                <span class="material-symbols-outlined text-[18px] text-[#5F6368]">replay</span>
                <div class="flex flex-col">
                  <span class="text-[14px] text-[#3C4043] font-medium">Request Changes</span>
                  <span class="text-xs text-[#5F6368]">Return to group for redo</span>
                </div>
              <% end %>

              <div class="border-t border-[#E0E0E0] my-1"></div>

              <%= button_to change_status_course_project_path(course, project, status: "rejected"),
                  method: :patch,
                  class: "w-full text-left px-4 py-2.5 hover:bg-[#FCE8E6] flex items-center gap-3 transition-colors" do %>
                <span class="material-symbols-outlined text-[18px] text-[#C5221F]">block</span>
                <div class="flex flex-col">
                  <span class="text-[14px] text-[#C5221F] font-medium">Reject Proposal</span>
                  <span class="text-xs text-[#C5221F]/70">Close out permanently</span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
