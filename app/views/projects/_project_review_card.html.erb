  <div class="flex items-center justify-between">
    <h2 style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="text-[16px] font-medium text-on-surface-strong">Review Project</h2>
  </div>

  <%= render "projects/review_actions",
