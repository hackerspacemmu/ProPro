<%# locals: (project:, course:, current_version:, latest_version:, instances:, members:) %>

<div class="hidden min-[1245px]:flex flex-col gap-5 shrink-0 bg-[#FFFFFF] border border-[#E0E0E0] rounded-[8px] p-5">

  <div class="flex items-center justify-between">
    <h2 style="font-family: 'Google Sans', sans-serif;" class="text-[16px] font-medium text-[#1f1f1f]">Review Project</h2>
    <span class="text-[11px] font-medium text-[#137333] bg-[#E6F4EA] px-2 py-0.5 rounded-[4px]">Active</span>
  </div>

  <%= render "review_actions",
  project: project,
  course: course,
  current_version: current_version,
  latest_version: latest_version,
  instances: instances,
  members: members %>
</div>
