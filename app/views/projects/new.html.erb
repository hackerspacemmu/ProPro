<% content_for :no_sidebar, true %>
<% content_for :hide_toggler, true %>
<% content_for :hide_breadcrumbs, true %>
<% content_for :body_class, "bg-[#f8fafd]" %>
<% breadcrumb :new_project, @course %>
<% content_for :title,
"Create Proposal - #{@course.course_name.truncate(TITLE_NAME_LIMIT)} | ProPro" %>

<div class="min-h-screen bg-[#f8fafd] text-[#3C4043] font-['Roboto',sans-serif] flex flex-col">

  <header
    class="
      sticky top-0 z-30 bg-white border-b border-[#E0E0E0] px-6 py-3.5 flex
      items-center justify-between shadow-xs
    "
  >
    <div class="flex items-center gap-4">
      <%= link_to course_path(@course),
          title: "Close and return to course",
          class: "p-2 -ml-2 rounded-full hover:bg-[#F1F3F4] text-[#5F6368] hover:text-[#3C4043] transition-colors flex items-center justify-center" do %>
        <span class="material-symbols-outlined text-[22px]">close</span>
      <% end %>

      <div class="h-5 w-[1px] bg-[#DADCE0]"></div>

      <h1 style="font-family: 'Google Sans', sans-serif;" class="text-[18px] text-[#1f1f1f] font-medium tracking-tight">
        Create Proposal — <span class="text-[#5F6368] font-normal"><%= @course.course_name %></span>
      </h1>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to "Discard Changes",
          course_path(@course),
          class: "px-5 py-2 rounded-full text-[#5F6368] hover:bg-[#F1F3F4] hover:text-[#3C4043] font-medium text-[14px] transition-colors" %>
      <button
        type="submit"
        form="project-form"
        class="bg-[#1A73E8] hover:bg-[#1557B0] text-white px-6 py-2 rounded-full font-medium text-[14px] transition-all flex items-center gap-2 shadow-sm"
      >
        <span class="material-symbols-outlined text-[18px]">check</span>
        Create Proposal
      </button>
    </div>
  </header>

  <main class="flex-1 py-10 px-4 sm:px-6 overflow-y-auto">
    <div class="max-w-4xl mx-auto space-y-8">

      <%= form_with url: course_projects_path(@course),
            method: :post,
            local: true,
            html: { id: "project-form" },
            class: "space-y-8" do |form| %>

        <% if @course.toggle_topics || !@course.solo_supervisor? %>
          <%= render "proposal_method",
              course: @course,
              selected_lecturer: @selected_lecturer,
              selected_topic: @selected_topic,
              selected_own_proposal_lecturer_id: @selected_lecturer_enrolment&.id,
              lecturer_capacity_info: @lecturer_capacity_info,
              topics: @topics,
              topic_pick_values: @topic_pick_values %>
        <% end %>

        <section class="bg-white border border-[#E0E0E0] rounded-[12px] p-8 shadow-xs space-y-8">
          <div class="border-b border-[#E0E0E0] pb-4">
            <h2 class="text-[16px] font-semibold text-[#1f1f1f] tracking-tight font-['Google_Sans',sans-serif]">
              Project Details
            </h2>
            <p class="text-[13px] text-[#5F6368] mt-1">Fill out the template fields required.</p>
          </div>

          <%= render "template_fields",
              template_fields: @template_fields,
              values: @field_values,
              is_approved: false %>
        </section>

        <div class="flex items-center justify-between pt-4 pb-8">
          <%= link_to "Cancel",
              course_path(@course),
              class: "text-[14px] font-medium text-[#5F6368] hover:text-[#3C4043]" %>
          <button
            type="submit"
            class="bg-[#1A73E8] hover:bg-[#1557B0] text-white px-6 py-2.5 rounded-full font-medium text-[14px] transition-all flex items-center gap-2 shadow-sm"
          >
            <span class="material-symbols-outlined text-[18px]">check</span>
            Create Proposal
          </button>
        </div>

      <% end %>
    </div>
  </main>
</div>
