<% content_for :no_sidebar, true %>
<% content_for :no_header, true %>
<% content_for :no_footer, true %>
<% content_for :hide_toggler, true %>
<% content_for :hide_breadcrumbs, true %>
<% content_for :body_class, "bg-surface-tint" %>
<% breadcrumb :new_project, @course %>
<% content_for :title,
"Create Proposal - #{@course.course_name.truncate(TITLE_NAME_LIMIT)} | ProPro" %>

<div class="min-h-screen bg-surface-tint text-on-surface font-['Roboto',sans-serif] flex flex-col">

  <header
    class="
      sticky top-0 z-30 bg-white border-b border-outline-variant px-4 sm:px-6 py-3.5 flex
      items-center justify-between gap-4 shadow-xs
    "
  >
    <div class="flex items-center gap-4 min-w-0">
      <%= link_to course_path(@course),
          title: "Close and return to course",
          class: "p-2 -ml-2 rounded-full hover:bg-surface-variant text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center shrink-0" do %>
        <span class="material-symbols-outlined text-[22px]">close</span>
      <% end %>

      <div class="h-5 w-[1px] bg-outline shrink-0"></div>

      <h1 style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="text-[18px] text-on-surface-strong font-medium tracking-tight truncate min-w-0">
        Create Proposal — <span class="text-on-surface-variant font-normal"><%= @course.course_name %></span>
      </h1>
    </div>

    <div class="hidden min-[1245px]:flex items-center gap-3 shrink-0">
      <%= link_to "Discard Changes",
          course_path(@course),
          class: "px-5 py-2 rounded-full text-on-surface-variant hover:bg-surface-variant hover:text-on-surface font-medium text-[14px] transition-colors whitespace-nowrap" %>
      <button
        type="submit"
        form="project-form"
        class="bg-primary hover:bg-primary-hover text-white px-6 py-2 rounded-full font-medium text-[14px] transition-all flex items-center gap-2 shadow-sm whitespace-nowrap"
      >
        <span class="material-symbols-outlined text-[18px]">check</span>
        Create Proposal
      </button>
    </div>
  </header>

  <main class="flex-1 pt-10 pb-28 px-4 sm:px-6 min-[1245px]:pb-10 overflow-y-auto">
    <div class="max-w-4xl mx-auto space-y-8">

      <%= form_with url: course_projects_path(@course),
            method: :post,
            local: true,
            html: { id: "project-form" },
            class: "space-y-8" do |form| %>

        <% if @course.toggle_topics || !@course.solo_supervisor? %>
          <%= render "proposal_method",
              course: @course,
              selected_lecturer: @selected_lecturer,
              selected_topic: @selected_topic,
              selected_own_proposal_lecturer_id: @selected_lecturer_enrolment&.id,
              lecturer_capacity_info: @lecturer_capacity_info,
              topics: @topics,
              topic_pick_values: @topic_pick_values %>
        <% end %>

        <section class="bg-white border border-outline-variant rounded-[12px] p-5 sm:p-8 shadow-xs space-y-8">
          <div class="border-b border-outline-variant pb-4">
            <h2 class="text-[16px] font-semibold text-on-surface-strong tracking-tight font-['DM_Sans',Roboto,Arial,sans-serif]">
              Project Details
            </h2>
            <p class="text-[13px] text-on-surface-variant mt-1">Fill out the template fields required.</p>
          </div>

          <%= render "template_fields",
              template_fields: @template_fields,
              values: @field_values,
              is_approved: false %>
        </section>

        <div class="hidden min-[1245px]:flex items-center justify-between pt-4 pb-8">
          <%= link_to "Cancel",
              course_path(@course),
              class: "text-[14px] font-medium text-on-surface-variant hover:text-on-surface" %>
          <button
            type="submit"
            class="bg-primary hover:bg-primary-hover text-white px-6 py-2.5 rounded-full font-medium text-[14px] transition-all flex items-center gap-2 shadow-sm"
          >
            <span class="material-symbols-outlined text-[18px]">check</span>
            Create Proposal
          </button>
        </div>

      <% end %>

      <%= render "shared/form_action_bar",
          discard_path: course_path(@course),
          form_id: "project-form",
          submit_label: "Create Proposal" %>
    </div>
  </main>
</div>
