<%# locals: (project:, course:, current_instance:) %>

<div class="flex gap-4 flex-wrap">
  <%# Group Name (if applicable) %>
  <% if project.owner.is_a?(ProjectGroup) %>
    <div class="bg-white/80 backdrop-blur-sm rounded-xl p-4 shadow-sm border border-white/50">
      <div class="flex items-center gap-3">
        <span class="text-gray-700 font-semibold text-sm flex items-center gap-2">
          <%= image_tag("group.svg", class: "w-4 h-4 object-contain opacity-70 shrink-0") %>
          Group Name
        </span>
        <span class="text-gray-900 break-words">
          <%= link_to participant_profile_course_path(course, project.owner.id, 'group'),
              class: "hover:text-gray-700 underline decoration-transparent transition-colors duration-300 ease-in-out hover:decoration-current" do %>
            <%= project.owner.group_name %>
          <% end %>
        </span>
      </div>
    </div>
  <% end %>

  <%# Type %>
  <div class="bg-white/80 backdrop-blur-sm rounded-xl p-4 shadow-sm border border-white/50">
    <div class="flex items-center gap-3">
      <span class="text-gray-700 font-semibold text-sm flex items-center gap-2">
        <%= image_tag("person.svg", class: "w-4 h-4 object-contain opacity-70 shrink-0") %>
        Type
      </span>
      <span class="text-gray-900">Project</span>
    </div>
  </div>

  <%# Owners %>
  <div class="bg-white/80 backdrop-blur-sm rounded-xl p-4 shadow-sm border border-white/50">
    <div class="flex items-center gap-3">
      <span class="text-gray-700 font-semibold text-sm flex items-center gap-2">
        <%= image_tag("person.svg", class: "w-4 h-4 object-contain opacity-70 shrink-0") %>
        Owners
      </span>
      <div class="flex items-center gap-2 text-gray-900 min-w-0">
        <% if project.owner.is_a?(User) %>
          <p class="flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-400 text-white text-xs font-bold uppercase shrink-0">
              <%= project.owner.name[0].upcase %>
            </span>
            <%= link_to participant_profile_course_path(course, project.owner.id, 'student'),
                class: "underline decoration-transparent transition-colors duration-300 ease-in-out hover:decoration-current hover:text-gray-700" do %>
              <%= project.owner.name %>
            <% end %>
          </p>
        <% else %>
          <% project.owner.users.each do |user| %>
            <p class="flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-400 text-white text-xs font-bold uppercase shrink-0">
                <%= user.name[0].upcase %>
              </span>
              <%= link_to participant_profile_course_path(course, user.id, 'student'),
                  class: "underline decoration-transparent transition-colors duration-300 ease-in-out hover:decoration-current hover:text-gray-900" do %>
                <%= user.name %>
              <% end %>
            </p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Supervisor %>
  <% unless @course.solo_supervisor? %>
    <div class="bg-white/80 backdrop-blur-sm rounded-xl p-4 shadow-sm border border-white/50">
      <div class="flex items-center gap-3">
        <span class="text-gray-700 font-semibold text-sm flex items-center gap-2">
          <%= image_tag("person.svg", class: "w-4 h-4 object-contain opacity-70 shrink-0") %>
          Supervisor
        </span>
        <span class="text-gray-900">
          <%= link_to course_lecturer_path(course, current_instance.supervisor),
              class: "underline decoration-transparent transition-colors duration-300 ease-in-out hover:decoration-current" do %>
            <%= current_instance.supervisor.name %>
          <% end %>
        </span>
      </div>
    </div>
  <% end %>
</div>
