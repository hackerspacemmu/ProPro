<% content_for :body_class, "bg-surface-tint" %>
<%# --- Breadcrumbs --- %>
<% breadcrumb :course, @course %>
<% breadcrumb :lecturer, @course, @lecturer %>

<% content_for :title,
  "#{@lecturer.name.truncate(TITLE_NAME_LIMIT)} - View Supervisor | ProPro" %>

<%
  # Access gates (reused verbatim from the pre-restyle page — CoursePolicy is
  # untouched). unrestricted_lecturer_access? (coordinator / self / any lecturer
  # while the course's "Lecturer views public?" lecturer_access is on) sees every
  # section; student_can_view_lecturer? (student, gated by student_access:
  # owner_only / own_lecturer_only / no_restriction) sees Topics only.
  unrestricted = policy(@course).unrestricted_lecturer_access?(@lecturer)
  student_view = policy(@course).student_can_view_lecturer?(@lecturer)

  if unrestricted
    topic_rows = @course.toggle_topics ?
      (@approved_topics + @pending_topics).sort_by(&:updated_at).reverse : []
    pending_rows = @incoming_proposals.select { |p| p.current_status == 'pending' }
    reviewed_rows = @incoming_proposals.select { |p| %w[redo rejected].include?(p.current_status) }
    any_sections = @my_student_projects.any? || topic_rows.any? || pending_rows.any? || reviewed_rows.any?
  elsif student_view
    topic_rows = @course.toggle_topics ? @approved_topics.sort_by(&:updated_at).reverse : []
    any_sections = topic_rows.any?
  end

  # Facts strip: capacity ~ People tab but bar-first — the w-24 bar starts flush
  # under the "Supervisor Capacity" label, then (n pending), approved/cap, and the
  # exceeding error icon at the end (so the bar is never shifted off the label).
  # Hidden for solo-supervisor courses (no capacity concept) and when the profile
  # is a coordinator-only enrolment (no capacity row).
  lecturer_capacity = @lecturer_capacity_info[@lecturer.id] unless @course.solo_supervisor?
  show_capacity = lecturer_capacity && !lecturer_capacity.excluded?

  empty_state_classes = "border-b border-outline-variant py-3 px-4 text-[14px] font-medium leading-5 tracking-normal text-on-surface-variant"
%>

<div class="flex">
  <%= render "shared/sidebar" %>
  <main class="flex-1 bg-white rounded-tl-panel overflow-x-hidden overflow-y-auto h-[calc(100vh-var(--spacing-header))]">

    <div class="w-[95%] max-w-5xl mx-auto pt-8 pb-16 flex flex-col min-h-full">
      <div class="space-y-12 flex-grow">

        <div>
          <span class="block mb-4 text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">View Supervisor</span>

          <%# Hero: banner band + overlapping avatar + identity + facts strip %>
          <section aria-labelledby="lecturer-name"
                   class="bg-surface-tint border border-outline-variant rounded-panel overflow-hidden shadow-none">
            <div class="h-24 sm:h-28 bg-primary-container-alt" aria-hidden="true"></div>

            <div class="px-6 sm:px-8 pb-8">
              <div class="-mt-12 flex flex-col gap-4 sm:flex-row sm:gap-6">
                <div class="w-24 h-24 bg-surface-variant-deep text-on-surface-strong border-4 border-surface-tint rounded-full flex items-center justify-center text-4xl font-bold shrink-0 shadow-none">
                  <%= @lecturer.name.first.upcase %>
                </div>

                <div class="min-w-0 flex-1 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6 sm:pt-14">
                  <div class="min-w-0">
                    <h1 id="lecturer-name" class="text-[28px] leading-9 sm:text-[36px] sm:leading-[44px] font-normal text-on-surface-strong tracking-tight font-['DM_Sans'] break-words"><%= @lecturer.name %></h1>
                    <div class="text-on-surface-variant text-[14px] mt-1 font-medium break-words">
                      <%= @lecturer.email_address %>
                    </div>
                  </div>
                </div>
              </div>

              <% if show_capacity %>
                <% ratio = lecturer_capacity.effective_cap.zero? ? 0 : lecturer_capacity.approved_count.to_f / lecturer_capacity.effective_cap %>
                <% color =
                     case
                     when ratio >= 1.0 then "var(--color-error)"
                     when ratio >= 0.7 then "var(--color-warning)"
                     else "var(--color-success)"
                     end %>
                <% exceeding = lecturer_capacity.effective_cap.positive? && lecturer_capacity.approved_count > lecturer_capacity.effective_cap %>
                <% pending_exceeds = lecturer_capacity.approved_count + lecturer_capacity.pending_count > lecturer_capacity.effective_cap %>
                <% fill_width = [[ratio * 100, 100].min, 0].max.round(2) %>

                <div class="mt-8 pt-6 border-t border-outline-variant">
                  <span class="block text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">Supervisor Capacity</span>
                  <div class="flex items-center gap-4 mt-3">
                    <div class="w-24 h-1.5 bg-surface-variant-deep rounded-full overflow-hidden flex shrink-0">
                      <div class="h-full rounded-full" style="width: <%= fill_width %>% ; background-color: <%= color %>"></div>
                    </div>

                    <span class="text-sm font-medium text-right shrink-0" style="color: <%= color %>">
                      <%= lecturer_capacity.approved_count %>/<%= lecturer_capacity.effective_cap %>
                    </span>

                    <% if lecturer_capacity.pending_count.positive? %>
                      <span class="text-xs font-normal <%= pending_exceeds ? "text-error" : "text-on-surface-variant" %>">
                        (<%= lecturer_capacity.pending_count %> pending)
                      </span>
                    <% end %>

                    <% if exceeding %>
                      <div class="flex items-center gap-1.5 text-error" title="Capacity exceeded">
                        <span class="material-symbols-outlined text-[18px]">error</span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        </div>

        <%# Profile Information: data as on the pre-restyle card (Role, Email,
            Description, Portfolio / MMU Directory), restyled to the profile
            section-heading idiom. Coordinator actions (Promote/Demote) stay. %>
        <section id="profile-information" aria-labelledby="profile-information-heading">
          <div class="flex items-center justify-between gap-4 pb-3 mb-5 border-b border-outline-variant">
            <h2 id="profile-information-heading" class="text-[22px] leading-7 font-normal text-on-surface-strong font-['DM_Sans']">Profile Information</h2>
            <% if @course.coordinators.include? Current.user %>
              <div class="shrink-0 text-[14px] font-medium">
                <% if policy(@course).demote_to_lecturer? %>
                  <%= link_to "Demote to Lecturer",
                      demote_to_lecturer_course_lecturer_path(@course, @lecturer),
                      data: { turbo_method: :patch },
                      class: "text-error hover:underline" %>
                <% elsif policy(@course).promote_to_coordinator? %>
                  <%= link_to "Promote To Coordinator",
                      promote_to_coordinator_course_lecturer_path(@course, @lecturer),
                      data: { turbo_method: :patch },
                      class: "text-success hover:underline" %>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="bg-surface border border-outline-variant rounded-card overflow-hidden shadow-none">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-8 gap-x-12 p-6 sm:p-8">
              <div>
                <span class="block text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">Role</span>
                <span class="mt-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium bg-surface-variant text-on-surface-strong">
                  <%= @enrolment&.role&.humanize || "Lecturer" %>
                </span>
              </div>
              <div class="min-w-0">
                <span class="block text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">Email</span>
                <a href="mailto:<%= @lecturer.email_address %>"
                   class="mt-2 block text-on-surface text-[14px] font-medium hover:text-primary hover:underline break-all">
                  <%= @lecturer.email_address %>
                </a>
              </div>
              <div>
                <span class="block text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">Description</span>
                <p class="mt-2 text-on-surface text-[14px] leading-relaxed whitespace-pre-line break-words">
                  <%= @lecturer.description.presence || "No description provided." %>
                </p>
              </div>
              <div class="min-w-0">
                <span class="block text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">Portfolio / MMU Directory</span>
                <% if @lecturer.web_link.present? %>
                  <a href="<%= @lecturer.web_link %>"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="mt-2 block text-primary text-[14px] font-medium hover:underline break-all">
                    <%= @lecturer.web_link %>
                  </a>
                <% else %>
                  <span class="mt-2 block text-on-surface-variant text-[14px] italic">No web link provided.</span>
                <% end %>
              </div>
            </div>
          </div>
        </section>

        <%# Collapsible sections (Overview idioms: _section_header + collapsible-sections,
            plain-sentence empty states, Collapse all / Expand all) %>
        <div data-controller="collapsible-sections">
          <% if any_sections %>
            <div class="flex justify-end mb-10">
              <button type="button" data-action="collapsible-sections#toggleAll" class="flex items-center gap-2 text-[14px] font-medium text-primary hover:bg-primary-container px-3 py-2 rounded-md transition-colors">
                <span data-collapsible-sections-target="toggleAllIcon" class="material-symbols-outlined text-[20px]">unfold_less</span>
                <span data-collapsible-sections-target="toggleAllLabel">Collapse all</span>
              </button>
            </div>
          <% end %>

          <% if unrestricted %>
            <%# Supervised Projects — approved projects this lecturer supervises %>
            <div class="mb-12" id="lecturer-supervised-projects">
              <%= render "courses/section_header", title: "Supervised Projects", count: @my_student_projects.size, section: "lecturer-supervised-projects" %>
              <% if @my_student_projects.any? %>
                <div class="flex flex-col border-b border-outline-variant w-full" data-collapsible-sections-target="body" data-collapsible-sections-section="lecturer-supervised-projects">
                  <% @my_student_projects.each do |proposal| %>
                    <%= render "projects/proposal_list_item",
                        proposal: proposal,
                        path: course_lecturer_project_path(@course, @lecturer, proposal),
                        linkable: policy(proposal).show? %>
                  <% end %>
                </div>
              <% else %>
                <div class="<%= empty_state_classes %>" data-collapsible-sections-target="body" data-collapsible-sections-section="lecturer-supervised-projects">
                  Approved projects supervised by this lecturer will appear here.
                </div>
              <% end %>
            </div>

            <%# Topics — one flat list (approved + draft interleaved, real status pill) %>
            <div class="mb-12" id="lecturer-topics">
              <%= render "courses/section_header", title: "Topics", count: topic_rows.size, section: "lecturer-topics" %>
              <% if topic_rows.any? %>
                <%= render "shared/row_list", rows: topic_rows, partial: "courses/topic_card", item: :topic, borderless_first: true,
                    locals: { course: @course, lecturer: @lecturer },
                    container_attrs: { data: { collapsible_sections_target: "body", collapsible_sections_section: "lecturer-topics" } } %>
              <% else %>
                <div class="<%= empty_state_classes %>" data-collapsible-sections-target="body" data-collapsible-sections-section="lecturer-topics">
                  Topics created by this lecturer will appear here.
                </div>
              <% end %>
            </div>

            <%# Pending Proposals — status pending (mirrors the Overview split) %>
            <div class="mb-12" id="lecturer-pending-proposals">
              <%= render "courses/section_header", title: "Pending Proposals", count: pending_rows.size, section: "lecturer-pending-proposals" %>
              <% if pending_rows.any? %>
                <div class="flex flex-col border-b border-outline-variant w-full" data-collapsible-sections-target="body" data-collapsible-sections-section="lecturer-pending-proposals">
                  <% pending_rows.each do |proposal| %>
                    <%= render "projects/proposal_list_item",
                        proposal: proposal,
                        path: course_lecturer_project_path(@course, @lecturer, proposal),
                        linkable: policy(proposal).show? %>
                  <% end %>
                </div>
              <% else %>
                <div class="<%= empty_state_classes %>" data-collapsible-sections-target="body" data-collapsible-sections-section="lecturer-pending-proposals">
                  Proposals that are pending review will appear here.
                </div>
              <% end %>
            </div>

            <%# Reviewed Proposals — redo + rejected (mirrors the Overview split) %>
            <div class="mb-12" id="lecturer-reviewed-proposals">
              <%= render "courses/section_header", title: "Reviewed Proposals", count: reviewed_rows.size, section: "lecturer-reviewed-proposals" %>
              <% if reviewed_rows.any? %>
                <div class="flex flex-col border-b border-outline-variant w-full" data-collapsible-sections-target="body" data-collapsible-sections-section="lecturer-reviewed-proposals">
                  <% reviewed_rows.each do |proposal| %>
                    <%= render "projects/proposal_list_item",
                        proposal: proposal,
                        path: course_lecturer_project_path(@course, @lecturer, proposal),
                        linkable: policy(proposal).show? %>
                  <% end %>
                </div>
              <% else %>
                <div class="<%= empty_state_classes %>" data-collapsible-sections-target="body" data-collapsible-sections-section="lecturer-reviewed-proposals">
                  Proposals that were returned or rejected will appear here.
                </div>
              <% end %>
            </div>

          <% elsif student_view %>
            <%# Topics only — approved topics, flat rows (the old student branch,
                re-titled from the mislabeled "Projects" heading) %>
            <div class="mb-12" id="lecturer-topics">
              <%= render "courses/section_header", title: "Topics", count: topic_rows.size, section: "lecturer-topics" %>
              <% if topic_rows.any? %>
                <%= render "shared/row_list", rows: topic_rows, partial: "courses/topic_card", item: :topic, borderless_first: true,
                    locals: { course: @course, lecturer: @lecturer },
                    container_attrs: { data: { collapsible_sections_target: "body", collapsible_sections_section: "lecturer-topics" } } %>
              <% else %>
                <div class="<%= empty_state_classes %>" data-collapsible-sections-target="body" data-collapsible-sections-section="lecturer-topics">
                  This lecturer has no available topics yet.
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Back to Course %>
        <footer class="mt-10 flex justify-start">
          <%= link_to course_path(@course), class: "group inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-outline text-on-surface-variant hover:bg-surface-variant hover:text-on-surface-strong text-[14px] font-medium transition-colors duration-150 no-underline" do %>
            <span class="material-symbols-outlined text-[18px] transition-transform group-hover:-translate-x-1">arrow_back</span>
            Back to Course
          <% end %>
        </footer>

      </div>
    </div>
  </main>
</div>