<%# app/views/landing/show.html.erb
    Intentional, self-contained landing page: markup and its <style> block stay in
    this one view on purpose (ADR 0021). No partials, no tokens, no i18n. The
    layout supplies <html>/<head>, the viewport meta and the Roboto font link. %>
<% content_for :title, "ProPro | Landing" %>
<% content_for :no_sidebar, true %>
<% content_for :no_header, true %>
<% content_for :no_footer, true %>
<%
  # Section icons are literal SVG constants (no user input), so .html_safe is safe.
  icons = {
    setup: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3.2"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>'.html_safe,
    propose: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1 2V16h5.2v-.2c0-.8.4-1.5 1-2A6 6 0 0 0 12 3z"/></svg>'.html_safe,
    review: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z"/><path d="m9 10 2 2 4-4"/></svg>'.html_safe
  }

  sections = [
    { id: "setup", title: "Setting up your course",
      intro: "ProPro works for a short essay with one lecturer and for a capstone project with several supervisors. You set what a proposal needs to contain and how groups form, and students work within that.",
      h3: ["Personalize it to ", "your requirements"],
      items: ["Create forms for any assignment", "Set the rules in one place", "Gain insight and visibility across groups"] },
    { id: "propose", title: "Let your students propose their ideas",
      intro: "Students can browse the topics lecturers have put forward, then build on one or propose their own. The form they fill in is the one you set up.",
      h3: ["Give students room to ", "define their own problems"],
      items: ["See which topics are still open", "Propose an idea or build on a topic"] },
    { id: "review", title: "Review and give feedback to ideas proposed to you",
      intro: "Every edit becomes a new version, so a proposal keeps its history. You can see what changed, comment on it, and then approve it, ask for revisions, or reject it.",
      h3: ["Clear insight into ", "every proposal"],
      items: ["Track changes to a proposal over time", "Compare any two versions", "Approve, request revisions or reject"] }
  ]

  # Real landing screenshots (app/assets/images/landing/*.png), keyed by item.
  screenshots = {
    "Create forms for any assignment" => "Project_templates.png",
    "Set the rules in one place" => "Course_settings.png",
    "Gain insight and visibility across groups" => "Groups.png",
    "See which topics are still open" => "Topics.png",
    "Propose an idea or build on a topic" => "Projects_New.png",
    "Track changes to a proposal over time" => "Projects_show.png",
    "Compare any two versions" => "Compare_Versions.png",
    "Approve, request revisions or reject" => "Projects actions.png"
  }

  # Item descriptions, keyed by item title.
  hints = {
    "Create forms for any assignment" => "Choose the fields students fill in, from a short title to a full project outline. Mark which ones are required, and let selected fields stay editable after approval.",
    "Set the rules in one place" => "Write the project brief, attach the guidelines, and set how groups form from a single settings page.",
    "Gain insight and visibility across groups" => "See every group with its members, project, status and supervisor in one table. Filter by supervisor or status to find what needs attention.",
    "See which topics are still open" => "Browse topics grouped by supervisor, with the ones still available marked clearly. Lecturers publish topics for students to build on.",
    "Propose an idea or build on a topic" => "Send a proposal straight to a lecturer or start from one of their topics. The form follows your template, and every edit is saved as a new version.",
    "Track changes to a proposal over time" => "Every edit creates a new version. Move between them to see how a proposal developed, with the status of each one shown.",
    "Compare any two versions" => "Place any two versions side by side. Added and removed text is highlighted, so there is no need to reread the whole proposal.",
    "Approve, request revisions or reject" => "Decide on a proposal, or send it back with comments on what to change. Feedback sits beside the proposal, so the reasoning and the decision stay together."
  }
%>

<div class="page-controller" data-controller="jump-bar lightbox">
<style>
/* Palette, type scale and spacing taken from Google Classroom's CSS overview. */
:root{
  --bg:#fff; --surface:#f8f9fa; --muted:#f1f3f4; --border:#dadce0;
  --text:#202124; --text2:#3c4043; --text3:#5f6368;
  --blue:#1a73e8; --blue-h:#1967d2; --blue-s:#e8f0fe;
  --green:#188038; --green-track:#ceead6;
  --green-50:#e6f4ea; --green-900:#0d652d;
  --header-height:70px;
  --shadow:0 1px 2px 0 rgba(60,64,67,.3),0 1px 3px 1px rgba(60,64,67,.15);
  --font:"Google Sans Flex","DM Sans",Roboto,Arial,Helvetica,sans-serif;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box}
/* Display-only wrapper carrying the page-level Stimulus controllers; it has no box of its own. */
.page-controller{display:contents}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + var(--header-height) + 24px)}
body{margin:0;background-color:var(--bg);background-image:radial-gradient(circle at 0% 0%, rgba(26, 115, 232, 0.08) 0%, transparent 50vw), radial-gradient(circle at 100% 0%, rgba(24, 128, 56, 0.06) 0%, transparent 50vw);background-repeat:no-repeat;color:var(--text);font-family:var(--font);font-size:16px;font-weight:400;line-height:24px}
/* Side gutters: 28px (mobile) and 40px (tablet) as on Classroom, then growing on desktop */
.wrap{max-width:1352px;margin:0 auto;padding:0 28px}
@media (min-width:600px){.wrap{padding:0 40px}}
@media (min-width:1024px){.wrap{padding:0 clamp(40px,5vw,72px)}}
/* hero. Vertical padding is set with longhands so it doesn't wipe the .wrap side gutters. */
.hero{text-align:center;padding-top:96px;padding-bottom:72px}
.logo{display:inline-flex;align-items:center;gap:10px;font-size:22px;line-height:28px;color:var(--text3);margin-bottom:28px}
.logo b{color:var(--text);font-weight:500}
.logo i{width:30px;height:26px;border-radius:4px;background:var(--green);display:inline-block}
h1{font-size:clamp(36px,6vw,60px);line-height:1.2;font-weight:600;letter-spacing:-.5px;margin:0 auto;max-width:900px}
.hero p{font-size:20px;font-weight:400;letter-spacing:normal;line-height:28px;color:var(--text);max-width:83.3333%;margin:16px auto 36px}
.btn{display:inline-block;text-align:center;font-family:inherit;font-size:16px;font-weight:500;line-height:24px;border:0;border-radius:999px;background:var(--blue);color:#fff;padding:12px 24px;min-height:44px;cursor:pointer;text-decoration:none;transition:background .2s ease}
.btn:hover{background:var(--blue-h)}
.btn.big{font-size:18px;padding:16px 36px}
a:focus-visible,button:focus-visible,.media:focus-visible{outline:2px solid var(--blue);outline-offset:3px}

/* jump links (section menu): Google's .gfe-jump-links wrapper/container rules, skinned as a floating rounded pill */
.jumpbar{position:sticky;top:calc(env(safe-area-inset-top,0px) + 12px);z-index:59;display:flex;justify-content:center;width:100%;padding:0 16px;margin-bottom:24px;pointer-events:none}
.jump-wrap{display:flex;justify-content:center;position:relative;margin-left:auto;margin-right:auto;width:100%;flex:0 0 100%;max-width:100%;pointer-events:none}
@media (min-width:600px){.jump-wrap{flex:0 0 91.6666666667%;max-width:91.6666666667%}}
.jump-wrap nav{pointer-events:auto;min-width:0;max-width:100%;background:var(--bg);border:1px solid var(--muted);border-radius:999px;box-shadow:var(--shadow);padding:6px}
.jump-list{display:flex;flex-wrap:nowrap;align-items:center;gap:4px;list-style:none;margin:0;padding:0;position:relative;overflow-x:auto;overflow-y:hidden;scroll-behavior:smooth;scrollbar-width:none;-ms-overflow-style:none}
.jump-list::-webkit-scrollbar{display:none}
.jump-list li{margin:0;padding:0;flex:0 0 auto}
/* 44px minimum touch target */
.jump-list a{display:flex;align-items:center;min-height:44px;padding:0 24px;border-radius:999px;color:var(--text3);text-decoration:none;font-size:14px;font-weight:500;line-height:20px;white-space:nowrap;transition:background .2s ease,color .2s ease}
.jump-list a:hover{background:var(--surface);color:var(--text)}
/* active pill uses the darker blue: #1a73e8 on #e8f0fe is only ~3.9:1, #1967d2 passes AA */
.jump-list a.on{background:var(--blue-s);color:var(--blue-h)}

/* sections */
section.feat{padding:72px 0 48px}
.sec-head{text-align:center;max-width:820px;margin:0 auto 56px}
.sec-head svg{display:block;width:32px;height:32px;color:var(--green);margin:0 auto 20px}
h2{font-size:clamp(28px,4vw,40px);line-height:1.2;font-weight:600;letter-spacing:-.5px;margin:0}
.sec-head p{margin:16px 0 0;color:var(--text2);font-size:16px;font-weight:400;letter-spacing:.1px;line-height:24px}
/* Media alternates sides like Classroom: right, left, right (see the min-width:961px block below).
   The media column is a share of the width (capped at 616px) so the text panel is never squeezed on small laptops. */
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,clamp(320px,52%,616px));gap:clamp(40px,5vw,72px);align-items:center}
/* 16:10 matches the screenshots. Clickable: opens the enlarged view. */
.media{position:relative;aspect-ratio:16/10;background:var(--muted);border:1px solid var(--border);border-radius:12px;overflow:hidden;cursor:zoom-in;touch-action:pan-y}
.media .media-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top}
/* .media is a <button>: clear only the default button chrome UA adds (the .media rule above keeps its own background and border) */
.media{padding:0;color:inherit;text-align:left}
.zoom-hint{position:absolute;right:12px;bottom:12px;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:rgba(32,33,36,.72);color:#fff;font-size:13px;font-weight:500;line-height:20px;pointer-events:none;transition:opacity .2s ease}
@media (hover:hover){
  .zoom-hint{opacity:0}
  .media:hover .zoom-hint,.media:focus-visible .zoom-hint{opacity:1}
}
.panel h3{font-size:28px;font-weight:400;line-height:36px;margin:0 0 32px}
.panel h3 em{font-style:normal;color:var(--green)}
/* min-height keeps each item a 44px touch target */
.item{position:relative;padding:10px 0 10px 32px;min-height:44px;margin-bottom:24px;cursor:pointer;text-align:left;background:none;border:0;display:block;width:100%;font-family:inherit;color:var(--text)}
.item::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;border-radius:2px;background:var(--border)}
.item .fill{position:absolute;left:0;top:0;width:4px;border-radius:2px;background:var(--green);height:0}
.item .t{font-size:20px;font-weight:400;line-height:24px;display:block}
.item .body{display:none;margin-top:12px}
.item.open .body{display:block}
.item.open::before{background:var(--green-track)}
.item .hint{color:var(--text2);font-size:16px;font-weight:400;letter-spacing:.1px;line-height:24px;display:block}

/* data pill stat (Google's .gfe-data-pill style). Google's rem values assume an 18px root, so they are converted to px here. */
.stat{padding-top:72px;text-align:center}
.stat-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:16px 28px}
.stat-pill{display:inline-block;border-radius:1000px;background:var(--green-50);color:var(--green-900);font-size:clamp(72px,19vw,108px);font-weight:600;line-height:normal;letter-spacing:-1px;padding:0 28px;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}
.stat-label{margin:0;color:var(--text);font-size:28px;font-weight:400;line-height:40px;letter-spacing:normal;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}
@media (min-width:600px){
  .stat-pill{font-size:clamp(108px,12vw,153px);line-height:1.12;padding:0 44px}
  .stat-label{font-size:40px;line-height:48px}
}

.foot{text-align:center;padding:72px 28px 120px}
.foot p{max-width:560px;margin:16px auto 28px;color:var(--text2);font-size:16px;font-weight:400;letter-spacing:.1px;line-height:24px}

/* enlarged screenshot view (native <dialog>: [open] is its on state, no class toggling) */
.lightbox{position:fixed;inset:0;z-index:100;margin:auto;padding:0;border:0;width:100%;max-width:none;height:100%;max-height:none;background:rgba(32,33,36,.92);color:#fff}
.lb-scroll{width:100%;height:100%;overflow:auto;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y pinch-zoom;padding:calc(env(safe-area-inset-top,0px) + 64px) 0 calc(env(safe-area-inset-bottom,0px) + 24px)}
/* On phones the image is shown wider than the screen so the text is readable; people pan sideways or pinch-zoom. */
.lb-scroll img{display:block;width:max(100%,860px);max-width:none;height:auto;background:#fff}
.lb-close{position:fixed;top:calc(env(safe-area-inset-top,0px) + 12px);right:12px;z-index:101;display:flex;align-items:center;justify-content:center;width:44px;height:44px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.16);color:#fff;cursor:pointer;transition:background .2s ease}
.lb-close:hover{background:rgba(255,255,255,.28)}
.lb-close:focus-visible{outline-color:#fff}

/* desktop and large tablet: alternate media sides */
@media (min-width:961px){
  .media{order:2}
  section.feat:nth-of-type(even) .split{grid-template-columns:minmax(0,clamp(320px,52%,616px)) minmax(0,1fr)}
  section.feat:nth-of-type(even) .media{order:0}
  section.feat:nth-of-type(even) .panel{order:1}
  .lb-scroll img{width:min(100%,1400px);margin:0 auto}
}
/* tablet and below: stack, and show the whole screenshot instead of cropping it */
@media (max-width:960px){
  .split{grid-template-columns:minmax(0,1fr);gap:32px}
  .hero{padding-top:64px;padding-bottom:48px}
  .btn.big{padding:14px 32px}
  .panel h3{font-size:24px;line-height:32px}
  .media .media-img{object-fit:contain;background:#fff}
}
/* phones: tighter vertical rhythm */
@media (max-width:599px){
  .hero{padding-top:48px;padding-bottom:32px}
  .logo{margin-bottom:20px}
  section.feat{padding:48px 0 32px}
  .sec-head{margin-bottom:36px}
  .stat{padding-top:48px}
  .foot{padding-top:48px;padding-bottom:80px}
}
/* small phones: compact menu pill, full-width sign-up buttons */
@media (max-width:479px){
  .jump-list{gap:2px}
  .jump-list a{padding:0 16px}
  .btn.big{display:block;width:100%;max-width:360px;margin-left:auto;margin-right:auto}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.jump-list{scroll-behavior:auto}*{transition:none!important}}
</style>

<header class="hero wrap">
  <div class="logo"><span><b>ProPro</b></span></div>
  <h1>Fostering ideas through project-based learning</h1>
  <p>ProPro helps educators streamline academic ideas and proposal project management. The app empowers educators to enhance their impact on students through project-based learning.</p>
  <%= link_to "Log in to ProPro", login_path, class: "btn big" %>
</header>

<div class="jumpbar">
  <div class="jump-wrap">
    <nav aria-label="Sections">
      <ul class="jump-list" data-jump-bar-target="list">
        <% sections.each_with_index do |sec, i| %>
          <li><%= link_to sec[:id], "##{sec[:id]}", class: ("on" if i.zero?), data: { jump_bar_target: "link" } %></li>
        <% end %>
      </ul>
    </nav>
  </div>
</div>

<main class="wrap">
  <% sections.each do |sec| %>
    <section class="feat" id="<%= sec[:id] %>" data-controller="landing" data-landing-interval-value="7000">
      <div class="sec-head">
        <%= icons[sec[:id].to_sym] %>
        <h2><%= sec[:title] %></h2>
        <p><%= sec[:intro] %></p>
      </div>
      <div class="split">
        <button class="media" type="button" data-landing-target="media" data-lightbox-target="trigger" aria-label="Enlarge screenshot: <%= sec[:items].first %>">
          <%= image_tag "landing/#{screenshots[sec[:items].first]}", alt: sec[:items].first, class: "media-img", data: { landing_target: "image" } %>
          <span class="zoom-hint" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/></svg>
            Enlarge
          </span>
        </button>
        <div class="panel" data-landing-target="panel">
          <h3><%= sec[:h3][0] %><em><%= sec[:h3][1] %></em></h3>
          <% sec[:items].each_with_index do |item, i| %>
            <button class="item<%= " open" if i.zero? %>" type="button" data-landing-target="item" data-img="<%= image_path("landing/#{screenshots[item]}") %>" aria-expanded="<%= i.zero? %>">
              <span class="fill" data-landing-target="fill"></span>
              <span class="t"><%= item %></span>
              <span class="body">
                <span class="hint"><%= hints[item] %></span>
              </span>
            </button>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</main>

<div class="stat wrap">
  <div class="stat-row">
    <!-- User count, last reviewed Oct 2026. -->
    <span class="stat-pill">1000+</span>
    <p class="stat-label">users</p>
  </div>
</div>

<div class="foot">
  <h2>Ready to get started?</h2>
  <p>Create an account and see how ProPro fits into your project proposal workflow.</p>
  <%= link_to "Log in to ProPro", login_path, class: "btn big" %>
</div>

<dialog class="lightbox" id="lightbox" data-controller="lightbox" aria-label="Enlarged screenshot">
  <button class="lb-close" type="button" data-action="lightbox#close" aria-label="Close enlarged screenshot">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <div class="lb-scroll" data-action="click->lightbox#backdrop"><img alt="" data-lightbox-target="image"></div>
</dialog>
</div>
