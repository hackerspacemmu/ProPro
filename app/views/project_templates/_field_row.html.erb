<% is_title = field_form.object.is_project_title? %>
<tr
  class="
    field-row group bg-white transition-colors
    hover:bg-surface-hover/60 select-none
    <%= "sortable-disabled" if is_title %>
  "
  data-controller="project-template-fields"
  data-is-project-title="<%= is_title %>"
>
  <%= field_form.hidden_field :position, class: "position-input" %>

  <%# --- Label --- %>
  <td class="table-cell pl-16 pr-6 py-5 align-top">
    <div class="relative">
      <div class="flex items-center justify-end absolute -left-12 top-1/2 -translate-y-1/2 w-11 h-8">

        <%# --- Drag Handle --- %>
        <% if is_title %>
          <div class="drag-handle flex items-center justify-center p-1 flex-shrink-0 opacity-40 cursor-not-allowed pointer-events-none text-on-surface-disabled" title="Project Title cannot be reordered" oncontextmenu="return false;">
            <span class="material-symbols-outlined text-[18px]">drag_indicator</span>
          </div>
        <% else %>
          <div class="drag-handle flex items-center justify-center p-1 flex-shrink-0 opacity-0 group-hover:opacity-100 pointer-coarse:opacity-100 transition-opacity cursor-grab active:cursor-grabbing pointer-coarse:touch-pan-y text-on-surface-muted hover:text-primary" title="Drag to reorder" oncontextmenu="return false;">
            <span class="material-symbols-outlined text-[18px]">drag_indicator</span>
          </div>
        <% end %>

        <%# --- Delete Button --- %>
        <button
          type="button"
          class="remove-field flex items-center justify-center w-8 h-8 rounded-md transition-all flex-shrink-0 <%= is_title ? "opacity-40 cursor-not-allowed text-on-surface-disabled" : "text-on-surface-muted opacity-60 hover:opacity-100 hover:bg-error-container hover:text-error" %>"
          title="<%= is_title ? "Cannot remove title" : "Remove Field" %>"
          data-action="click->project-template-fields#remove"
          <%= "disabled" if is_title %>
        >
          <svg class="h-5 w-5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      </div>

      <%= field_form.text_area :label,
                           rows: 1,
                           placeholder: "e.g. Project Title",
                           class:
                             "block w-full px-3 py-2.5 border border-outline rounded-lg focus:ring-1 focus:ring-primary focus:border-primary text-[13.5px] resize-none overflow-y-auto max-[640px]:text-[16px] [field-sizing:content]",
                           data: {
                             controller: "textarea-resize",
                             action: "input->textarea-resize#resize",
                           } %>
    </div>
  </td>

  <%# --- Description --- %>
  <td class="table-cell px-6 py-5 align-top">
    <%= field_form.text_area :hint,
                         rows: 1,
                         placeholder: "Instructions…",
                         class:
                           "block w-full px-3 py-2.5 border border-outline rounded-lg focus:ring-1 focus:ring-primary focus:border-primary text-[13.5px] text-on-surface-variant resize-none overflow-y-auto max-[640px]:text-[16px] [field-sizing:content]",
                         data: {
                           controller: "textarea-resize",
                           action: "input->textarea-resize#resize",
                         } %>
  </td>

  <%# --- Type --- %>
  <td class="table-cell px-6 py-5 align-top">
    <div class="relative">
      <%= field_form.select :field_type,
                        options_for_select(
                          ProjectTemplateField.field_types.keys.map do |k|
                            [ProjectTemplateField::FIELD_TYPE_LABELS[k], k]
                          end,
                          field_form.object.field_type,
                        ),
                        {},
                        {
                          disabled: is_title,
                          class:
                            "field-type-select block w-full py-2.5 pl-3 pr-7 border border-outline rounded-lg text-[13.5px] cursor-pointer appearance-none focus:ring-1 focus:ring-primary focus:border-primary max-[640px]:text-[16px] #{'disabled:bg-surface-tint disabled:text-on-surface-disabled disabled:cursor-not-allowed' if is_title}",
                          data: {
                            action: "change->project-template-fields#toggleOptions",
                          },
                        } %>
      <%# Disabled selects are not submitted; the title's type must still reach
          the server or reject_incomplete_field discards the whole nested update. %>
      <%= field_form.hidden_field :field_type, value: field_form.object.field_type, id: nil if is_title %>
      <span class="chevron material-symbols-outlined text-[18px] <%= is_title ? 'text-on-surface-disabled' : 'text-on-surface-variant' %> pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">expand_more</span>
    </div>
  </td>

  <%# --- Applicable To --- %>
  <td class="table-cell px-6 py-5 align-top">
    <div class="relative">
      <%= field_form.select :applicable_to,
                        options_for_select(
                          ProjectTemplateField.applicable_tos.keys.map do |k|
                            [k.humanize, k]
                          end,
                          field_form.object.applicable_to || "topics",
                        ),
                        {},
                        class:
                          "block w-full py-2.5 pl-3 pr-7 border border-outline rounded-lg text-[13.5px] cursor-pointer appearance-none focus:ring-1 focus:ring-primary focus:border-primary max-[640px]:text-[16px]" %>
      <span class="chevron material-symbols-outlined text-[18px] text-on-surface-variant pointer-events-none absolute right-2 top-1/2 -translate-y-1/2">expand_more</span>
    </div>
  </td>

  <%# --- Options --- %>
  <td class="table-cell px-6 py-5 align-top" data-project-template-fields-target="optionsContainer">
    <%= render "option_section", field_form: field_form %>
    <%= field_form.hidden_field :_destroy, class: "destroy-flag" %>
  </td>

  <%# --- Required --- %>
  <td class="table-cell px-6 py-5 whitespace-nowrap align-top">
    <div class="flex items-center h-10">
      <%= field_form.check_box :required,
          class: "h-5 w-5 rounded border-outline accent-primary cursor-pointer" %>
    </div>
  </td>

  <%# --- Free Edit --- %>
  <td class="table-cell px-6 py-5 whitespace-nowrap align-top">
    <div class="flex items-center h-10" title="Allow editing after approval">
      <%= field_form.check_box :free_edit,
          class: "h-5 w-5 rounded border-outline accent-success cursor-pointer" %>
    </div>
  </td>
</tr>
