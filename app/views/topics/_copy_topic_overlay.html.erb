<div
  data-controller="field-expand-modal copy-topic"
  data-copy-topic-target-course-id-value="<%= @course.id %>"
  class="relative"
>
  <div class="flex justify-end">
    <button
      type="button"
      data-action="click->copy-topic#open"
      class="px-4 py-2 bg-surface-variant hover:bg-surface-variant-hover text-on-surface text-sm font-medium rounded-full shadow-sm transition-colors"
    >
      Reuse details from another topic
    </button>
  </div>

  <dialog
    data-field-expand-modal-target="dialog"
    data-copy-topic-target="dialog"
    class="w-full max-w-4xl max-h-[85dvh] m-auto p-0 rounded-xl border border-outline-variant shadow-xl bg-white backdrop:bg-black/40"
  >
    <%= turbo_frame_tag "overlay_content",
      class: "flex flex-col h-full",
      data: { copy_topic_target: "container" } do %>

      <div class="flex flex-col h-full max-h-[85dvh]">

        <!-- Sticky Header -->
        <div class="flex-none px-6 py-5 border-b border-outline-variant flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white/95 backdrop-blur z-10 sticky top-0 rounded-t-xl">
          <h3 class="text-lg font-semibold text-on-surface-strong tracking-tight font-['DM_Sans',Roboto,Arial,sans-serif]">
            Select a Topic to Copy
          </h3>

          <div class="flex items-center gap-3">
            <span class="text-[13px] font-medium text-on-surface-variant">Show all topics from coordinated courses</span>

            <%= form_with url: new_course_topic_path(@course), method: :get, data: { turbo_frame: "overlay_content" } do |f| %>
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  name="show_all_course_topics"
                  value="true"
                  class="sr-only peer"
                  <%= 'checked' if params[:show_all_course_topics] == "true" %>
                  onchange="this.form.requestSubmit()"
                >
                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-success"></div>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Scrollable List -->
        <div class="flex-grow min-h-0 overflow-y-auto">
          <% if @approved_topics.present? %>
            <div class="flex flex-col">
              <% @approved_topics.each_with_index do |topic, idx| %>
                <%= render "topics/copy_topic_list_item", topic: topic, border_top: !idx.zero? %>
              <% end %>
            </div>
          <% else %>
            <div class="col-span-1 w-full flex items-center gap-3 p-6 bg-white rounded-xl border border-outline-variant shadow-sm">
              <%= image_tag "info.svg", class: "w-6 h-6" %>
              <h5 class="text-sm text-on-surface-variant font-medium m-0">
                You don't have any approved topics yet.
              </h5>
            </div>
          <% end %>
        </div>

        <!-- Sticky Footer -->
        <div class="flex-none px-6 py-4 border-t border-outline-variant bg-surface-hover flex justify-end sticky bottom-0 rounded-b-xl z-10">
          <button
            type="button"
            data-action="click->field-expand-modal#close"
            class="px-5 py-2 text-on-surface-variant hover:bg-surface-variant-deep hover:text-on-surface-strong text-sm font-medium rounded-full transition-colors"
          >
            Cancel
          </button>
        </div>

      </div>
    <% end %>
  </dialog>
</div>
