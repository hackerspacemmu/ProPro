<div
  data-controller="field-expand-modal copy-topic"
  data-copy-topic-target-course-id-value="<%= @course.id %>"
  class="relative"
>
  <div class="flex justify-end">
    <button
      type="button"
      data-action="click->copy-topic#open"
      class="px-4 py-2 bg-[#F1F3F4] hover:bg-[#E8EAED] text-[#3C4043] text-sm font-medium rounded-full shadow-sm transition-colors"
    >
      Reuse details from another topic
    </button>
  </div>

  <dialog
    data-field-expand-modal-target="dialog"
    data-copy-topic-target="dialog"
    class="w-full max-w-3xl max-h-[85vh] m-auto p-0 rounded-xl border border-[#E0E0E0] shadow-lg bg-white backdrop:bg-black/40"
  >
    <%= turbo_frame_tag "overlay_content",
      class: "flex flex-col h-full p-6 md:p-8 overflow-y-auto",
      data: { copy_topic_target: "container" } do %>

      <div class="flex-none flex items-center justify-between border-b border-[#E0E0E0] pb-4 mb-4">
        <h3 class="text-[16px] font-semibold text-[#1f1f1f] tracking-tight font-['Google_Sans',sans-serif]">
          Select a Topic to Copy
        </h3>

        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-[#5F6368]">Show all topics from coordinated courses</span>

          <%= form_with url: new_course_topic_path(@course), method: :get, data: { turbo_frame: "overlay_content" } do |f| %>
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                name="show_all_course_topics"
                value="true"
                class="sr-only peer"
                <%= 'checked' if params[:show_all_course_topics] == "true" %>
                onchange="this.form.requestSubmit()"
              >
              <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-green-600"></div>
            </label>
          <% end %>
        </div>
      </div>

      <div class="flex-grow">
        <% if @approved_topics.present? %>
          <div class="flex flex-col border-b border-[#E0E0E0]">
            <% @approved_topics.each do |topic| %>
              <% topic_instance = topic.topic_instances.order(:version).last %>

              <%= render "shared/row_item",
                  path: new_course_topic_path(@course, source_topic_id: topic.id),
                  icon: "topic",
                  title: topic_instance.title.presence || "Untitled Topic",
                  meta_parts: [topic.owner_name],
                  time_meta: "Updated #{time_ago_in_words(topic.updated_at)} ago",
                  status: "approved",
                  link_options: {
                    data: {
                      copy_topic_target: "card",
                      action: "click->copy-topic#selectTopic",
                      copy_topic_course_id_param: topic.id
                    }
                  } do %>
                <div class="mt-2 flex items-center justify-between gap-4">
                  <span class="text-[10px] uppercase tracking-widest font-bold text-[#5F6368] whitespace-nowrap">Course</span>
                  <span class="text-[11px] font-semibold text-[#137333] bg-[#E6F4EA] px-2.5 py-1 rounded-md truncate">
                    <%= topic.course.course_name %>
                  </span>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="col-span-1 w-full flex items-center gap-3 p-6 bg-white rounded-xl border border-[#E0E0E0] shadow-sm">
            <%= image_tag "info.svg", class: "w-6 h-6" %>
            <h5 class="text-sm text-[#5F6368] font-medium m-0">
              You don't have any approved topics yet.
            </h5>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex justify-end">
        <button
          type="button"
          data-action="click->field-expand-modal#close"
          class="text-[#C5221F] hover:text-[#A50E0E] text-sm font-medium"
        >
          Cancel
        </button>
      </div>
    <% end %>
  </dialog>
</div>
