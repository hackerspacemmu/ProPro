<%# locals: (base_fields:, target_fields:, source_topic:) %>
<%# The source-vs-version-1 comparison for a copied topic, rendered on the
    Compare Versions tab. Same pill + diffy-grid treatment as the version diff:
    left pill = the source topic, right = Version 1 (Latest). Pairs each target
    field with the source field it was copied from (source_field_id), so the
    left column shows the source's value and the right shows the copy's. %>

<% source_title = source_topic.current_title.to_s.truncate(40) %>

<div class="flex justify-center mb-8">
  <div class="inline-flex items-center gap-4 max-w-full">

    <div class="bg-warning-container text-warning rounded-full px-4 py-1.5 flex items-center gap-2 transition-colors cursor-pointer border border-transparent hover:border-warning/30 min-w-0">
      <div class="w-1.5 h-1.5 rounded-full bg-warning shrink-0"></div>
      <span class="text-sm font-medium truncate"><%= source_title %></span>
    </div>

    <div class="text-on-surface-variant flex items-center justify-center shrink-0">
      <span class="material-symbols-outlined text-[20px]">sync_alt</span>
    </div>

    <div class="bg-success-container text-success rounded-full px-4 py-1.5 flex items-center gap-2 transition-colors cursor-pointer border border-transparent hover:border-success/30 shrink-0">
      <div class="w-1.5 h-1.5 rounded-full bg-success"></div>
      <span class="text-sm font-medium">Version 1 (Latest)</span>
    </div>

  </div>
</div>

<% sorted_target_fields = target_fields.to_a.sort_by { |f| f.project_template_field&.position || 0 } %>
<% pairs = sorted_target_fields.map do |next_field|
  [base_fields.find { |f| f.id == next_field.source_field_id }, next_field]
end %>

<%= render "diff_grid",
pairs: pairs,
empty_detail: "The copy matches its source topic." %>
