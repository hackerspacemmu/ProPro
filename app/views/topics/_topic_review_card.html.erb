<%# locals: (topic:, course:, current_version:, latest_version:, instances:, members:) %>

<div class="hidden min-[1245px]:flex flex-col gap-5 shrink-0 bg-surface border border-outline-variant rounded-[8px] p-5">

  <div class="flex items-center justify-between">
    <h2 style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="text-[16px] font-medium text-on-surface-strong">Review Topic</h2>
    <span class="text-[11px] font-medium text-success bg-success-container px-2 py-0.5 rounded-[4px]">Active</span>
  </div>

  <%= render "review_actions",
  topic: topic,
  course: course,
  current_version: current_version,
  latest_version: latest_version,
  instances: instances,
  members: members %>
</div>
