<%# Topics tab page (route-per-tab, ADR 0019). Renders the disabled empty
    state (via _topic_directory_tab) when the course's toggle_topics is off. %>
<%= render "courses/tab_shell",
           course: @course,
           active: "topics",
           current_user_enrolment: @current_user_enrolment do %>
  <%= render "courses/topic_directory_tab" %>
<% end %>
