<% content_for :title do %>
  <%= @project.current_title.truncate(TITLE_NAME_LIMIT) %>
  - Compare Versions | ProPro
<% end %>

<%= render layout: "projects/tab_shell",
           locals: {
             project: @project,
             course: @course,
             active: "compare",
             current_instance: @current_instance,
             current_version: @current_version,
             latest_version: @latest_version,
             instances: @instances,
             members: @members,
             comments: @comments,
             new_comment: @new_comment,
             comments_count: @comments.size
           } do %>

  <%= render "projects/compare_versions_tab",
             fields: @compare_fields,
             next_fields: @compare_next_fields,
             index: @compare_index,
             instances: @instances %>

<% end %>
