<div class="bg-white rounded-[28px] p-6 w-fit mb-10">
  <%= form_with url: invite_path, method: :post do |form| %>
    <%= form.label :coursecode,
      'Join a course',
      class: "block text-xs font-medium text-on-surface-variant uppercase tracking-wide mb-2" %>
    <div class="flex items-center gap-3">
      <%= form.text_field :coursecode,
        required: true,
        placeholder: "Code",
        class: "w-[10em] font-mono px-3.5 py-2.5 border border-outline rounded-[6px] text-[14px] text-on-surface placeholder-on-surface-disabled focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" %>
      <button
        type="submit"
        class="bg-primary hover:bg-primary-hover hover:shadow-md text-white px-6 py-2.5 rounded-full font-medium text-[14px] transition-all">
        Join
      </button>
    </div>
  <% end %>
</div>
