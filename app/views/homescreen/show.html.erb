                <div class="relative flex items-center w-full md:w-[240px]">
                  <span class="material-symbols-outlined absolute left-3 text-gray-400 text-[18px]">search</span>
                  <input type="text" placeholder="Search..." class="bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md focus:bg-white focus:ring-2 focus:ring-[#1A73E8] focus:border-transparent block w-full pl-9 pr-4 py-2 transition-all outline-none">
                </div>

                <select class="bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md focus:bg-white focus:ring-2 focus:ring-[#1A73E8] block w-full md:w-auto px-4 py-2 transition-all cursor-pointer outline-none">
                  <option value="all">All Statuses</option>
                  <option value="approved">Approved</option>
                  <option value="pending">Pending</option>
                </select>

                <button class="inline-flex items-center justify-center p-2 rounded-full hover:bg-gray-100 text-gray-500 hover:text-[#1A73E8] transition-colors shrink-0" title="Add Group">
