                    <th class="w-[30%] px-4 py-3 text-left text-xs font-medium text-[#5F6368] border-b border-gray-200 uppercase tracking-wider">Members</th>
                    <th class="w-[30%] px-4 py-3 text-left text-xs font-medium text-[#5F6368] border-b border-gray-200 uppercase tracking-wider">Project Title</th>
                    <th class="w-[15%] px-4 py-3 text-left text-xs font-medium text-[#5F6368] border-b border-gray-200 uppercase tracking-wider">Status</th>
                    <th class="w-[15%] px-4 py-3 text-left text-xs font-medium text-[#5F6368] border-b border-gray-200 uppercase tracking-wider">Supervisor</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  
                  <!-- ========================================== -->
                  <!-- GROUP 01 -->
                  <!-- ========================================== -->
