                    <td class="w-[10%] px-4 py-4 text-sm font-medium text-gray-900 align-middle">03</td>
                    <td class="w-[30%] px-4 py-4 align-middle">
                      <div class="flex items-center gap-3">
                        <div class="flex -space-x-1.5">
                          <div class="w-7 h-7 rounded-full bg-gray-200 border-2 border-white flex items-center justify-center text-[11px] font-medium text-gray-700 z-30">S</div>
                          <div class="w-7 h-7 rounded-full bg-gray-200 border-2 border-white flex items-center justify-center text-[11px] font-medium text-gray-700 z-20">N</div>
                          <div class="w-7 h-7 rounded-full bg-gray-200 border-2 border-white flex items-center justify-center text-[11px] font-medium text-gray-700 z-10">T</div>
                        </div>
                        <span class="text-sm text-gray-500">3 members</span>
                      </div>
                    </td>
                    <td class="w-[30%] px-4 py-4 text-sm align-middle pr-4">
                      <a href="#" class="text-[#1A73E8] hover:underline truncate block w-full">Test Create Proposal for ...</a>
                    </td>
                    <td class="w-[15%] px-4 py-4 align-middle">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium bg-[#E6F4EA] text-[#137333]">
                        Approved
                      </span>
                    </td>
                    <td class="w-[15%] px-4 py-4 text-sm text-gray-600 align-middle">
                      <div class="flex items-center justify-between">
                        <span>Test Lecturer 1</span>
                        <span id="icon-group-03" class="material-symbols-outlined text-gray-400 transition-transform duration-200">expand_more</span>
                      </div>
                    </td>
                  </tr>
                  <!-- Detail Row -->
                  <tr id="detail-group-03" class="hidden bg-gray-50/30">
                    <td colspan="5" class="px-4 py-4 border-t border-gray-100">
                      <div class="pl-[10%]"> 
                        <div class="flex flex-col gap-4">
                          <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-[11px] font-medium text-gray-700 shrink-0">S</div>
                            <span class="text-sm text-gray-700">SOO SHI JIAN</span>
                          </div>
                          <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-[11px] font-medium text-gray-700 shrink-0">N</div>
                            <span class="text-sm text-gray-700">NIILESH A/L SARAVANA KUMAR</span>
                          </div>
                          <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-[11px] font-medium text-gray-700 shrink-0">T</div>
                            <span class="text-sm text-gray-700">Test Student 2</span>
                            <span class="bg-[#FEF7E0] text-[#E37400] text-[10px] px-1.5 py-0.5 rounded font-medium">Pending</span>
                            <button class="text-gray-400 hover:text-gray-700 transition-colors"><span class="material-symbols-outlined text-[16px]">mail</span></button>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>

                  <!-- ========================================== -->
                  <!-- GROUP 04 -->
                  <!-- ========================================== -->
                  <tr class="hover:bg-gray-50 transition-colors cursor-pointer group" onclick="toggleRow('group-04')">
                    <td class="w-[10%] px-4 py-4 text-sm font-medium text-gray-900 align-middle">04</td>
                    <td class="w-[30%] px-4 py-4 align-middle">
                      <div class="flex items-center gap-3">
                        <div class="flex -space-x-1.5">
                          <div class="w-7 h-7 rounded-full bg-gray-200 border-2 border-white flex items-center justify-center text-[11px] font-medium text-gray-700 z-20">C</div>
                          <div class="w-7 h-7 rounded-full bg-gray-200 border-2 border-white flex items-center justify-center text-[11px] font-medium text-gray-700 z-10">C</div>
                        </div>
                        <span class="text-sm text-gray-500">2 members</span>
                      </div>
                    </td>
                    <td class="w-[30%] px-4 py-4 text-sm align-middle pr-4">
                      <a href="#" class="text-[#1A73E8] hover:underline truncate block w-full">IIIIIIIIIIIII</a>
                    </td>
                    <td class="w-[15%] px-4 py-4 align-middle">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium bg-[#E6F4EA] text-[#137333]">
                        Approved
                      </span>
                    </td>
                    <td class="w-[15%] px-4 py-4 text-sm text-gray-600 align-middle">
                      <div class="flex items-center justify-between">
                        <span>Test Lecturer 1</span>
                        <span id="icon-group-04" class="material-symbols-outlined text-gray-400 transition-transform duration-200">expand_more</span>
                      </div>
                    </td>
                  </tr>
                  <!-- Detail Row -->
                  <tr id="detail-group-04" class="hidden bg-gray-50/30">
                    <td colspan="5" class="px-4 py-4 border-t border-gray-100">
                      <div class="pl-[10%]"> 
                        <div class="flex flex-col gap-4">
                          <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-[11px] font-medium text-gray-700 shrink-0">C</div>
                            <span class="text-sm text-gray-700">CHIAM JUIN HOONG</span>
                            <span class="bg-[#FEF7E0] text-[#E37400] text-[10px] px-1.5 py-0.5 rounded font-medium">Pending</span>
                            <button class="text-gray-400 hover:text-gray-700 transition-colors"><span class="material-symbols-outlined text-[16px]">mail</span></button>
                          </div>
                          <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-[11px] font-medium text-gray-700 shrink-0">C</div>
                            <span class="text-sm text-gray-700">CHONG SENG KIAT</span>
                            <span class="bg-[#FEF7E0] text-[#E37400] text-[10px] px-1.5 py-0.5 rounded font-medium">Pending</span>
                            <button class="text-gray-400 hover:text-gray-700 transition-colors"><span class="material-symbols-outlined text-[16px]">mail</span></button>
                          </div>
                        </div>
