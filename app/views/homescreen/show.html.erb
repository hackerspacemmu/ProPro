                  <button class="p-1.5 text-gray-400 hover:bg-gray-200 rounded-full opacity-0 group-hover:opacity-100 transition-all ml-1">
                    <span class="material-symbols-outlined text-[20px]">more_vert</span>
                  </button>
                </div>
              </div>
            </div>
          </section>

          <!-- ========================================== -->
          <!-- 2. GROUPS SECTION (Accordion Rows)         -->
          <!-- ========================================== -->
          <section>
            <!-- Header and Controls -->
            <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-gray-300 pb-4 mb-4 gap-4">
              
              <div class="flex items-baseline gap-4 shrink-0">
                <h2 class="text-3xl font-normal text-gray-900 tracking-tight" style="font-family: 'Google Sans', sans-serif;">Groups</h2>
