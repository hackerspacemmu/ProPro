                    <span class="material-symbols-outlined text-[20px]">more_vert</span>
                  </button>
                </div>
              </div>
              
              <div class="flex items-center justify-between py-3 px-4 hover:bg-gray-50 rounded-lg transition-colors group">
                <div class="flex items-center gap-4">
                  <div class="w-9 h-9 rounded-full bg-[#E6F4EA] flex items-center justify-center text-sm font-medium text-[#1E8E3E] shrink-0">T</div>
                  <span class="text-sm font-medium text-gray-900">Test Lecturer 1</span>
                </div>
                <div class="flex items-center gap-4 ml-auto">
                  <div class="w-24 h-1.5 bg-[#E1E3E1] rounded-full overflow-hidden flex">
