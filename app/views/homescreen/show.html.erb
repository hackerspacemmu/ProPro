      <!-- TABS -->
      <div class="border-b border-[#E0E0E0] px-6 pt-4 shrink-0 bg-white z-10">
        <div class="flex gap-8 overflow-x-auto no-scrollbar">
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Project Details</button>
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">To Review</button>
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Supervised Projects</button>
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Topic Directory</button>
          
          <!-- Active Tab -->
          <button type="button" class="pb-3 text-[#0B57D0] border-b-4 border-[#0B57D0] transition-colors whitespace-nowrap" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">People</button>
          
          <button type="button" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent transition-colors whitespace-nowrap" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Settings</button>
