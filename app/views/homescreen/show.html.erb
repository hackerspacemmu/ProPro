<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>People - ProPro</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Material Symbols for Google Material Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Roboto:wght@400;500;700&display=swap');
  </style>
</head>
<body class="bg-[#f8fafd] text-[#3C4043] font-['Roboto',sans-serif] h-screen flex flex-col overflow-hidden">

  <!-- ========================================== -->
  <!-- HEADER                                     -->
  <!-- ========================================== -->
  <header class="flex items-center justify-between gap-3 px-4 py-3 shrink-0">
    <div class="flex items-center gap-2 min-w-0">
      <button type="button" aria-label="Toggle sidebar" class="lg:hidden shrink-0 p-2 rounded-full hover:bg-[#EEF0F4] text-[#5F6368] transition-colors">
        <span class="material-symbols-outlined">menu</span>
      </button>

      <span class="shrink-0 text-[24px] text-[#5F6368] font-medium" style="font-family: 'Google Sans', sans-serif;">ProPro</span>

      <!-- Breadcrumbs Mockup -->
      <nav class="hidden md:flex items-center ml-4 text-sm text-[#5F6368]" style="font-family: 'Google Sans', sans-serif;">
        <a href="#" class="hover:text-gray-900 transition-colors">Home</a>
        <span class="mx-2 material-symbols-outlined text-[16px]">chevron_right</span>
        <span class="text-[#3C4043] font-medium">Scatting class (G11)</span>
      </nav>
    </div>

    <button type="button" class="shrink-0 m-0 text-[15px] font-medium text-[#5F6368] hover:text-[#3C4043] transition-colors pr-2 bg-transparent border-0 cursor-pointer" style="font-family: 'Google Sans', sans-serif;">
      Log out
    </button>
  </header>

  <!-- ========================================== -->
  <!-- MAIN LAYOUT (Sidebar + Content)            -->
  <!-- ========================================== -->
  <div class="flex flex-1 overflow-hidden">
    
    <!-- SIDEBAR -->
    <aside id="app-sidebar" class="w-[280px] shrink-0 py-3 bg-[#f8fafd] hidden lg:flex flex-col h-full overflow-y-auto">
      <nav class="flex flex-col gap-1 pr-3">
        
        <!-- Home (Inactive) -->
        <a href="#" class="flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors text-[#3C4043] hover:bg-black/5" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">
          <span class="material-symbols-outlined">home</span>
          <span>Home</span>
        </a>

        <!-- Enrolled Header -->
        <div class="px-6 py-2 flex items-center justify-between text-[#5F6368] cursor-pointer">
          <span style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">Enrolled</span>
          <span class="material-symbols-outlined text-sm">expand_less</span>
        </div>

        <!-- Active Course -->
        <a href="#" class="flex items-center gap-4 transition-colors truncate mx-3 px-4 py-3.5 rounded-full bg-[#D3E3FD] text-[#0B57D0]" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">
          <div class="w-9 h-9 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-sm font-bold shrink-0">
            S
          </div>
          <span class="truncate">Scatting class</span>
        </a>

        <!-- Inactive Course -->
        <a href="#" class="flex items-center gap-4 transition-colors truncate px-6 py-3.5 rounded-r-full text-[#3C4043] hover:bg-black/5" style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;">
          <div class="w-9 h-9 rounded-full bg-[#E1E3E1] text-[#3C4043] flex items-center justify-center text-sm font-bold shrink-0">
            D
          </div>
