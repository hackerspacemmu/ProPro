                    <td class="w-[10%] px-4 py-4 text-sm font-medium text-gray-900 align-middle">01</td>
                    <td class="w-[30%] px-4 py-4 align-middle">
                      <div class="flex items-center gap-3">
                        <div class="flex -space-x-1.5">
                          <div class="w-7 h-7 rounded-full bg-gray-200 border-2 border-white flex items-center justify-center text-[11px] font-medium text-gray-700 z-10">T</div>
                        </div>
                        <span class="text-sm text-gray-500">1 member</span>
                      </div>
                    </td>
                    <td class="w-[30%] px-4 py-4 text-sm align-middle pr-4">
                      <a href="#" class="text-[#1A73E8] hover:underline truncate block w-full">Pineapple das</a>
                    </td>
                    <td class="w-[15%] px-4 py-4 align-middle">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium bg-[#E8F0FE] text-[#1967D2]">
                        Pending
