<% content_for :body_class, "bg-surface-tint" %>

<div class="text-on-surface font-['Roboto',sans-serif]">
  <div class="flex">

    <%= render "shared/sidebar" %>

    <main class="flex-1 min-w-0 bg-surface-tint overflow-y-auto h-[calc(100vh-var(--spacing-header))]">

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-10 pb-20">

        <div class="mb-4 max-w-fit">
          <%= render "courses/flash" %>
        </div>

        <%= render "join_by_code_form" %>

        <div class="flex-1 flex flex-col bg-white rounded-[28px] overflow-hidden">

          <div class="p-6">

            <div class="flex items-center justify-between mb-6">
              <h2 class="text-[22px] font-normal text-[#1f1f1f]"
                  style="font-family: 'DM Sans', Roboto, Arial, sans-serif;">
                Courses
              </h2>

              <% if policy(Course.new).create? %>
                <%= link_to new_course_path,
                    class: "flex items-center gap-2 bg-transparent hover:bg-primary-container text-primary-strong px-5 py-2.5 rounded-full font-medium text-[14px] transition-colors no-underline" do %>
                  <span class="material-symbols-outlined text-[20px]">add</span>
                  Add course
                <% end %>
              <% end %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

              <% if @courses.present? %>
                <% @courses.each_with_index do |course, index| %>
                  <%= render "courses/course_card",
                    course: course,
                    theme: course_theme(index) %>
                <% end %>

              <% else %>
                <div class="col-span-1 w-full flex items-center gap-3 p-6 bg-white rounded-xl border border-outline shadow-sm">
                  <%= image_tag "info.svg", class: "w-6 h-6" %>
                  <h5 class="text-sm text-on-surface font-medium m-0">
                    You have no courses at the moment. Please create one.
                  </h5>
                </div>
              <% end %>

            </div>

          </div>
        </div>

      </div>

    </main>
  </div>
</div>
