                    </td>
                    <td class="w-[15%] px-4 py-4 text-sm text-gray-600 align-middle">
                      <div class="flex items-center justify-between">
                        <span>Test Lecturer 1</span>
                        <span id="icon-group-01" class="material-symbols-outlined text-gray-400 transition-transform duration-200">expand_more</span>
                      </div>
                    </td>
                  </tr>
                  <!-- Detail Row -->
                  <tr id="detail-group-01" class="hidden bg-gray-50/30">
                    <td colspan="5" class="px-4 py-4 border-t border-gray-100">
                      <div class="pl-[10%]"> 
                        <div class="flex flex-col gap-4">
                          <div class="flex items-center gap-3">
                            <div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-[11px] font-medium text-gray-700 shrink-0">T</div>
                            <span class="text-sm text-gray-700">Test Student 1</span>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>

                  <!-- ========================================== -->
                  <!-- GROUP 03 -->
                  <!-- ========================================== -->
