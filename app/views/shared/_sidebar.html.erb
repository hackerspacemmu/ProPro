<aside id="app-sidebar"
       class="
         w-[280px] shrink-0 py-3 bg-white
         fixed top-0 left-0 h-full z-50 -translate-x-full transition-transform
         duration-300 ease-out
         lg:static lg:translate-x-0 lg:transition-none lg:h-auto
       "
       data-sidebar-target="container">
  <nav class="flex flex-col gap-1 pr-3">

    <% home_active = current_page?(root_path) %>
    <%= link_to root_path,
          class: [
            "flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors",
            home_active ? "bg-[#D3E3FD] text-[#0B57D0] font-semibold" : "text-[#3C4043] hover:bg-white/60"
          ],
          style: "font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" do %>
      <span class="material-symbols-outlined">home</span>
      <span>Home</span>
    <% end %>

    <div class="px-6 py-2 flex items-center justify-between text-[#5F6368] cursor-pointer">
      <span style="font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;">Enrolled</span>
      <span class="material-symbols-outlined text-sm">expand_less</span>
    </div>

    <% current_user.courses.distinct.each do |course| %>
      <% active = course == @course %>
      <%= link_to course_path(course),
            class: [
              "flex items-center gap-4 transition-colors truncate",
              active ? "mx-3 px-4 py-3.5 rounded-full bg-[#D3E3FD] text-[#0B57D0] font-semibold" : "px-6 py-3.5 rounded-r-full text-[#3C4043] hover:bg-white/60"
            ],
            style: "font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" do %>
        <div class="w-9 h-9 rounded-full <%= active ? 'bg-[#E1E3E1] text-[#3C4043]' : 'bg-[#1A73E8] text-white' %> flex items-center justify-center text-sm font-bold shrink-0">
          <%= course.course_name.first.upcase %>
        </div>
        <span class="truncate"><%= course.course_name %></span>
      <% end %>
    <% end %>

    <div class="py-2">
      <div class="border-t border-[#DADCE0]"></div>
    </div>

    <% profile_active = current_page?(user_profile_path) %>
    <%= link_to user_profile_path,
          class: [
            "flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors",
            profile_active ? "bg-[#D3E3FD] text-[#0B57D0] font-semibold" : "text-[#3C4043] hover:bg-white/60"
          ],
          style: "font-family: 'Google Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" do %>
      <span class="material-symbols-outlined text-[#5F6368]">person</span>
      <span>Edit profile</span>
    <% end %>

  </nav>
</aside>

<div class="hidden fixed inset-0 bg-black/30 z-40 lg:hidden"
     data-sidebar-target="backdrop"
     data-action="click->sidebar#close"></div>
