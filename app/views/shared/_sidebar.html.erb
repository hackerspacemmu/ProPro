<aside id="app-sidebar"
       class="
         w-[280px] shrink-0 py-3 bg-surface-tint
         fixed top-0 left-0 h-full z-50 -translate-x-full transition-transform
         duration-300 ease-out
         lg:sticky lg:top-[3.5rem] lg:translate-x-0 lg:transition-none lg:h-[calc(100vh-3.5rem)] lg:overflow-y-auto lg:self-start
       "
       data-sidebar-target="container">
  <nav class="flex flex-col gap-1 pr-3">

    <% home_active = current_page?(root_path) %>
    <%= link_to root_path,
          class: [
            "flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors",
            home_active ? "bg-primary-container-alt text-primary-strong font-semibold" : "text-on-surface hover:bg-white/60"
          ],
          style: "font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" do %>
      <span class="material-symbols-outlined">home</span>
      <span>Home</span>
    <% end %>

    <div class="px-6 py-2 flex items-center justify-between text-on-surface-variant cursor-pointer">
      <span style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;">Enrolled</span>
      <span class="material-symbols-outlined text-sm">expand_less</span>
    </div>

    <% current_user.courses.distinct.each do |course| %>
      <% active = course == @course %>
      <%= link_to course_path(course),
            class: [
              "flex items-center gap-4 transition-colors truncate",
              active ? "mx-3 px-4 py-3.5 rounded-full bg-primary-container-alt text-primary-strong font-semibold" : "px-6 py-3.5 rounded-r-full text-on-surface hover:bg-white/60"
            ],
            style: "font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" do %>
        <div class="w-9 h-9 rounded-full <%= active ? 'bg-[#E1E3E1] text-on-surface' : 'bg-primary text-white' %> flex items-center justify-center text-sm font-bold shrink-0">
          <%= course.course_name.first.upcase %>
        </div>
        <span class="truncate"><%= course.course_name %></span>
      <% end %>
    <% end %>

    <div class="py-2">
      <div class="border-t border-outline"></div>
    </div>

    <% profile_active = current_page?(user_profile_path) %>
    <%= link_to user_profile_path,
          class: [
            "flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors",
            profile_active ? "bg-primary-container-alt text-primary-strong font-semibold" : "text-on-surface hover:bg-white/60"
          ],
          style: "font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" do %>
      <span class="material-symbols-outlined text-on-surface-variant">person</span>
      <span>Edit profile</span>
    <% end %>

    <%= button_to "<span class=\"material-symbols-outlined text-on-surface-variant\">logout</span><span>Log out</span>".html_safe,
          session_path, method: :delete,
          form: { class: "m-0 w-full", data: { turbo_confirm: nil } },
          class: "flex items-center gap-4 w-full text-left px-6 py-3.5 rounded-r-full text-on-surface text-[0.875rem] font-medium leading-[1.25rem] bg-transparent border-0 cursor-pointer hover:bg-white/60 transition-colors",
          style: "font-family: 'DM Sans', Roboto, Arial, sans-serif; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" %>

  </nav>
</aside>

<div class="hidden fixed inset-0 bg-black/30 z-40 lg:hidden"
     data-sidebar-target="backdrop"
     data-action="click->sidebar#close"></div>
