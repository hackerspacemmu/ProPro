<%# Locals: path, icon, title, meta_parts (array joined with "•"),
    time_meta (appended to meta line as "• timestamp"), status,
    pill_label (defaults to status humanized), linkable
    (default true), link_options, border_top (default true), and an optional
    block rendered below the row line. The status pill sits on the right. %>

<%
  pill_bg, pill_fg =
    case status.to_s
    when "approved" then ["bg-success-container", "text-success"]
    when "pending"  then ["bg-primary-container", "text-primary-soft"]
    when "redo"     then ["bg-warning-container", "text-warning"]
    when "rejected" then ["bg-error-container", "text-error"]
    else                 ["bg-surface-variant", "text-on-surface-variant"]
    end

  icon_bg, icon_fg =
    case status.to_s
    when "approved" then ["bg-surface-variant", "text-success"]
    when "pending"  then ["bg-surface-variant", "text-primary-soft"]
    when "redo"     then ["bg-surface-variant", "text-warning"]
    when "rejected" then ["bg-surface-variant", "text-error"]
    else                 ["bg-surface-variant", "text-on-surface-variant"]
    end

  linkable = local_assigns.fetch(:linkable, true)
  pill_label = local_assigns.fetch(:pill_label, status.to_s.humanize)
  link_options = local_assigns[:link_options] || {}
  meta_parts = local_assigns[:meta_parts] || []
  time_meta = local_assigns[:time_meta]
  border_top = local_assigns.fetch(:border_top, true)
  rejected = status.to_s == "rejected"

  row_classes =
    "group flex flex-col w-full py-3 px-4 " \
    "hover:bg-surface-variant transition-colors bg-white"
  row_classes += " border-t border-outline-variant" if border_top
  row_classes += " opacity-80" if rejected
  row_classes += linkable ? " cursor-pointer" : " opacity-75 cursor-not-allowed"
  title_color = rejected ? "text-on-surface-variant" : "text-on-surface-strong"

  pill_span = "#{pill_bg} #{pill_fg} px-2.5 py-0.5 rounded text-[12px] font-medium tracking-wide whitespace-nowrap"
%>

<% content_block = capture do %>
  <div class="flex items-start sm:items-center gap-4 w-full min-w-0">
    
    <!-- Icon Container: Stays fixed on the left -->
    <div class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 <%= icon_bg %> <%= icon_fg %> mt-0.5 sm:mt-0">
      <span class="material-symbols-outlined text-[20px]"><%= icon %></span>
    </div>

    <!-- Content Container: Stacks vertically on mobile, horizontally on sm+ -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between w-full min-w-0 gap-2 sm:gap-4">
      
      <!-- Title & Meta Parts -->
      <div class="min-w-0 flex-1">
        <h3 style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: 1rem; font-weight: 400; letter-spacing: 0; line-height: 1.5rem;" class="mb-0.5 <%= title_color %> truncate"><%= title %></h3>
        <div style="font-family: 'DM Sans', Roboto, Arial, sans-serif;" class="flex items-center gap-2 text-[13px] text-on-surface-muted flex-wrap sm:flex-nowrap mt-0.5 sm:mt-0">
          <% meta_parts.each_with_index do |part, idx| %>
            <% unless idx.zero? %><span class="shrink-0">•</span><% end %>
            <span class="<%= idx.zero? ? "truncate max-w-full" : "whitespace-nowrap" %>"><%= part %></span>
          <% end %>
          <% if time_meta.present? %>
            <% if meta_parts.any? %><span class="shrink-0">•</span><% end %>
            <span class="whitespace-nowrap"><%= time_meta %></span>
          <% end %>
        </div>
      </div>

      <!-- Pill + more actions -->
      <div class="flex items-center gap-1 sm:gap-3 shrink-0">
        <span class="<%= pill_span %>"><%= pill_label %></span>
        <button type="button" aria-label="More actions" tabindex="-1"
            class="hidden sm:flex text-on-surface-variant hover:bg-black/5 p-1.5 rounded-full items-center justify-center transition-colors shrink-0">
          <span class="material-symbols-outlined text-[20px]">more_vert</span>
        </button>
      </div>

    </div>
  </div>
  <%= yield %>
<% end %>

<% if linkable %>
  <%= link_to path, class: row_classes, **link_options do %>
    <%= content_block %>
  <% end %>
<% else %>
  <div class="<%= row_classes %>">
    <%= content_block %>
  </div>
<% end %>
