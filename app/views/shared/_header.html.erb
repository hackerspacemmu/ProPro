<header class="flex items-center justify-between px-4 py-3">
  <div class="flex items-center gap-2">
    <% unless content_for?(:hide_toggler) %>
      <button type="button"
        data-sidebar-target="toggleButton"
        data-action="sidebar#toggle"
        aria-label="Toggle sidebar"
        aria-expanded="false"
        aria-controls="app-sidebar"
        class="lg:hidden p-2 rounded-full hover:bg-[#EEF0F4] text-[#5F6368] transition-colors">
        <span class="material-symbols-outlined">menu</span>
      </button>
    <% end %>

    <span class="text-[24px] text-[#5F6368] font-medium">ProPro</span>

    <% unless content_for?(:hide_breadcrumbs) %>
      <% render_custom_breadcrumbs %>
      <% if content_for?(:breadcrumbs) %>
        <%= yield :breadcrumbs %>
      <% else %>
        <%= link_to "Home", root_path, class: "hover:text-gray-900 transition-colors" %>
      <% end %>
    <% end %>
  </div>

  <%= button_to "Log out", session_path, method: :delete,
        form: { data: { turbo_confirm: nil } },
        class: "text-[15px] font-medium text-[#5F6368] hover:text-[#3C4043] transition-colors pr-2 bg-transparent border-0 cursor-pointer" %>
</header>
