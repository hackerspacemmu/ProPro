<%# Locals: rows, partial, item (the collection "as" name), locals (extra per-item
    locals), container_classes (extra classes on the wrapper), container_attrs
    (extra attributes on the wrapper, e.g. data attributes for collapsible-sections),
    borderless_first (true to drop the first row's top border — the caller then
    supplies its own persistent line above the list, e.g. for collapsible sections). %>
<%
  container_classes = local_assigns.fetch(:container_classes, "w-full")
  container_attrs = local_assigns[:container_attrs] || {}
  item = local_assigns.fetch(:item, :item)
%>
<%= tag.div(class: "flex flex-col border-b border-[#E0E0E0] #{container_classes}", **container_attrs) do %>
  <% if local_assigns[:borderless_first] %>
    <% rows.each_with_index do |row, idx| %>
      <%= render partial: partial, object: row, as: item,
          locals: (local_assigns[:locals] || {}).merge(border_top: !idx.zero?) %>
    <% end %>
  <% else %>
    <%= render partial: partial, collection: rows, as: item,
        locals: (local_assigns[:locals] || {}) %>
  <% end %>
<% end %>
