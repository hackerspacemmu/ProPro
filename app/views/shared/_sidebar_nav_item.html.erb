<%
  kind       = local_assigns[:kind] || :plain
  label      = local_assigns.fetch(:label)
  active     = !!local_assigns[:active]
  path       = local_assigns[:path]
  icon       = local_assigns[:icon]
  avatar     = local_assigns[:avatar]
  icon_color = local_assigns[:icon_color] || ""
  is_course  = kind == :course
  is_logout  = kind == :logout

  row_style = "font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;"

  row_base = [
    "group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors",
    # Collapsed (lg + data-collapsed=true): center the icon/avatar on the rail.
    "group-data-[collapsed=true]/sidebar:lg:justify-center",
    "group-data-[collapsed=true]/sidebar:lg:px-0"
  ]

  # Active treatment (filled pill + strong color) is suppressed on the collapsed
  # rail: at lg a collapsed sidebar is an icon-only rail, so the current-page
  # cue is dropped rather than shrunk to a pill.
  active_pill = "lg:group-data-[collapsed=false]/sidebar:mx-3 " \
                "lg:group-data-[collapsed=false]/sidebar:rounded-full " \
                "lg:group-data-[collapsed=false]/sidebar:bg-primary-container-alt " \
                "lg:group-data-[collapsed=false]/sidebar:text-primary-strong " \
                "lg:group-data-[collapsed=false]/sidebar:font-semibold"

  row_classes = if is_course
    row_base + [
      "truncate",
      active ? active_pill : "rounded-r-full text-on-surface hover:bg-white/60"
    ]
  else
    row_base + [
      active ? active_pill : "rounded-r-full text-on-surface hover:bg-white/60"
    ]
  end
%>

<% inner = capture do %>
  <% if is_course %>
    <div class="w-9 h-9 rounded-full <%= active ? 'bg-surface-variant-deep text-on-surface' : 'bg-primary text-white' %> flex items-center justify-center text-sm font-bold shrink-0"><%= avatar %></div>
  <% else %>
    <span class="material-symbols-outlined <%= icon_color %>"><%= icon %></span>
  <% end %>

  <span class="<%= is_course ? 'truncate ' : '' %>group-data-[collapsed=true]/sidebar:lg:hidden"><%= label %></span>

  <%# Hover tooltip — only while collapsed+lg; never beside the visible label.
      Purely decorative; the accessible name comes from aria-label. %>
  <span class="hidden group-data-[collapsed=true]/sidebar:lg:group-hover/item:block absolute z-50 left-full top-1/2 -translate-y-1/2 ml-3 whitespace-nowrap rounded-md bg-black text-white px-2 py-1 text-xs shadow-lg pointer-events-none" aria-hidden="true"><%= label %></span>
<% end %>

<% if is_logout %>
  <%= button_to inner, path, method: :delete,
        form: { class: "m-0 w-full", data: { turbo_confirm: nil } },
        class: (row_classes + [ "w-full text-left bg-transparent border-0 cursor-pointer" ]).join(" "),
        style: row_style,
        aria: { label: label } %>
<% else %>
  <%= link_to path, class: row_classes.join(" "), style: row_style, aria: { label: label } do %>
    <%= inner %>
  <% end %>
<% end %>
