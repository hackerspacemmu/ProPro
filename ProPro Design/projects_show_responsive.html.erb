<% content_for :hide_toggler, true %>
<% content_for :no_sidebar, true %>
<% content_for :hide_breadcrumbs, true %>
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@100..900&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

<!-- Mobile Viewport Wrapper (Added pb-20 to clear the sticky bottom action bar) -->
<div class="min-h-screen bg-white text-[#3C4043] font-['Roboto',sans-serif] flex flex-col pb-20 relative">

  <!-- 1. MOBILE GLOBAL HEADER (Sticky Top) -->
  <header class="sticky top-0 bg-white border-b border-[#E0E0E0] px-4 py-3 shrink-0 z-40 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <!-- Hamburger Menu (Triggers Navigation Drawer) -->
      <button class="p-2 -ml-2 rounded-full hover:bg-[#F1F3F4] text-[#5F6368] transition-colors flex items-center justify-center">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <span style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="text-[20px] text-[#1f1f1f] font-medium tracking-normal">ProPro</span>
    </div>
    
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-sm font-bold">WK</div>
    </div>
  </header>

  <!-- 2. MOBILE NAVIGATION DRAWER (Hidden by default, acts as a modal overlay) -->
  <div class="fixed inset-0 z-50 hidden">
    <!-- Dark Backdrop -->
    <div class="absolute inset-0 bg-black/50 transition-opacity"></div>
    
    <!-- Drawer Panel -->
    <aside class="absolute inset-y-0 left-0 w-[280px] bg-[#f8fafd] py-3 overflow-y-auto shadow-xl">
      <!-- Nav items remain exactly the same as your desktop sidebar -->
      <nav class="flex flex-col gap-1 pr-3">
        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="flex items-center gap-4 px-6 py-3.5 rounded-r-full transition-colors text-[#3C4043] hover:bg-white/60 font-medium text-[14px] leading-5 tracking-normal">
          <span class="material-symbols-outlined">home</span>
          <span>Home</span>
        </a>
        <div class="px-6 py-2 flex items-center justify-between text-[#5F6368] mt-2 cursor-pointer">
          <span style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="font-medium text-[14px] leading-5 tracking-normal">Enrolled</span>
          <span class="material-symbols-outlined text-sm">expand_less</span>
        </div>
        <!-- Active Pill -->
        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="flex items-center gap-4 mx-3 px-4 py-3.5 rounded-full bg-[#D3E3FD] text-[#0B57D0] font-medium text-[14px] leading-5 tracking-normal">
          <div class="w-9 h-9 rounded-full bg-[#E1E3E1] text-[#3C4043] flex items-center justify-center text-sm font-bold shrink-0">G</div>
          <span class="truncate font-semibold">Grouped Topic Approval Enabled</span>
        </a>
      </nav>
    </aside>
  </div>

  <!-- 3. MAIN APP CANVAS -->
  <main class="flex-1 flex flex-col w-full max-w-[100vw] overflow-hidden">
    
    <!-- Context Header -->
    <div class="px-5 pt-6 pb-4">
      <div class="flex flex-col mb-2">
        <div class="flex items-center gap-3 mb-3">
          <span class="bg-[#E8F0FE] text-[#1967D2] px-3 py-1 rounded-full text-xs font-medium tracking-wide">Pending</span>
          <span class="text-[14px] text-[#444746]">Submitted 2h ago</span>
        </div>
        <h1 style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif; font-size: 1.75rem; font-weight: 400; letter-spacing: 0; line-height: 2.25rem; color: #1f1f1f;">
          Difficult Group Project Group 4
        </h1>
      </div>
    </div>

    <!-- Mobile Scrollable Tabs (Option 2A: Comments appended as 4th tab) -->
    <!-- hide-scrollbar class should be added in CSS to remove the native scrollbar visual -->
    <div class="border-b border-[#E0E0E0] px-5 sticky top-[57px] bg-white z-30 overflow-x-auto flex">
      <div class="flex gap-6 min-w-max">
        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="pb-3 text-[#1A73E8] border-b-4 border-[#1A73E8] text-[14px] font-medium leading-5 tracking-normal">Project Details</a>
        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent text-[14px] font-medium leading-5 tracking-normal transition-colors">Compare Versions</a>
        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent text-[14px] font-medium leading-5 tracking-normal transition-colors">Progress Updates</a>
        <!-- The new Comments Tab -->
        <a href="#" style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif;" class="pb-3 text-[#5F6368] hover:text-[#3C4043] border-b-4 border-transparent text-[14px] font-medium leading-5 tracking-normal transition-colors flex items-center gap-1.5">
          Comments
          <span class="bg-[#F1F3F4] text-[#3C4043] px-2 py-0.5 rounded-full text-[11px] font-medium leading-none">7</span>
        </a>
      </div>
    </div>

    <!-- Content Area: Project Details -->
    <div class="p-5 space-y-6">

      <!-- 1. META INFORMATION CARD -->
      <div class="bg-white border border-[#E0E0E0] rounded-lg p-5">
        <h3 style="font-family: 'Google Sans', 'Google Sans Flex', Roboto, Arial, sans-serif; font-size: 1rem; font-weight: 500; letter-spacing: 0; line-height: 1.5rem; color: #1f1f1f;" class="mb-5">Project Overview</h3>
        
        <!-- Stacked Grid for Mobile -->
        <div class="grid grid-cols-1 gap-5">
          <div>
            <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-1">Group Name</div>
            <div class="text-[15px] text-[#3C4043]">Group 4</div>
          </div>
          <div>
            <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-1">Type</div>
            <div class="text-[15px] text-[#3C4043]">Grouped Project</div>
          </div>
          <div>
            <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-3">Owners</div>
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[#E1E3E1] text-[#3C4043] flex items-center justify-center text-sm font-medium">K</div>
                <span class="text-[15px] text-[#3C4043]">Koh Wei Keat</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[#E1E3E1] text-[#3C4043] flex items-center justify-center text-sm font-medium">R</div>
                <span class="text-[15px] text-[#3C4043]">Raymond Lee Wei Kang</span>
              </div>
            </div>
          </div>
          <div>
            <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide mb-3">Supervisor</div>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-[#1A73E8] text-white flex items-center justify-center text-sm font-medium">L1</div>
              <span class="text-[15px] text-[#3C4043] font-medium">Lecturer 1</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. DYNAMIC TEMPLATE FIELDS (Looped Content) -->
      <div class="bg-white border border-[#E0E0E0] rounded-lg overflow-hidden">
        
        <!-- DATA TYPE: Short Text (Stacked on Mobile) -->
        <div class="py-4 px-5 border-b border-[#E0E0E0] flex flex-col gap-1.5 active:bg-[#F8F9FA] transition-colors">
          <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide">Project Title</div>
          <div class="text-[15px] text-[#3C4043]">Difficult Group Project Group 4</div>
        </div>

        <!-- DATA TYPE: Dropdown / Select (Single Chip) -->
        <div class="py-4 px-5 border-b border-[#E0E0E0] flex flex-col gap-2 active:bg-[#F8F9FA] transition-colors">
          <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide">Target Platform</div>
          <div class="flex flex-wrap gap-2">
            <span class="bg-[#F1F3F4] border border-[#DADCE0] text-[#3C4043] px-3 py-1 rounded-lg text-[13px] font-medium">Web App</span>
          </div>
        </div>

        <!-- DATA TYPE: Short Text (Dates with emoji) -->
        <div class="py-4 px-5 border-b border-[#E0E0E0] flex flex-col gap-1.5 active:bg-[#F8F9FA] transition-colors">
          <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide">Proposed Deadline</div>
          <div class="text-[15px] text-[#3C4043]">📅 November 24, 2026</div>
        </div>

        <!-- DATA TYPE: Rich Text -->
        <div class="py-5 px-5 border-b border-[#E0E0E0] flex flex-col gap-3">
          <div class="text-xs font-medium text-[#5F6368] uppercase tracking-wide">Group Project Description</div>
          <div class="text-[15px] text-[#3C4043] leading-relaxed bg-white border border-[#E0E0E0] rounded-lg p-5 prose prose-sm max-w-none">
            <h2>1. User Account Management</h2>
            <p>Users can create and manage their accounts securely.</p>
            <ul>
              <li>Username & Email</li>
              <li>View profile</li>
            </ul>
          </div>
        </div>

        <!-- Info Footer -->
        <div class="p-4 bg-[#F8F9FA]">
          <div class="flex items-center gap-2 text-xs text-[#5F6368]">
            <span class="material-symbols-outlined text-[18px]">info</span>
            <span>Based on Topic: <strong>Own Proposal</strong></span>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- 4. STICKY BOTTOM ACTION BAR (Option 3B) -->
  <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-[#E0E0E0] p-3 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-40 flex items-center justify-between gap-3">
    
    <!-- Left: Version Selector (Condensed) -->
    <div class="flex-shrink-0">
      <select class="bg-[#F8F9FA] border border-[#DADCE0] rounded-lg px-2 py-2.5 text-[14px] text-[#3C4043] font-medium focus:outline-none focus:ring-2 focus:ring-[#1A73E8]">
        <option>V1 (Current)</option>
      </select>
    </div>

    <!-- Right: Action Buttons -->
    <div class="flex items-center gap-2">
      <!-- Reject Button (Icon only on mobile to save space, red text) -->
      <button class="p-2.5 text-[#C5221F] hover:bg-[#FCE8E6] rounded-full transition-colors flex items-center justify-center">
        <span class="material-symbols-outlined text-[22px]">block</span>
      </button>
      
      <!-- Redo Button (Icon only on mobile) -->
      <button class="p-2.5 text-[#5F6368] hover:bg-[#F1F3F4] rounded-full transition-colors flex items-center justify-center">
        <span class="material-symbols-outlined text-[22px]">replay</span>
      </button>

      <!-- Approve Button (Primary, Text + Icon) -->
      <button class="bg-[#137333] hover:bg-[#0f5c29] text-white pl-3 pr-4 py-2.5 rounded-full font-medium text-[14px] transition-all flex items-center gap-1.5 shadow-sm">
        <span class="material-symbols-outlined text-[18px]">check</span>
        Approve
      </button>
    </div>
  </div>

</div>