<body class="bg-surface-tint text-on-surface">
<div class="min-h-screen flex flex-col">

  <!-- ============================================================
       TOP BAR  (new version — unchanged apart from shadow removal)
       ============================================================ -->
  <header class="sticky top-0 z-30 bg-white border-b border-outline-variant px-4 sm:px-6 py-3.5 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4 min-w-0">
      <a href="#" title="Close and return to course settings"
         class="p-2 -ml-2 rounded-full hover:bg-surface-variant text-on-surface-variant hover:text-on-surface transition-colors flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-[22px]">close</span>
      </a>

      <div class="h-5 w-px bg-outline shrink-0"></div>

      <div class="flex items-baseline gap-2 min-w-0">
        <h1 class="font-dm text-[18px] text-on-surface-strong font-medium tracking-tight truncate">
          Edit Project Template
        </h1>
        <span class="text-on-surface-variant text-[15px] font-dm truncate hidden sm:inline">— Grouped TopicApprovalEnabled</span>
      </div>
    </div>

    <div class="hidden min-[1245px]:flex items-center gap-2 shrink-0">
      <a href="#" class="px-5 py-2 rounded-full text-on-surface-variant hover:bg-surface-variant hover:text-on-surface font-medium text-[14px] transition-colors whitespace-nowrap">
        Discard Changes
      </a>
      <button type="submit" form="template-form"
              class="bg-primary hover:bg-primary-hover text-white px-6 py-2 rounded-full font-medium text-[14px] transition-all flex items-center gap-2 whitespace-nowrap">
        <span class="material-symbols-outlined text-[18px]">check</span>
        Save Template
      </button>
    </div>
  </header>

  <main class="flex-1 pt-10 pb-28 px-4 sm:px-6 min-[1245px]:pb-10">
    <div class="max-w-6xl mx-auto space-y-6">

      <form id="template-form">

        <section class="bg-white border border-outline-variant rounded-xl overflow-hidden">

          <div class="overflow-x-auto">
            <table class="field-table min-w-full divide-y divide-outline-variant table-fixed">
              <thead class="bg-white border-b border-outline-variant">
                <tr>
                  <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-on-surface-variant uppercase tracking-wide w-[14%]">Field Label</th>
                  <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-on-surface-variant uppercase tracking-wide w-[11%]">Description</th>
                  <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-on-surface-variant uppercase tracking-wide w-[17%]">Type</th>
                  <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-on-surface-variant uppercase tracking-wide w-[23%]">Applicable To</th>
                  <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-on-surface-variant uppercase tracking-wide w-[14%]">Options</th>
                  <th scope="col" class="px-6 py-4 text-center text-xs font-bold text-on-surface-variant uppercase tracking-wide w-[10%]">Required</th>
                  <th scope="col" class="px-6 py-4 text-center text-xs font-bold text-on-surface-variant uppercase tracking-wide w-[11%]">Free Edit</th>
                </tr>
              </thead>

              <tbody class="divide-y divide-outline-variant">

                <!-- ============ Row 1 — Short Text ============ -->
                <tr class="field-row group relative hover:bg-surface-hover/60 transition-colors">

                  <!-- Field Label -->
                  <td class="block lg:table-cell lg:pl-12 px-6 py-5 align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Field Label</span>
                    <div class="relative">
                      <div class="hidden lg:flex items-center justify-end absolute -left-8 top-1/2 -translate-y-1/2 w-6 h-8">
                        <span class="material-symbols-outlined text-[18px] text-on-surface-muted cursor-grab" title="Drag to reorder">drag_indicator</span>
                      </div>
                      <input type="text" value="Project Title" placeholder="e.g. Project Title"
                             class="block w-full px-3 py-2.5 border border-outline rounded-lg focus:ring-1 focus:ring-primary focus:border-primary text-[13.5px] text-on-surface" />
                    </div>
                  </td>

                  <!-- Description -->
                  <td class="block lg:table-cell px-6 py-5 align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Description</span>
                    <input type="text" placeholder="Instructions…"
                           class="block w-full px-3 py-2.5 border border-outline rounded-lg focus:ring-1 focus:ring-primary focus:border-primary text-[13.5px] text-on-surface-variant" />
                  </td>

                  <!-- Type -->
                  <td class="block lg:table-cell px-6 py-5 align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Type</span>
                    <div class="select-shell">
                      <select class="block w-full lg:inline-block lg:w-auto lg:min-w-[100px] py-2.5 pl-3 pr-7 border border-outline rounded-lg text-[13.5px] cursor-pointer">
                        <option selected>Short Text</option>
                        <option>Paragraph</option>
                        <option>Dropdown</option>
                        <option>Radio</option>
                        <option>Checkbox</option>
                        <option>Number</option>
                        <option>Date</option>
                        <option>File Upload</option>
                      </select>
                      <span class="chevron material-symbols-outlined text-[18px] text-on-surface-variant">expand_more</span>
                    </div>
                  </td>

                  <!-- Applicable To -->
                  <td class="block lg:table-cell px-6 py-5 align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Applicable To</span>
                    <div class="select-shell">
                      <select class="block w-full lg:inline-block lg:w-auto lg:min-w-[100px] py-2.5 pl-3 pr-7 border border-outline rounded-lg text-[13.5px] cursor-pointer">
                        <option selected>Both</option>
                        <option>Topics Only</option>
                        <option>Own Proposals Only</option>
                      </select>
                      <span class="chevron material-symbols-outlined text-[18px] text-on-surface-variant">expand_more</span>
                    </div>
                  </td>

                  <!-- Options (+ mobile reorder / remove) -->
                  <td class="block lg:table-cell px-6 py-5 align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Options</span>
                    <span class="text-[13px] text-on-surface-muted">—</span>

                    <div class="lg:hidden mt-3">
                      <div class="drag-handle flex items-center justify-center w-full py-3 border-2 border-dashed border-outline rounded-lg text-on-surface-variant bg-surface-tint active:bg-primary-container active:border-primary transition-colors cursor-grab touch-pan-y" oncontextmenu="return false;">
                        <svg class="mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
                        </svg>
                        <span class="text-xs font-bold uppercase tracking-wider">Hold &amp; Drag to Reorder</span>
                      </div>
                    </div>

                    <button type="button"
                            class="remove-field lg:hidden mt-3 inline-flex items-center text-xs text-error hover:text-error-hover font-medium bg-error-container px-3 py-2 rounded-lg">
                      <svg class="mr-1.5 h-4 w-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                      Remove Field
                    </button>
                    <input type="hidden" name="field[_destroy]" value="0" class="destroy-flag" />
                  </td>

                  <!-- Required -->
                  <td class="block lg:table-cell px-6 py-5 whitespace-nowrap align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Required</span>
                    <div class="flex items-center h-10">
                      <input type="checkbox" checked disabled
                             class="h-5 w-5 rounded border-outline accent-primary cursor-not-allowed" />
                      <label class="ml-2 text-sm text-on-surface-variant lg:hidden">Field is required</label>
                    </div>
                  </td>

                  <!-- Free Edit -->
                  <td class="block lg:table-cell px-6 py-5 whitespace-nowrap align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Free Edit</span>
                    <div class="flex items-center h-10" title="Allow editing after approval">
                      <input type="checkbox"
                             class="h-5 w-5 rounded border-outline accent-success cursor-pointer" />
                      <label class="ml-2 text-sm text-on-surface-variant lg:hidden">Editable after approval</label>
                    </div>
                  </td>
                </tr>

                <!-- ============ Row 2 — Paragraph ============ -->
                <tr class="field-row group relative hover:bg-surface-hover/60 transition-colors">

                  <td class="block lg:table-cell lg:pl-12 px-6 py-5 align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Field Label</span>
                    <div class="relative">
                      <div class="hidden lg:flex items-center justify-end absolute -left-8 top-1/2 -translate-y-1/2 w-6 h-8">
                        <span class="material-symbols-outlined text-[18px] text-on-surface-muted cursor-grab" title="Drag to reorder">drag_indicator</span>
