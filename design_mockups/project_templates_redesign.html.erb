                    <input type="hidden" name="field[_destroy]" value="0" class="destroy-flag" />
                  </td>

                  <td class="block lg:table-cell px-6 py-5 whitespace-nowrap align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Required</span>
