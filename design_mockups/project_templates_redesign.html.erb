                        <option selected>Paragraph</option>
                        <option>Dropdown</option>
                        <option>Radio</option>
                        <option>Checkbox</option>
                        <option>Number</option>
                        <option>Date</option>
                        <option>File Upload</option>
                      </select>
                      <span class="chevron material-symbols-outlined text-[18px] text-on-surface-variant">expand_more</span>
                    </div>
                  </td>

                  <td class="block lg:table-cell px-6 py-5 align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Applicable To</span>
                    <div class="select-shell">
                      <select class="block w-full lg:inline-block lg:w-auto lg:min-w-[100px] py-2.5 pl-3 pr-7 border border-outline rounded-lg text-[13.5px] cursor-pointer">
                        <option selected>Both</option>
                        <option>Topics Only</option>
                        <option>Own Proposals Only</option>
                      </select>
                      <span class="chevron material-symbols-outlined text-[18px] text-on-surface-variant">expand_more</span>
                    </div>
                  </td>

                  <td class="block lg:table-cell px-6 py-5 align-top">
                    <span class="lg:hidden text-xs font-bold text-on-surface-variant uppercase tracking-wide mb-1 block">Options</span>
                    <span class="text-[13px] text-on-surface-muted">—</span>

                    <div class="lg:hidden mt-3">
                      <div class="drag-handle flex items-center justify-center w-full py-3 border-2 border-dashed border-outline rounded-lg text-on-surface-variant bg-surface-tint active:bg-primary-container active:border-primary transition-colors cursor-grab touch-pan-y" oncontextmenu="return false;">
                        <svg class="mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
                        </svg>
                        <span class="text-xs font-bold uppercase tracking-wider">Hold &amp; Drag to Reorder</span>
                      </div>
                    </div>

                    <button type="button"
                            class="remove-field lg:hidden mt-3 inline-flex items-center text-xs text-error hover:text-error-hover font-medium bg-error-container px-3 py-2 rounded-lg">
                      <svg class="mr-1.5 h-4 w-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                      Remove Field
