    .bg-primary { background-color: var(--color-primary); }
    .bg-primary-strong { background-color: var(--color-primary-strong); }
    .text-on-surface { color: var(--color-on-surface); }
    .text-on-surface-strong { color: var(--color-on-surface-strong); }
    .text-on-surface-variant { color: var(--color-on-surface-variant); }
    .text-primary { color: var(--color-primary); }
    .text-primary-strong { color: var(--color-primary-strong); }
    .border-outline { border-color: var(--color-outline); }
    .border-outline-variant { border-color: var(--color-outline-variant); }
    .rounded-tl-panel { border-top-left-radius: 24px; }
