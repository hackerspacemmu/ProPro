<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>COMP6000 - Overview tab | ProPro (mockup)</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
  :root{--color-surface-tint:#f8f9fa;--color-surface:#ffffff;--color-surface-hover:#f1f3f4;--color-surface-variant:#f1f3f4;--color-on-surface:#1f1f1f;--color-on-surface-strong:#1f1f1f;--color-on-surface-variant:#5f6368;--color-outline:#dadce0;--color-outline-variant:#e0e0e0;--color-primary:#1a73e8;--color-primary-strong:#1967d2;--color-primary-container:#d2e3fc;--color-primary-container-alt:#e8f0fe;--color-on-primary:#ffffff;--spacing-header:64px}
  .rounded-tl-panel{border-top-left-radius:24px}
</style>
<script>
tailwind.config={theme:{extend:{spacing:{header:'var(--spacing-header)'},colors:{
'surface-tint':'var(--color-surface-tint)',surface:'var(--color-surface)','surface-hover':'var(--color-surface-hover)','surface-variant':'var(--color-surface-variant)','surface-variant-deep':'#e1e3e1',
'on-surface':'var(--color-on-surface)','on-surface-strong':'var(--color-on-surface-strong)','on-surface-variant':'var(--color-on-surface-variant)','on-surface-muted':'#80868b',
outline:'var(--color-outline)','outline-variant':'var(--color-outline-variant)',primary:'var(--color-primary)','primary-strong':'var(--color-primary-strong)','primary-hover':'#1557b0',
'primary-container':'var(--color-primary-container)','primary-container-alt':'var(--color-primary-container-alt)','primary-soft':'#3b82f6',
'success-container':'#d6f5e3',success:'#137333',error:'#d93025','error-container':'#fde7e9','warning-container-alt':'#fffbeb','warning-container':'#fff4e5','warning-strong':'#f59e0b',
warning:'#b06000','warning-border':'#fde68a','warning-on-container':'#7a4b00'}}}}
</script>
</head>
<body class="bg-surface-tint" style="font-family: 'Roboto', Arial, sans-serif;">

<!-- Mockup controls (not part of the app) -->
<details open class="fixed bottom-4 right-4 z-[60] w-64 rounded-lg border border-outline-variant bg-white p-3 text-sm shadow-lg">
  <summary class="cursor-pointer font-medium text-on-surface">Mockup controls</summary>
  <div class="mt-3 flex flex-col gap-3 text-on-surface-variant">
    <label class="flex items-center justify-between gap-2">Role<select id="role" class="rounded-md border border-outline bg-white px-2 py-1 text-on-surface"><option value="coordinator">Coordinator</option><option value="lecturer">Lecturer</option><option value="leader">Student (leader)</option><option value="member">Student (member)</option></select></label>
    <label class="flex items-center justify-between gap-2">Formation<select id="win" class="rounded-md border border-outline bg-white px-2 py-1 text-on-surface"><option value="open">Open</option><option value="closed">Window ended</option><option value="off">Grouping off</option></select></label>
    <label class="flex items-center justify-between gap-2">Leftovers<select id="data" class="rounded-md border border-outline bg-white px-2 py-1 text-on-surface"><option value="both">Groups + students</option><option value="students">Only students</option><option value="clean">None</option><option value="empty">No groups yet</option></select></label>
    <label class="flex items-center justify-between gap-2">Student's group<select id="grp" class="rounded-md border border-outline bg-white px-2 py-1 text-on-surface"><option value="none">No group</option><option value="notconf">Not confirmed</option><option value="conf">Confirmed, no proposal</option><option value="pending">Proposal pending</option><option value="approved">Proposal approved</option><option value="redo">Proposal redo</option><option value="rejected">Proposal rejected</option></select></label>
  </div>
</details>

<!-- Header (shared/_header) -->
<header class="sticky top-0 z-40 bg-surface-tint flex items-center justify-between gap-3 px-4 py-2" style="min-height: var(--spacing-header);">
  <div class="flex items-center gap-2 min-w-0 flex-1">
    <button type="button" aria-label="Toggle sidebar" aria-controls="app-sidebar" class="shrink-0 h-10 w-10 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant transition-colors">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <div class="hidden sm:flex sm:items-center sm:min-w-0">
      <a href="#" class="shrink-0 text-[1.5rem] leading-8 font-normal text-on-surface-variant hover:text-on-surface transition-colors no-underline whitespace-nowrap" style="font-family: 'DM Sans',Roboto,Arial,sans-serif">ProPro</a>
      <svg class="mx-2 text-on-surface-variant/60" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      <span class="text-[1rem] font-medium text-on-surface">COMP6000</span>
    </div>
    <span class="sm:hidden truncate text-[17px] text-on-surface font-medium min-w-0">COMP6000</span>
  </div>
  <div class="flex items-center gap-1 shrink-0">
    <button class="hidden sm:block text-[15px] font-medium text-on-surface-variant hover:text-on-surface transition-colors pr-2 bg-transparent border-0 cursor-pointer">Log out</button>
  </div>
</header>

<div class="text-on-surface font-['Roboto',sans-serif]">
  <div class="flex">
    <!-- Sidebar (shared/_sidebar) -->
    <aside id="app-sidebar" class="group/sidebar w-[280px] shrink-0 py-3 bg-surface-tint fixed top-0 left-0 h-full z-50 -translate-x-full transition-[transform,width] duration-200 ease-out lg:sticky lg:top-header lg:translate-x-0 lg:h-[calc(100vh-var(--spacing-header))] lg:self-start lg:overflow-y-auto" data-collapsed="false">
      <nav class="flex flex-col gap-1 pr-3">
        <a href="#" class="group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors rounded-r-full text-on-surface hover:bg-white/60" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;">
          <span class="material-symbols-outlined">home</span><span>Home</span>
        </a>
        <div>
          <div class="px-6 py-2 flex items-center justify-between text-on-surface-variant cursor-pointer">
            <span style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;">Enrolled</span>
            <span class="material-symbols-outlined text-sm">expand_less</span>
          </div>
          <a href="#" class="group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors rounded-r-full bg-white/70 text-on-surface" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" aria-label="COMP6000">
            <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold shrink-0">C</div>
            <span class="truncate">COMP6000</span>
          </a>
          <div class="py-2"><div class="border-t border-outline"></div></div>
        </div>
        <a href="#" class="group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors rounded-r-full text-on-surface hover:bg-white/60" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" aria-label="Edit profile">
          <span class="material-symbols-outlined text-on-surface-variant">person</span><span>Edit profile</span>
        </a>
        <form class="m-0 w-full" action="#" method="post" onsubmit="return false">
          <button type="submit" class="group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors rounded-r-full text-on-surface hover:bg-white/60 w-full text-left bg-transparent border-0 cursor-pointer" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" aria-label="Log out">
            <span class="material-symbols-outlined text-on-surface-variant">logout</span><span>Log out</span>
          </button>
        </form>
      </nav>
    </aside>

    <!-- Main -->
    <main class="flex-1 bg-white rounded-tl-panel overflow-x-hidden overflow-y-auto h-[calc(100vh-var(--spacing-header))]">
      <div class="border-b border-outline-variant px-4 sm:px-8 bg-white shrink-0 sticky top-0 z-20">
        <div class="flex items-center justify-between">
          <nav data-testid="content-tabs" id="tabs" class="flex flex-nowrap gap-x-2" aria-label="Course sections"></nav>
          <div id="tabtools" class="flex items-center gap-1 shrink-0"></div>
        </div>
      </div>
      <div class="max-w-5xl mx-auto px-6 py-8"><div id="flash"></div><div id="panel"></div></div>
    </main>
  </div>
</div>
<div id="modal"></div>
<script>
/* ============ OVERVIEW TAB MOCKUP: standalone. Sample data + state only; the markup mirrors courses/_overview_tab. ============ */
const S={role:'coordinator',win:'open',grp:'none',data:'both'}, COL=new Set(['topics']);
const CLOSES='30 Nov';                                        /* sample date */
const $=id=>document.getElementById(id), ic=(n,c='')=>`<span class="material-symbols-outlined ${c}" aria-hidden="true">${n}</span>`;
const pl=(n,w)=>n+' '+w+(n==1?'':'s'), cap=t=>t[0].toUpperCase()+t.slice(1);
const DM="font-family:'DM Sans',Roboto,Arial,sans-serif";
const isOpen=()=>S.win==='open', student=()=>S.role==='leader'||S.role==='member', staff=()=>S.role==='coordinator';
const CNT=()=>({both:{total:7,nc:2,ug:4},students:{total:5,nc:0,ug:4},clean:{total:5,nc:0,ug:0},empty:{total:0,nc:0,ug:12}})[S.data];
const banner=()=>{const c=CNT();return staff()&&!isOpen()&&(c.nc>0||c.ug>0)};
const bMsg=()=>{const {nc:a,ug:u}=CNT();let t='<b class="font-medium">Group formation is closed.</b>';if(a)t+=` ${a>1?a+' groups are':'1 group is'} not confirmed, so their members cannot submit a proposal. Review and confirm them.`;if(u)t+=(a?'<br>':' ')+`${pl(u,'student')} ${u>1?'are':'is'} not in a group.`;return t};
const go=t=>`alert('→ ${t}')`, toGroups=f=>`alert('→ Groups tab (filter: ${f})')`;

/* Student's own group (sample) */
const MY=()=>{if(!student()||S.grp==='none')return null;return S.grp==='notconf'?{n:'Tmp002',c:0,m:['Nur Sabrina','Daniel Tan','Mei Ling']}:{n:'G003',c:1,m:['Zack Lim','Amir Faiz','Nina Ooi']}};

/* ===== shared building blocks (mirror shared/_list_item, _empty_state, courses/_section_header, group_formations/_status_pill) ===== */
const BTN='inline-flex items-center justify-center rounded-full font-medium transition-colors cursor-pointer ';
const FILL=BTN+'bg-primary-strong px-5 py-2 text-sm text-white hover:bg-primary-hover', OUTLINE=BTN+'border border-outline px-5 py-2 text-sm text-primary-strong hover:bg-primary-container',
 /* styleguide §5 secondary pill ("Discard Changes") */
 SECONDARY='inline-flex items-center justify-center rounded-full border border-outline px-5 py-2.5 text-[14px] font-medium text-on-surface-variant transition-colors cursor-pointer hover:bg-surface-variant hover:text-on-surface',
 /* repo text button (same classes as the Overview "Collapse all" button) */
 TEXT='inline-flex items-center gap-1 rounded-md px-3 py-2 text-[14px] font-medium text-primary transition-colors cursor-pointer hover:bg-primary-container';
const pill=c=>c?`<span class="inline-flex rounded bg-success-container px-2.5 py-0.5 text-[12px] font-medium tracking-wide text-success">Confirmed</span>`
 :`<span class="inline-flex whitespace-nowrap rounded bg-surface-variant px-2.5 py-0.5 text-[12px] font-medium tracking-wide text-on-surface-variant">Not confirmed</span>`;
const PILL={approved:['bg-success-container','text-success'],pending:['bg-primary-container','text-primary-soft'],redo:['bg-warning-container','text-warning'],rejected:['bg-error-container','text-error']};
function li(o){
  const [pb,pf]=PILL[o.status]||['bg-surface-variant','text-on-surface-variant'];
  const meta=(o.meta||[]).concat(o.time?[o.time]:[]).map((t,i)=>(i?'<span class="shrink-0">•</span>':'')+`<span class="${i?'whitespace-nowrap':'max-w-full truncate'}">${t}</span>`).join('');
  return `<a href="#" onclick="${o.go||''};return false" class="group flex w-full cursor-pointer flex-col bg-white px-4 py-3 transition-colors hover:bg-surface-variant ${o.top===false?'':'border-t border-outline-variant'}">
   <div class="flex w-full min-w-0 items-start gap-4 sm:items-center"><div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-variant sm:mt-0 ${pf}">${ic(o.icon,'text-[20px]')}</div>
   <div class="flex w-full min-w-0 flex-col justify-between gap-2 sm:flex-row sm:items-center sm:gap-4"><div class="min-w-0 flex-1">
    <h3 style="${DM};font-size:1rem;font-weight:400;line-height:1.5rem" class="mb-0.5 truncate text-on-surface-strong">${o.title}</h3>
    <div style="${DM}" class="mt-0.5 flex flex-wrap items-center gap-2 text-[13px] text-on-surface-muted sm:mt-0 sm:flex-nowrap">${meta}</div></div>
    <div class="flex shrink-0 items-center gap-1 sm:gap-3"><span class="${pb} ${pf} whitespace-nowrap rounded px-2.5 py-0.5 text-[12px] font-medium tracking-wide">${o.pill}</span><span class="hidden shrink-0 items-center justify-center rounded-full p-1.5 text-on-surface-variant sm:flex">${ic('more_vert','text-[20px]')}</span></div></div></div>${o.extra||''}</a>`;
}
const hdr=(t,right)=>`<div class="box-border flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-outline-variant p-6"><h2 class="min-w-0 truncate text-[22px] font-normal text-on-surface-strong">${t}</h2>${right||''}</div>`;
const csec=(id,t,rows,empty)=>`<div class="mb-12"><div role="button" tabindex="0" onclick="COL.has('${id}')?COL.delete('${id}'):COL.add('${id}');draw()" class="group box-border flex cursor-pointer items-center justify-between border-b border-outline-variant p-6"><h2 class="min-w-0 truncate text-[22px] font-normal text-on-surface-strong">${t}</h2>
 <div class="flex shrink-0 items-center gap-3"><span class="text-[15px] font-medium text-primary">${rows.length}</span><span class="material-symbols-outlined text-on-surface-variant transition-all group-hover:text-on-surface-strong ${COL.has(id)?'rotate-180':''}">expand_less</span></div></div>
 ${COL.has(id)?'':rows.length?`<div class="flex flex-col border-b border-outline-variant">${rows.map((r,i)=>li({...r,top:i>0})).join('')}</div>`:`<div class="border-b border-outline-variant px-4 py-3 text-[14px] font-medium leading-5 text-on-surface-variant">${empty}</div>`}</div>`;
/* shared/_empty_state: each state has its own illustration */
const emp=(img,h,d,cta)=>`<div class="flex flex-col items-center gap-3 px-6 py-14 text-center"><img src="${ILLUS[img]}" alt="" class="pointer-events-none h-[180px] w-auto select-none"><h3 class="text-[16px] font-medium text-on-surface-strong">${h}</h3><p class="max-w-[360px] text-[14px] text-on-surface-variant">${d}</p>${cta?`<button onclick="${cta[1]}" class="mt-2 inline-flex items-center justify-center rounded-full bg-primary-strong px-5 py-2 text-[14px] font-medium text-white transition-colors hover:bg-primary-hover">${cta[0]}</button>`:''}</div>`;
const SUP=[{icon:'assignment_turned_in',title:'Smart Home Automation System',meta:['G001'],time:'Updated 2 days ago',status:'approved',pill:'Approved'},{icon:'assignment',title:'Machine Learning Stock Predictor',meta:['G004'],time:'Submitted 5 days ago',status:'pending',pill:'Pending'},{icon:'history',title:'IoT-Based Environmental Monitoring',meta:['G003'],time:'Returned 7 days ago',status:'redo',pill:'Redo'}];
const PEND=[{icon:'assignment',title:'AI-Powered Exam Scheduling Optimizer',meta:['G002'],time:'Submitted 1 day ago',status:'pending',pill:'Pending'}];

/* ===== STAFF: Group formation. Section header (title + status pill + secondary Settings pill) and ONE quiet block:
   a headline, a thin progress bar and a muted meta line, with one text link on the right. No card, no tiles, no list item.
   The amber variant REPLACES the block, so the slot only ever holds one thing. ===== */
function formation(){
  const c=CNT(), open=isOpen(), off=S.win==='off', empty=c.total===0, conf=c.total-c.nc;
  const status=`<span class="inline-flex whitespace-nowrap rounded px-2.5 py-0.5 text-[12px] font-medium tracking-wide ${open?'bg-success-container text-success':'bg-surface-variant text-on-surface-variant'}">${open?'Open':off?'Off':'Closed'}</span>`;
  const settings=staff()?`<button onclick="${go('/settings#grouping')}" class="${SECONDARY}">Settings</button>`:'';
  const head=hdr('Group formation',`<div class="flex shrink-0 items-center gap-3">${status}${settings}</div>`);
  const num=n=>`<b class="font-medium">${n}</b>`;
  const BLOCK='flex flex-col gap-3 border-b border-outline-variant px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6';
  const LINK=`${TEXT} shrink-0 self-start sm:self-center`;
  let row;
  if(!open&&empty){
    /* Off (or ended) with no groups */
    row=`<div class="${BLOCK} !py-3 text-[14px] leading-5"><p class="text-on-surface-variant">${staff()?'Group formation is closed. Enable it to let students form groups.':'Group formation is closed.'}</p>${staff()?`<button onclick="${go('/settings#grouping')}" class="${LINK}">Open settings</button>`:''}</div>`;
  } else if(banner()){
    /* Needs attention (coordinator only): amber treatment, replaces the block */
    row=`<div class="flex flex-col gap-3 border-b border-warning-border bg-warning-container-alt px-4 py-4 text-[14px] leading-5 text-warning-on-container sm:flex-row sm:items-center" role="status">${ic('warning','shrink-0 text-[20px] text-warning')}<div class="min-w-0 flex-1">${bMsg()}</div>${c.nc?`<button onclick="${toGroups('notconf')}" class="shrink-0 self-start rounded-full border border-warning-border bg-white px-5 py-2 text-[14px] font-medium text-warning-on-container transition-colors hover:bg-amber-50 sm:self-center">Review groups</button>`:''}</div>`;
  } else {
    /* Normal: headline + progress + meta */
    let title, bar='';
    if(!staff()&&open) title='Students are forming groups.';
    else if(empty) title='No groups yet';
    else if(c.nc===0) title=c.total==1?`${num(1)} group, confirmed`:`All ${num(c.total)} groups confirmed`;
    else title=`${num(conf)} of ${num(c.total)} groups confirmed`;
    if(!(!staff()&&open)&&!empty){const pct=Math.round(conf/c.total*100);
      bar=`<div class="mt-3 h-1.5 w-full max-w-[360px] overflow-hidden rounded-full bg-surface-variant" role="progressbar" aria-label="Confirmed groups" aria-valuemin="0" aria-valuemax="${c.total}" aria-valuenow="${conf}"><div class="h-full rounded-full bg-primary-strong" style="width:${pct}%"></div></div>`}
    const meta=[];
    if(!(!staff()&&open)){ if(c.ug>0) meta.push(`${num(c.ug)} ${c.ug==1?"student isn't":"students aren't"} in a group yet`); else if(!empty) meta.push('Every student is in a group'); }
    if(open) meta.push(`Open until ${CLOSES}`);
    const metaHtml=meta.length?`<p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[13px] text-on-surface-muted">${meta.map((m,i)=>(i?'<span aria-hidden="true">•</span>':'')+`<span>${m}</span>`).join('')}</p>`:'';
    row=`<div class="${BLOCK}"><div class="min-w-0 flex-1"><p style="${DM}" class="text-[16px] leading-6 text-on-surface-strong [&_b]:font-medium">${title}</p>${bar}${metaHtml}</div><button onclick="${open?go('/group_formation'):toGroups('all')}" class="${LINK}">${open?'Open group formation':'View groups'}</button></div>`;
  }
  return `<div class="mb-12" id="group-formation">${head}${row}</div>`;
}

/* ===== STUDENT: My Group (state-dependent) =====
   Not confirmed -> full tinted card (name, pill, hint, chips, one action); nothing else below it.
   Confirmed     -> NO card, NO pill, NO green: one slim untinted line (h-14), My Submission directly under it. */
function myGroup(g){
  if(g.c){
    /* Confirmed: no card, no pill, no green. Styled like OWNERS on projects/show (_project_overview): 11px uppercase label + rounded-full chips. */
    const open=isOpen();
    const chips=g.m.map(n=>`<span class="inline-flex max-w-full items-center gap-2 rounded-full border border-outline-variant bg-surface py-1 pl-1 pr-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-surface-variant-deep text-[11px] font-medium text-on-surface">${n[0]}</span><span class="min-w-0 truncate text-[13px] text-on-surface">${n}</span></span>`).join('');
    return `<div class="mb-4 flex flex-col gap-3 border-b border-outline-variant px-4 pb-4 sm:flex-row sm:items-start sm:justify-between" id="my-group" data-testid="my-group-line">
     <div class="min-w-0"><div class="mb-2 text-[11px] font-medium uppercase tracking-wider text-on-surface-variant">My group <span class="text-on-surface-muted">· ${g.n}</span></div><div class="flex flex-wrap gap-2">${chips}</div></div>
     <button onclick="${open?go('/group_formation'):go('/groups/3 (Group Profile)')}" class="${TEXT} shrink-0 self-start">View group</button></div>`;
  }
  const open=isOpen(), leader=S.role==='leader';
  const hint=open?(leader?'Confirm the group once its members are final. Only a confirmed group can start a proposal.':'Waiting for your leader to confirm. Only a confirmed group can start a proposal.')
    :`Group formation is closed, so ${g.n} can't be confirmed by its members. Contact your coordinator.`;
  const chips=g.m.map((n,i)=>`<div class="inline-flex max-w-full items-center gap-2 rounded-full border border-outline-variant bg-surface py-1 pl-1 pr-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-surface-variant-deep text-[11px] font-medium text-on-surface">${n[0]}</span><span class="min-w-0 break-words py-0.5 text-[13px] leading-4 text-on-surface">${n}</span>${i===0?'<span class="shrink-0 text-[11px] text-on-surface-muted">Leader</span>':''}</div>`).join('');
  const act=open?(leader?`<button onclick="${go('/group_formation')}" class="${FILL} max-sm:w-full">Review and confirm</button>`:`<button onclick="${go('/group_formation')}" class="${OUTLINE} max-sm:w-full">View group</button>`):'';
  return `<div class="mb-12" id="my-group">${hdr('My Group')}
   <section data-testid="my-group-panel" class="mt-5 rounded-lg border border-outline-variant bg-primary-container-alt p-4 sm:p-6"><div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
    <div class="min-w-0 md:flex-1"><div class="flex flex-wrap items-center gap-x-3 gap-y-1"><h3 style="${DM}" class="text-xl font-medium text-on-surface-strong">${g.n}</h3>${pill(false)}</div>
     <p class="mt-1.5 flex items-start gap-1.5 text-sm leading-5 text-on-surface-variant">${!open?ic('warning','mt-0.5 shrink-0 text-[14px] leading-none text-warning'):''}<span class="min-w-0">${hint}</span></p>
     <div class="mt-4 sm:mt-5"><div class="mb-2 flex items-baseline gap-2"><span class="text-[11px] font-medium uppercase tracking-wider text-on-surface-variant">MEMBERS</span><span class="text-[13px] text-on-surface-muted">${g.m.length} of 5</span></div><div class="flex flex-wrap gap-2">${chips}</div></div></div>
    ${act?`<div class="flex flex-col items-stretch gap-2 sm:flex-row sm:flex-wrap sm:items-center md:shrink-0 md:flex-nowrap">${act}</div>`:''}</div></section></div>`;
}

/* ===== OVERVIEW ===== */
function overview(){
  const det=`<section id="proposal-guidelines" class="mb-4"><div class="w-full overflow-hidden rounded-[8px]"><div class="relative overflow-hidden px-8 py-9" style="background:linear-gradient(135deg,var(--color-primary-container-alt) 0%,var(--color-primary-container) 100%)"><img src="${ILLUS.banner}" alt="" class="pointer-events-none absolute bottom-[-70px] right-[-70px] h-[260px] w-auto select-none">
   <h4 class="relative z-10 max-w-[62%] text-2xl font-medium text-on-surface-strong">Project Details</h4><p class="relative z-10 mt-1 max-w-[62%] text-[14px] text-on-surface-variant">COMP6000</p></div>
   <div class="bg-surface-tint p-6"><p class="break-words text-[0.9rem] leading-[1.5] text-on-surface-variant sm:text-[1rem]">Final-year project. Form a group, agree a topic with a supervisor and submit one proposal for your group.</p></div></div></section>`;
  let body='';
  if(!student()){
    const ids=staff()?['sup','pend','rev','topics']:['sup','pend','rev'], allc=ids.every(i=>COL.has(i));
    body=`${formation()}
     <div><div class="mb-10 flex justify-end"><button onclick="${allc?`COL.clear()`:`${JSON.stringify(ids).replace(/"/g,"'")}.forEach(i=>COL.add(i))`};draw()" class="flex items-center gap-2 rounded-md px-3 py-2 text-[14px] font-medium text-primary transition-colors hover:bg-primary-container">${ic(allc?'unfold_more':'unfold_less','text-[20px]')}<span>${allc?'Expand all':'Collapse all'}</span></button></div>
     ${csec('sup','Supervised Projects',SUP,'Projects that are approved by you will appear here.')}${csec('pend','Pending Proposals',PEND,'Proposals that are pending review from you will appear here.')}${csec('rev','Reviewed Proposals',[],'Proposals that you previously rejected and returned.')}${staff()?csec('topics','Pending Topics',[],'Topics that are pending review from you will appear here.'):''}</div>`;
  } else {
    const g=MY(), sub=['pending','approved','redo','rejected'].includes(S.grp)?S.grp:null; let sec='';
    if(!g) sec=`<div class="mb-12" id="my-submission">${hdr('My Submission')}${isOpen()
      ?emp('together',"You're not in a group yet",'Join or create a group before you can put together a project proposal.',['Find or create a group',go('/group_formation')])
      :emp('closed','Group formation is closed','Contact your coordinator if you are not in a group yet.')}</div>`;
    else if(g.c) sec=`<div class="mb-12" id="my-submission">${hdr('My Submission')}${sub
      ?`<div class="flex flex-col border-b border-outline-variant">${li({icon:{approved:'assignment_turned_in',pending:'assignment',redo:'history',rejected:'block'}[sub],title:'Smart Home Automation System',meta:[g.n],time:{approved:'Updated',pending:'Submitted',redo:'Returned',rejected:'Rejected'}[sub]+' 2 days ago',status:sub,pill:cap(sub),top:false,
        extra:sub==='redo'?`<div class="mt-2 border-t border-dashed border-outline-variant pl-[3.25rem] pt-2 text-[13px] text-on-surface-variant">Your coordinator asked for changes — open the proposal to see their comments and resubmit.</div>`:''})}</div>`
      :emp('noProposal','No proposal submitted yet',"Your group hasn't submitted a project proposal. Once it's in, you'll see its review status here.",['Create proposal',go('projects/new')])}</div>`;
    /* Not confirmed: My Submission is hidden entirely; the My Group card carries the next step */
    body=(g?myGroup(g):'')+sec;
  }
  return `<div class="mx-auto max-w-[800px]">${det}${body}</div>`;
}

/* ===== shell ===== */
function draw(){
  const tab=(slug,name)=>{const sel=slug==='overview';return `<a href="#" id="tab-${slug}" ${sel?'aria-current="page"':''} onclick="return false" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;" class="group h-[3rem] pt-[0.125rem] px-3 sm:px-6 flex items-center justify-center relative box-border whitespace-nowrap tracking-wide antialiased transition-colors ${sel?'text-primary-strong':'text-on-surface-variant hover:bg-surface-hover hover:text-on-surface'}">${name}<div class="absolute bottom-0 left-0 w-full h-[3px] rounded-t-[3px] transition-colors ${sel?'bg-primary-strong':'bg-transparent'}"></div></a>`};
  $('tabs').innerHTML=tab('overview','Overview')+tab('topics','Topics')+tab('people','People')+tab('groups','Groups');
  $('tabtools').innerHTML=staff()?`<a href="#" class="hidden lg:flex h-[3rem] w-[2.5rem] items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant transition-colors shrink-0" title="Edit Project Templates"><span class="material-symbols-outlined">edit_note</span></a><a href="#" class="hidden lg:flex h-[3rem] w-[3rem] items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant transition-colors shrink-0" title="Settings"><span class="material-symbols-outlined">settings</span></a>`:'';
  $('panel').innerHTML=overview();
}
['role','win','grp','data'].forEach(k=>$(k).onchange=e=>{S[k]=e.target.value;draw()});
</script>
<script>
/* Illustrations. Embedded so the file opens standalone. In the app these are image_tag "illustrations/<file>.svg":
   banner=project_details_banner, together=scene_5, closed=topics_disabled_banner, noProposal=submission_empty_banner */
const ILLUS={"banner": "data:image/svg+xml;base64,", "together": "data:image/svg+xml;base64,", "closed": "data:image/svg+xml;base64,", "noProposal": "data:image/svg+xml;base64,"};
draw();
</script>
</body>
</html>
