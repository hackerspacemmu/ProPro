                        <span class="material-symbols-outlined text-[20px] text-on-surface-variant">more_vert</span>
                      </div>
                    </a>
                  </div>
                </div>

                <!-- Pending Proposals -->
                <div class="mb-12" id="pending-proposals">
                  <div class="flex items-center justify-between p-6 box-border border-b border-outline-variant cursor-pointer group" role="button" tabindex="0">
                    <h2 class="truncate min-w-0 text-[22px] font-normal text-on-surface-strong">Pending Proposals</h2>
                    <div class="flex items-center gap-3 shrink-0">
                      <span class="text-primary font-medium text-[15px]">1</span>
                      <span class="material-symbols-outlined text-on-surface-variant group-hover:text-on-surface-strong transition-all">expand_less</span>
                    </div>
                  </div>
                  <div class="flex flex-col border-b border-outline-variant">
                    <a href="#" class="flex items-start justify-between py-4 px-4 hover:bg-surface-variant/40 transition-colors border-b border-outline-variant/50 last:border-b-0">
                      <div class="flex items-start gap-4 min-w-0 flex-1">
                        <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-primary shrink-0">
                          <span class="material-symbols-outlined text-[20px]">description</span>
                        </div>
                        <div class="flex-1 min-w-0">
                          <p class="text-[14px] font-medium text-on-surface truncate">AI-Powered Exam Scheduling Optimizer</p>
                          <div class="flex items-center gap-2 mt-1 flex-wrap">
                            <span class="text-[13px] text-on-surface-variant">Debug Dynamos</span>
                            <span class="text-[13px] text-on-surface-variant">•</span>
                            <span class="text-[13px] text-on-surface-variant">Submitted 1 day ago</span>
                          </div>
                        </div>
                      </div>
                      <div class="flex items-center gap-3 shrink-0">
                        <span class="text-[13px] font-medium px-2 py-0.5 rounded-full" style="background-color: #d2e3fc; color: #1a73e8;">Pending</span>
                        <span class="material-symbols-outlined text-[20px] text-on-surface-variant">more_vert</span>
                      </div>
                    </a>
                  </div>
                </div>

                <!-- Reviewed Proposals -->
                <div class="mb-12" id="reviewed-proposals">
                  <div class="flex items-center justify-between p-6 box-border border-b border-outline-variant cursor-pointer group" role="button" tabindex="0">
                    <h2 class="truncate min-w-0 text-[22px] font-normal text-on-surface-strong">Reviewed Proposals</h2>
                    <div class="flex items-center gap-3 shrink-0">
                      <span class="text-primary font-medium text-[15px]">0</span>
                      <span class="material-symbols-outlined text-on-surface-variant group-hover:text-on-surface-strong transition-all">expand_less</span>
                    </div>
                  </div>
                  <div class="border-b border-outline-variant">
                    <div class="py-3 px-4 text-[14px] font-medium leading-5 tracking-normal text-on-surface-variant">Proposals that you previously rejected and returned.</div>
                  </div>
                </div>

                <!-- Pending Topics -->
                <div class="mb-12" id="pending-topics">
                  <div class="flex items-center justify-between p-6 box-border border-b border-outline-variant cursor-pointer group" role="button" tabindex="0">
                    <h2 class="truncate min-w-0 text-[22px] font-normal text-on-surface-strong">Pending Topics</h2>
                    <div class="flex items-center gap-3 shrink-0">
                      <span class="text-primary font-medium text-[15px]">0</span>
                      <span class="material-symbols-outlined text-on-surface-variant group-hover:text-on-surface-strong transition-all">expand_less</span>
                    </div>
                  </div>
                  <div class="border-b border-outline-variant">
                    <div class="py-3 px-4 text-[14px] font-medium leading-5 tracking-normal text-on-surface-variant">Topics that are pending review from you will appear here.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    const roleSwitcher = document.getElementById('role-switcher');
    const mySubmission = document.getElementById('my-submission');
    const mySubmissionNoGroup = document.getElementById('my-submission-no-group');
    const mySubmissionNoProposal = document.getElementById('my-submission-no-proposal');
    const mySubmissionPending = document.getElementById('my-submission-pending');
    const lecturerSections = document.getElementById('lecturer-sections');

    function updateView() {
      const role = roleSwitcher.value;
      
      // Hide all
      mySubmission.classList.add('hidden');
      mySubmissionNoGroup.classList.add('hidden');
      mySubmissionNoProposal.classList.add('hidden');
      mySubmissionPending.classList.add('hidden');
      lecturerSections.classList.remove('hidden');
      
      if (role === 'lecturer') {
        lecturerSections.classList.remove('hidden');
      } else if (role === 'student-no-project') {
        lecturerSections.classList.add('hidden');
        mySubmission.classList.remove('hidden');
        mySubmissionNoGroup.classList.remove('hidden');
      } else if (role === 'student-pending') {
        lecturerSections.classList.add('hidden');
        mySubmission.classList.remove('hidden');
        mySubmissionPending.classList.remove('hidden');
      }
    }

    roleSwitcher.addEventListener('change', updateView);
    updateView();
  </script>
</body>
</html>
