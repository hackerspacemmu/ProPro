           data-action="click->sidebar#close"></div>

      <!-- ============================================================== -->
      <!-- MAIN CONTENT (Internal scroll, top-left radius, white bg)      -->
      <!-- ============================================================== -->
      <main class="flex-1 bg-white rounded-tl-panel border-t border-l border-outline-variant overflow-x-hidden overflow-y-auto h-[calc(100vh-var(--spacing-header))]">

        <!-- Centered reading column (Classroom-style) inside the scrollable panel -->
        <div class="w-[95%] max-w-5xl mx-auto pt-8 pb-16 flex flex-col min-h-full">

          <div class="space-y-12 flex-grow">

            <!-- ╔══════════════════════════════════════════════════════════╗ -->
            <!-- ║  STUDENT PROFILE  (participant_type == 'student')        ║ -->
            <!-- ╚══════════════════════════════════════════════════════════╝ -->
            <div>
              <span class="block mb-4 text-[12px] font-medium text-on-surface-variant uppercase tracking-wide">View Student</span>

