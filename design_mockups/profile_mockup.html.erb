            <span class="text-on-surface-strong font-medium text-[1rem] leading-6 break-all"
                  style="font-family: 'DM Sans',Roboto,Arial,sans-serif">student1</span>
          </nav>
        </div>

        <!-- Mobile only: course name, truncated -->
        <span class="sm:hidden truncate text-[17px] text-on-surface-strong font-medium min-w-0">student1</span>
      </div>

      <div class="flex items-center gap-1 shrink-0">
        <form class="hidden sm:block m-0" action="/session" method="post">
