<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>COMP6000 - Group formation | ProPro</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{--spacing-header:3.5rem}
  body{font-family:'Roboto',Arial,sans-serif}
  .dm{font-family:'DM Sans',Roboto,Arial,sans-serif}

  /* Main scroll pane: dvh so mobile browser bars don't cut it off */
  .pane{height:calc(100vh - var(--spacing-header));height:calc(100dvh - var(--spacing-header))}

  /* Modal card: full screen on mobile, auto height from sm up */
  .modal-card{height:100vh;height:100dvh}
  @media (min-width:640px){.modal-card{height:auto}}

  /* Bell popup: full-width panel under the header on mobile, anchored dropdown from sm up */
  #bellPop{position:fixed;left:8px;right:8px;top:calc(var(--spacing-header) + 4px);max-height:70vh;overflow-y:auto}
  @media (min-width:640px){#bellPop{position:absolute;left:auto;right:0;top:48px;width:340px;max-height:80vh}}

  /* ---------- Groups table (desktop / tablet: real table, one tbody per group) ---------- */
  #tbl tbody.grp tr.main>td{border-top:1px solid #e5e7eb}
  #tbl tbody.grp tr.detail>td{border-top:1px solid #f3f4f6}
  #tbl tbody.grp.invalid{background:#fffbeb}
  #tbl tbody.grp:not(.invalid) tr.main:hover{background:#f9fafb}
  #tbl tbody.grp:not(.invalid) tr.detail{background:rgba(249,250,251,.5)}

  /* ---------- Below 640px: each group becomes its own card ---------- */
  @media (max-width:639px){
    input,select{font-size:16px!important}               /* stops iOS zoom on focus */
    input[type=text],select{min-height:44px}
    #modal button,#dlg button,#bellPop button{min-height:44px}
    #modalFoot{padding-bottom:max(12px,env(safe-area-inset-bottom))}
    .modal-card{padding-top:env(safe-area-inset-top,0px)}
    .foot-left button{flex:1 1 auto}

    #tbl{display:block}
    #tbl thead{display:none}
    #tbl tbody.grp{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 12px;align-items:center;
      padding:12px 16px;margin-bottom:12px;background:#fff;border:1px solid #e5e7eb;border-radius:8px}
    #tbl tbody.grp.invalid{background:#fffbeb;border-color:#fde68a}
    #tbl tr.main{display:contents}                         /* cells become grid items of the card */
    #tbl td{display:block;padding:0!important;border:0!important;box-shadow:none!important}
    #tbl td[data-empty]{display:none}
    #tbl .c-g{order:1;grid-column:1}
    #tbl .c-s{order:2;grid-column:2;justify-self:end}
    #tbl .c-m{order:3;grid-column:1/-1}
    #tbl tr.detail{display:block;order:4;grid-column:1/-1;padding-top:12px;border-top:1px solid #e5e7eb}
    #tbl tr.detail.hidden{display:none}
    #tbl .c-a{order:5;grid-column:1/-1}
    #tbl .act-btn{width:100%;min-height:44px}
    #tbl .cancel-link{min-height:44px}
  }
</style>
<script>
tailwind.config={theme:{extend:{
  borderRadius:{panel:'1.75rem'},
  minHeight:{header:'var(--spacing-header)'},
  spacing:{header:'var(--spacing-header)'},
  colors:{
    'surface-tint':'#f8f9fa','surface':'#ffffff','surface-variant':'#f3f4f6','surface-variant-deep':'#e5e7eb','surface-hover':'#f3f4f6',
    'on-surface':'#1f2937','on-surface-variant':'#4b5563','on-surface-muted':'#6b7280',
    primary:'#2563eb','primary-strong':'#2563eb','primary-hover':'#1d4ed8','primary-container':'#eff6ff','primary-container-alt':'#dbeafe',
    outline:'#e5e7eb','outline-variant':'#e5e7eb',
    'error-container':'#fef2f2','success-container':'#f0fdf4',
    'warning-container-alt':'#fffbeb','warning-strong':'#f59e0b'
  }
}}};
</script>
</head>
<body class="bg-surface-tint text-on-surface m-0 p-0 overflow-hidden">

<!-- Header (mirrors shared/_header) -->
<header class="sticky top-0 z-40 bg-surface-tint flex items-center justify-between gap-3 px-4 py-1.5 sm:py-2 min-h-header">
  <div class="flex items-center gap-2 min-w-0 flex-1">
    <button id="menuBtn" type="button" aria-label="Toggle sidebar" aria-controls="app-sidebar" class="shrink-0 h-11 w-11 sm:h-10 sm:w-10 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant transition-colors">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <!-- Desktop only: breadcrumb row -->
    <div class="hidden sm:flex sm:items-center sm:min-w-0">
      <a href="#" class="dm shrink-0 text-[1.5rem] leading-8 font-normal text-on-surface-variant hover:text-on-surface transition-colors no-underline whitespace-nowrap">ProPro</a>
      <span class="material-symbols-outlined text-gray-400 mx-1 text-sm">chevron_right</span>
      <span class="text-[15px] font-medium text-gray-900 truncate">COMP6000</span>
    </div>
    <!-- Mobile only: course name -->
    <span class="sm:hidden truncate text-[17px] text-on-surface font-medium min-w-0">COMP6000</span>
  </div>
  <div class="flex items-center gap-1 shrink-0">
    <div id="bellWrap" class="relative">
      <button id="bellBtn" type="button" aria-label="Notifications" class="relative h-11 w-11 sm:h-10 sm:w-10 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant transition-colors">
        <span class="material-symbols-outlined">notifications</span>
        <span id="bellBadge" class="hidden absolute top-1 right-1 min-w-[16px] h-4 px-1 rounded-full bg-red-500 text-white text-[11px] font-medium items-center justify-center"></span>
      </button>
      <div id="bellPop" class="hidden bg-white border border-gray-200 rounded-lg shadow-lg z-50"></div>
    </div>
    <!-- Desktop only: log out -->
    <button type="button" class="hidden sm:block m-0 text-[15px] font-medium text-on-surface-variant hover:text-on-surface transition-colors pr-2 bg-transparent border-0 cursor-pointer">Log out</button>
    <!-- Mobile only: coordinator icons -->
    <div id="mCoord" class="flex sm:hidden items-center" style="display:none">
      <a href="#" aria-label="Course settings" class="h-11 w-11 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant transition-colors"><span class="material-symbols-outlined">settings</span></a>
      <a href="#" aria-label="Edit Project Templates" class="h-11 w-11 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant transition-colors"><span class="material-symbols-outlined">edit_note</span></a>
    </div>
  </div>
</header>

<div class="flex">
  <!-- Sidebar (mirrors shared/_sidebar: off-canvas below lg, collapsible rail at lg) -->
  <aside id="sidebar"
         class="group/sidebar
           w-[280px] shrink-0 py-3 bg-surface-tint overflow-y-auto
           fixed top-0 left-0 h-full z-50 -translate-x-full transition-[transform,width] duration-200 ease-out
           lg:sticky lg:top-header lg:translate-x-0 lg:h-[calc(100vh-var(--spacing-header))] lg:self-start lg:overflow-y-auto
           data-[collapsed=true]:lg:overflow-visible
           data-[collapsed=true]:lg:w-[72px]"
         data-collapsed="false">
    <nav id="navList" class="flex flex-col gap-1 pr-3"></nav>
  </aside>
  <div id="scrim" class="hidden fixed inset-0 bg-black/30 z-40 lg:hidden"></div>

  <!-- Main -->
  <main class="pane flex-1 min-w-0 bg-white rounded-tl-panel overflow-x-hidden overflow-y-auto">
    <div class="border-b border-outline-variant px-4 sm:px-8 bg-white shrink-0 sticky top-0 z-20 flex items-center justify-between">
      <nav class="flex flex-nowrap gap-x-2" aria-label="Course sections">
        <a href="#" aria-current="page" class="dm text-sm font-medium h-[3rem] pt-[0.125rem] px-3 sm:px-6 flex items-center justify-center relative box-border whitespace-nowrap tracking-wide antialiased text-primary-strong">
          Group formation
          <div class="absolute bottom-0 left-0 w-full h-[3px] rounded-t-[3px] bg-primary-strong"></div>
        </a>
      </nav>
      <!-- Coordinator only, sm and up (below sm the header shows them) -->
      <div id="tabIcons" class="hidden sm:flex items-center gap-1 shrink-0"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-5 sm:py-8">

      <!-- Mockup controls (not part of the product). Collapsed by default on phones. -->
      <details id="ctrls" open class="mb-5 sm:mb-6 border border-dashed border-gray-300 rounded-lg text-sm text-on-surface-variant">
        <summary class="px-4 py-3 cursor-pointer select-none font-medium text-gray-900">Mockup controls</summary>
        <div class="px-4 pb-3 grid grid-cols-1 sm:flex sm:flex-wrap sm:items-center gap-x-4 gap-y-2">
          <label class="flex items-center justify-between sm:justify-start gap-2">View as
            <select id="roleSel" class="min-w-0 max-w-[65%] sm:max-w-none bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md px-3 py-1.5 outline-none cursor-pointer">
              <option value="none">Student, no group</option>
              <option value="leader">Student, leader, not confirmed</option>
              <option value="oleader">Student, leader, group over maximum</option>
              <option value="member">Student, member, not confirmed</option>
              <option value="cleader">Student, leader, confirmed</option>
              <option value="cmember">Student, member, confirmed</option>
              <option value="coord">Coordinator</option>
              <option value="lect">Lecturer (can manage)</option>
              <option value="lectro">Lecturer (read-only)</option>
            </select>
          </label>
          <label class="flex items-center justify-between sm:justify-start gap-2">Rules
            <select id="rulesSel" class="min-w-0 max-w-[65%] sm:max-w-none bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md px-3 py-1.5 outline-none cursor-pointer">
              <option value="full">Min/max + end date</option>
              <option value="nolimit">No size limit + end date</option>
              <option value="nodate">Min/max, no end date</option>
            </select>
          </label>
          <label class="flex items-center justify-between sm:justify-start gap-2">Table
            <select id="tableSel" class="min-w-0 max-w-[65%] sm:max-w-none bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md px-3 py-1.5 outline-none cursor-pointer">
              <option value="rows">With groups</option>
              <option value="empty">Empty</option>
            </select>
          </label>
        </div>
      </details>

      <div class="flex flex-wrap items-start justify-between gap-4 mb-5 sm:mb-6">
        <div class="min-w-0">
          <h1 class="dm text-2xl sm:text-3xl font-normal text-gray-900 tracking-tight">Group formation</h1>
          <div id="rules"></div>
        </div>
        <div id="headBtn" class="w-full sm:w-auto"></div>
      </div>

      <div id="slot" class="mb-4 empty:hidden"></div>
      <div id="msg" class="mb-4 empty:hidden"></div>

      <!-- Browse groups -->
      <section>
        <div class="flex flex-col gap-4 border-b border-gray-300 pb-4 mb-4">
          <div>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h2 id="tableTitle" class="dm text-xl font-normal text-gray-900 tracking-tight">All groups</h2>
              <span id="count" class="text-sm font-medium text-gray-500"></span>
            </div>
            <p id="tableSub" class="hidden text-sm text-gray-500 mt-1">Join a group or create a new group.</p>
          </div>

          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
              <div class="relative flex items-center w-full sm:w-[240px]">
                <span class="material-symbols-outlined absolute left-3 text-gray-400 text-[18px]">search</span>
                <input type="text" id="search" name="search_query" autocomplete="off" placeholder="Search groups or students..." class="peer bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent block w-full pl-9 pr-9 py-2 transition-all outline-none">
                <kbd aria-hidden="true" class="hidden md:flex peer-focus:hidden absolute right-3 top-1/2 -translate-y-1/2 items-center justify-center h-5 min-w-[1.25rem] px-1 rounded border border-outline-variant bg-gray-50 text-[11px] font-mono text-gray-400 pointer-events-none select-none">/</kbd>
              </div>
              <select id="statusSel" name="status_filter" class="bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent block w-full sm:w-[190px] px-4 py-2 transition-all cursor-pointer outline-none">
                <option value="all" selected>All statuses</option>
                <option value="confirmed">Confirmed</option>
                <option value="not_confirmed">Not confirmed</option>
                <option value="invalid">Invalid size</option>
              </select>
            </div>
            <div id="toolbarRight" class="flex items-center gap-3 w-full md:w-auto md:justify-end"></div>
          </div>
        </div>

        <div id="tableBox" class="sm:overflow-x-auto sm:border sm:border-gray-200 sm:rounded-lg">
          <table id="tbl" class="w-full table-fixed">
            <thead class="bg-white">
              <tr>
                <th class="w-[14%] px-3 lg:px-4 py-3 border-b border-gray-200 text-left text-xs font-medium text-on-surface-variant uppercase tracking-wider select-none">Group</th>
                <th class="w-[34%] px-3 lg:px-4 py-3 border-b border-gray-200 text-left text-xs font-medium text-on-surface-variant uppercase tracking-wider select-none">Members</th>
                <th class="w-[24%] px-3 lg:px-4 py-3 border-b border-gray-200 text-left text-xs font-medium text-on-surface-variant uppercase tracking-wider select-none">Status</th>
                <th class="w-[28%] px-3 lg:px-4 py-3 border-b border-gray-200 text-left text-xs font-medium text-on-surface-variant uppercase tracking-wider select-none"><span class="sr-only">Action</span></th>
              </tr>
            </thead>
          </table>
          <div class="px-0 sm:px-4 py-2 sm:py-3 sm:border-t sm:border-gray-200 sm:bg-white sm:rounded-b-lg"><span id="showing" class="text-sm text-gray-500"></span></div>
        </div>

        <div id="noMatch" class="hidden text-center py-14">
          <p class="text-base font-medium text-gray-900">No groups match your current filters.</p>
          <p class="text-sm text-gray-500 mt-1">Try adjusting your search or filters.</p>
        </div>
        <div id="emptyState" class="hidden text-center py-14 border border-gray-200 rounded-lg">
          <p class="text-base font-medium text-gray-900">No groups yet</p>
          <p class="text-sm text-gray-500 mt-1">Groups will appear here once they are created.</p>
        </div>
      </section>
    </div>
  </main>
</div>

<!-- Modal -->
<div id="modal" class="hidden fixed inset-0 z-[60] items-center justify-center bg-black/30 sm:p-4">
  <div class="modal-card bg-white w-full sm:max-h-[85vh] sm:max-w-lg sm:rounded-lg flex flex-col shadow-xl">
    <div class="flex items-center justify-between gap-3 px-4 sm:px-6 pt-3 sm:pt-5 pb-2 sm:pb-3 shrink-0">
      <h2 id="modalTitle" class="dm text-xl font-medium text-gray-900 min-w-0 break-words"></h2>
      <button type="button" data-close="modal" aria-label="Close" class="shrink-0 h-11 w-11 sm:h-9 sm:w-9 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant"><span class="material-symbols-outlined">close</span></button>
    </div>
    <div id="modalBody" class="px-4 sm:px-6 overflow-y-auto flex-1 min-h-0"></div>
    <div id="modalFoot" class="shrink-0 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3 px-4 sm:px-6 pt-3 sm:py-4 border-t border-gray-200"></div>
  </div>
</div>

<!-- Confirmation dialog (destructive / consequential actions only) -->
<div id="dlg" class="hidden fixed inset-0 z-[70] items-center justify-center bg-black/40 p-4">
  <div class="bg-white w-full max-w-md rounded-lg shadow-xl flex flex-col" style="max-height:90vh;max-height:90dvh">
    <h2 id="dlgTitle" class="dm text-xl font-medium text-gray-900 px-5 sm:px-6 pt-5 sm:pt-6 pb-3 shrink-0"></h2>
    <div id="dlgBody" class="text-sm text-gray-600 space-y-2 px-5 sm:px-6 overflow-y-auto min-h-0 flex-1"></div>
    <div class="flex justify-end gap-2 px-5 sm:px-6 py-4 shrink-0">
      <button type="button" data-close="dlg" class="flex-1 sm:flex-none min-h-[44px] sm:min-h-0 px-5 py-2 rounded-full text-primary-strong hover:bg-primary-container font-medium text-sm cursor-pointer">Cancel</button>
      <button id="dlgOk" type="button" class="flex-1 sm:flex-none min-h-[44px] sm:min-h-0 px-5 py-2 rounded-full text-white font-medium text-sm cursor-pointer"></button>
    </div>
  </div>
</div>

<script>
/* ---------- Data (hardcoded) ---------- */
const MAX=5, MIN=2;
const expanded={G001:true}; // which rows show the full name list (G001 open by default)
const groups=[
  {id:'G001',name:'G001',status:'confirmed',approval:false,members:['Aisyah Rahman','Daniel Lim','Priya Nair','Wei Jie Tan'],proposal:'Campus Lost & Found'},
  {id:'G002',name:'G002',status:'confirmed',approval:false,members:['Hui Min Chong','Arjun Menon','Sofia Hamid'],proposal:'Smart Campus Navigator'},
  {id:'G003',name:'G003',status:'confirmed',approval:true,members:['Marcus Teo','Nurul Izzah'],proposal:null},
  {id:'G004',name:'G004',status:'open',approval:false,members:['Farah Zainal','Ethan Lau','Kavitha Raj'],proposal:null},
  {id:'G005',name:'G005',status:'open',approval:true,members:['Muhammad Hafizuddin bin Abdul Rahman Shamsuddin'],proposal:null},
  {id:'G006',name:'G006',status:'open',approval:false,members:['Siti Balqis','Lim Kah Yee','Ravi Chandran','Tan Mei Ling','Omar Faisal','Nur Aina Sofia'],proposal:null},
];
/* 100 ungrouped students, alphabetical, to show how the lists cope at realistic size */
const FN=['Aina','Hafiz','Mei Xin','Zack','Nadia','Irfan','Siti','Jun','Priya','Daniel'];
const LN=['Sofea','Roslan','Lau','Ibrahim','Yusof','Hakim','Aziz','Tan','Kumar','Wong'];
const ungrouped=[];
for(let i=0;i<100;i++)ungrouped.push(FN[i%10]+' '+LN[Math.floor(i/10)]);
ungrouped.sort((a,b)=>a.localeCompare(b));
let notifs={
  none:[{type:'invite',group:'G004',by:'Farah Zainal'},{type:'invite',group:'G001',by:'Aisyah Rahman'}],
  leader:[{type:'request',who:'Nadia Yusof'}]
};
let requested={};

/* ---------- Helpers ---------- */
const $=id=>document.getElementById(id);
const show=el=>{el.classList.remove('hidden');el.classList.add('flex')};
const hide=el=>{el.classList.add('hidden');el.classList.remove('flex')};
const role=()=>$('roleSel').value;
const isStudent=()=>['none','leader','oleader','member','cleader','cmember'].includes(role());
const canManage=()=>role()==='coord'||role()==='lect';
const mineId=()=>['leader','member'].includes(role())?'G004':role()==='oleader'?'G006':['cleader','cmember'].includes(role())?'G002':null;
const isLeader=()=>['leader','oleader','cleader'].includes(role());
const byId=id=>groups.find(g=>g.id===id);

/* Size state: ok | under | over. Invalid size (yellow rows) = under the minimum or over the maximum. */
const sizeState=g=>{const n=g.members.length;return $('rulesSel').value==='nolimit'?'ok':n<MIN?'under':n>MAX?'over':'ok'};
const isInvalid=g=>sizeState(g)!=='ok';
const plural=(n,w)=>`${n} ${w}${n===1?'':'s'}`;

const T='transition-colors cursor-pointer';
const B_FILL=`bg-primary-strong hover:bg-primary-hover text-white px-5 py-2 rounded-full font-medium text-sm ${T}`;
const B_OUT=`px-5 py-2 rounded-full border border-gray-300 text-primary-strong hover:bg-primary-container font-medium text-sm ${T}`;
const B_TONAL=`px-5 py-2 rounded-full bg-blue-100 text-blue-900 hover:bg-blue-200 font-medium text-sm ${T}`;
const B_ROW=`px-3 py-1.5 rounded-full bg-blue-100 text-blue-900 hover:bg-blue-200 font-medium text-[13px] whitespace-nowrap ${T}`;
const B_ROW_OFF='px-3 py-1.5 rounded-full bg-gray-100 text-gray-400 font-medium text-[13px] whitespace-nowrap cursor-not-allowed';
const B_TEXT=`px-3 py-2 rounded-full text-primary-strong hover:bg-primary-container font-medium text-sm ${T}`;
const B_SM=`px-4 py-1.5 rounded-full border border-gray-300 text-primary-strong hover:bg-primary-container font-medium text-[13px] ${T}`;
const B_DANGER=`px-3 py-2 rounded-full text-red-600 hover:bg-error-container font-medium text-sm ${T}`;
const TAP='min-h-[44px] sm:min-h-0';           // 44px tap target on phones only
const FULL_M='w-full sm:w-auto';                // full width on phones, natural width from sm
const PILL='inline-flex items-center px-2.5 py-0.5 rounded text-[12px] font-medium tracking-wide whitespace-nowrap';
const pill=g=>g.status==='confirmed'
  ?`<span class="${PILL} bg-success-container text-green-700">Confirmed</span>`
  :`<span class="${PILL} bg-gray-100 text-gray-600">Not confirmed</span>`;
/* Warning icon for the group card: fixed 16px via inline style, boxed to the 20px text line so it centres with the text */
const WARN_ICON=`<span class="flex h-5 items-center shrink-0" aria-hidden="true"><span class="material-symbols-outlined text-amber-600" style="font-size:16px;line-height:1;width:16px;height:16px;overflow:hidden">warning</span></span>`;
const leaderTag='<span class="text-xs text-gray-500 ml-1.5">Leader</span>';

const avatar=n=>`<div class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-[11px] font-medium text-gray-700 shrink-0">${n.charAt(0)}</div>`;
const person=(n,tag='')=>`<div class="flex items-start gap-3 min-w-0">${avatar(n)}<span class="text-sm text-gray-700 leading-5 pt-1 break-words min-w-0">${n}${tag}</span></div>`;
/* Chips wrap long names onto a second line instead of truncating (names are always full text) */
const chip=(n,lead)=>`<div class="inline-flex max-w-full items-center gap-2 rounded-[20px] bg-surface border border-outline-variant pl-1 pr-3 py-1"><span class="w-6 h-6 rounded-full bg-surface-variant-deep text-on-surface flex items-center justify-center text-[11px] font-medium shrink-0">${n.charAt(0)}</span><span class="min-w-0 break-words text-[13px] leading-4 text-on-surface py-0.5">${n}</span>${lead?'<span class="text-[11px] text-on-surface-muted shrink-0">Leader</span>':''}</div>`;

function showMsg(text,type='info'){
  const s={
    info:['bg-primary-container text-primary-strong','info'],
    warn:['bg-amber-50 text-amber-700 border border-amber-200','warning'],
    success:['bg-success-container text-green-700','check_circle'],
    error:['bg-error-container text-red-700','error']
  }[type];
  $('msg').innerHTML=`<div class="flex items-start gap-3 rounded-lg px-4 py-3 text-sm ${s[0]}" role="alert">
    <span class="material-symbols-outlined text-[20px] mt-px shrink-0">${s[1]}</span><span class="flex-1 min-w-0 break-words">${text}</span>
    <button type="button" aria-label="Dismiss" onclick="$('msg').innerHTML=''" class="shrink-0 p-1 -m-1 opacity-70 hover:opacity-100"><span class="material-symbols-outlined text-[18px]">close</span></button></div>`;
}

