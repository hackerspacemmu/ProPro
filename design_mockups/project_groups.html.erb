/* ---------- Header button (all roles) + bell (students) + coordinator icons ---------- */
function renderHead(){
  $('headBtn').innerHTML=`<button type="button" onclick="openUngrouped()" class="${B_TONAL} inline-flex items-center justify-center gap-2 ${FULL_M} ${TAP}"><span class="material-symbols-outlined text-[18px]">person_search</span>${ungrouped.length} students without a group</button>`;
  const coord=role()==='coord';
  $('mCoord').style.display=coord?'':'none';
  $('tabIcons').innerHTML=coord
    ?`<a href="#" title="Edit Project Templates" aria-label="Edit Project Templates" class="h-[3rem] w-[2.5rem] flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant transition-colors shrink-0"><span class="material-symbols-outlined">edit_note</span></a>
      <a href="#" title="Course settings" aria-label="Course settings" class="h-[3rem] w-[3rem] flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant transition-colors shrink-0"><span class="material-symbols-outlined">settings</span></a>`:'';
  $('bellWrap').style.display=isStudent()?'':'none';
  const list=notifs[role()]||[], b=$('bellBadge');
  if(list.length){b.textContent=list.length;b.classList.remove('hidden');b.classList.add('flex')}else{b.classList.add('hidden');b.classList.remove('flex')}
  $('bellPop').innerHTML=`<div class="dm px-4 py-3 border-b border-gray-200 font-medium text-[15px] text-gray-900">Notifications</div>`+
    (list.length?list.map((n,i)=>`<div class="px-4 py-3 border-b border-gray-200 last:border-0">
      <div class="flex items-start gap-3">${avatar(n.by||n.who)}<div class="min-w-0">
        <p class="text-sm text-gray-900">${n.type==='invite'?`<span class="font-medium">${n.group}</span> invited you to join`:`<span class="font-medium">${n.who}</span> asked to join your group`}</p>
        ${n.type==='invite'?`<p class="text-[13px] text-gray-500">Invited by ${n.by}</p>`:''}</div></div>
      <div class="flex gap-2 mt-2 pl-10"><button type="button" onclick="acceptNotif(${i})" class="${B_SM}">Accept</button><button type="button" onclick="declineNotif(${i})" class="${B_TEXT} !py-1.5 !text-[13px]">Decline</button></div></div>`).join('')
    :`<p class="px-4 py-6 text-sm text-gray-500">No new notifications.</p>`);
}
function acceptNotif(i){
  const r=role(), n=notifs[r][i];
  if(n.type==='invite'){notifs.none=[];$('roleSel').value='member';render();showMsg(`You joined ${n.group}. Your other invites and requests were cleared.`,'success')}
  else{notifs[r].splice(i,1);renderHead();showMsg(`${n.who} joined your group.`,'success')}
  $('bellPop').classList.add('hidden');
}
function declineNotif(i){notifs[role()].splice(i,1);renderHead()}

/* ---------- Slot (students in a group). Students with no group get no card: the table is the hero. ---------- */
const CARD='border rounded-[8px] p-4 sm:p-6';
function renderSlot(){
  const r=role(), el=$('slot'), nolim=$('rulesSel').value==='nolimit';
  if(!isStudent()||r==='none'){el.innerHTML='';return}
  const g=byId(mineId()), conf=g.status==='confirmed', lead=isLeader(), n=g.members.length, s=sizeState(g), inv=isInvalid(g);
  /* The card always uses the Not confirmed colours (light blue), whatever the status or size */
  const tone='bg-primary-container/40 border-outline-variant';
  const ab=`${FULL_M} ${TAP}`;
  let actions='';
  if(lead&&!conf)actions=`<button type="button" onclick="tryConfirm()" class="${B_FILL} ${ab}">Confirm group</button><button type="button" onclick="openManage('${g.id}','leader')" class="${B_TEXT} ${ab}">Manage group</button>`;
  else if(lead&&conf)actions=`<button type="button" onclick="reopen()" class="${B_OUT} ${ab}">Reopen group</button><button type="button" onclick="openManage('${g.id}','leader')" class="${B_TEXT} ${ab}">Manage group</button>`;
  else actions=`<button type="button" onclick="leaveDialog('${g.id}')" class="${B_TEXT} ${ab}">Leave group</button>`;
  let sub='';
  if(conf&&inv)sub='Outside the size limits. Contact your coordinator.';
  else if(s==='under')sub=`Needs ${plural(MIN-n,'more member')}`;
  else if(s==='over')sub=`Over the maximum of ${MAX}`;
  else if(!conf&&!lead)sub='Waiting for your leader to confirm.';
  el.innerHTML=`<div class="${CARD} ${tone}"><div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
    <div class="min-w-0 md:flex-1">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1"><h2 class="dm text-xl font-medium text-gray-900">${g.name}</h2>${pill(g)}</div>
      ${sub?`<p class="mt-1.5 text-sm leading-5 flex items-start gap-1.5 text-gray-600">${inv?WARN_ICON:''}<span class="min-w-0">${sub}</span></p>`:''}
      <div class="mt-4 sm:mt-5">
        <div class="flex items-baseline gap-2 mb-2"><span class="text-[11px] font-medium text-on-surface-variant uppercase tracking-wider">Members</span><span class="text-[13px] text-gray-500">${nolim?n:`${n} of ${MAX}`}</span></div>
        <div class="flex flex-wrap gap-2">${g.members.map((m,i)=>chip(m,i===0)).join('')}</div>
      </div>
    </div>
    <div class="flex flex-col sm:flex-row sm:flex-wrap md:flex-nowrap items-stretch sm:items-center gap-2 md:shrink-0">${actions}</div></div></div>`;
}

/* ---------- Table ---------- */
function renderTableHead(){
  const none=role()==='none';
  $('tableTitle').textContent='All groups';
  $('tableSub').classList.toggle('hidden',!none);
  $('toolbarRight').innerHTML=none?`<button type="button" onclick="createGroup()" class="${B_TONAL} w-full md:w-auto ${TAP}">Create group</button>`:'';
}
function actionCell(g){
  const r=role();
  if(r==='none'){
    const label=g.approval?'Request to join':'Join';
    /* Greyed out (not hidden) on confirmed groups; the Confirmed pill in the same row is the reason */
    if(g.status==='confirmed')return `<button type="button" disabled aria-disabled="true" class="act-btn ${B_ROW_OFF}">${label}</button>`;
    if(g.members.length>=MAX)return `<span class="text-[13px] text-gray-500">Full</span>`;
    if(requested[g.id])return `<div class="flex items-center justify-between gap-3 sm:flex-col sm:items-start sm:justify-start sm:gap-0"><span class="text-[13px] text-gray-500">Request sent</span><button type="button" onclick="cancelReq('${g.id}')" class="cancel-link text-[13px] text-primary-strong font-medium hover:underline cursor-pointer">Cancel request</button></div>`;
    return g.approval
      ?`<button type="button" onclick="reqJoin('${g.id}')" class="act-btn ${B_ROW}">Request to join</button>`
      :`<button type="button" onclick="joinFail()" class="act-btn ${B_ROW}">Join</button>`;
  }
  if(canManage())return `<button type="button" onclick="openManage('${g.id}','staff')" class="act-btn ${B_SM}">Manage</button>`;
  return '';
}
function toggleRow(id,btn){
  expanded[id]=!expanded[id];
  btn.closest('tbody').querySelector('tr.detail').classList.toggle('hidden',!expanded[id]);
  btn.setAttribute('aria-expanded',expanded[id]?'true':'false');
  btn.querySelector('.chev').classList.toggle('rotate-180',!!expanded[id]);
}
function renderRows(){
  const mine=mineId(), empty=$('tableSel').value==='empty', nolim=$('rulesSel').value==='nolimit';
  $('tableBox').classList.toggle('hidden',empty);
  $('emptyState').classList.toggle('hidden',!empty);
  $('noMatch').classList.add('hidden');
  /* stats: plain text; the filter options carry the other counts */
  const src=empty?[]:groups, conf=src.filter(g=>g.status==='confirmed').length, inv=src.filter(isInvalid).length;
  $('count').textContent=`${conf} of ${src.length} confirmed`;
  const o=$('statusSel').options;
  o[0].text='All statuses';o[1].text=`Confirmed (${conf})`;o[2].text=`Not confirmed (${src.length-conf})`;o[3].text=`Invalid size (${inv})`;

  document.querySelectorAll('#tbl tbody').forEach(t=>t.remove());
  $('tbl').insertAdjacentHTML('beforeend',groups.map(g=>{
    const n=g.members.length, own=g.id===mine, act=actionCell(g), open=!!expanded[g.id], bad=isInvalid(g);
    const hay=(g.name+' '+g.members.join(' ')).toLowerCase();
    const stackAv=g.members.map(m=>`<div class="relative w-7 h-7 rounded-full bg-gray-200 border-2 border-white flex items-center justify-center text-[11px] font-medium text-gray-700 z-10">${m.charAt(0)}</div>`).join('');
    const list=g.members.map(m=>`<div class="flex items-start gap-3 min-w-0">${avatar(m)}<span class="text-sm text-gray-700 leading-5 pt-1 break-words min-w-0">${m}</span></div>`).join('');
    const countTxt=nolim?plural(n,'member'):`${n} of ${MAX} members`;
    /* Invalid size: Material warning icon only (no tooltip, no reason text) on every breakpoint, fixed 16px */
    const warn=bad?`<span class="inline-flex shrink-0" role="img" aria-label="Invalid size"><span class="material-symbols-outlined text-amber-600" style="font-size:16px;line-height:1;width:16px;height:16px;overflow:hidden" aria-hidden="true">warning</span></span>`:'';
    return `<tbody class="grp${bad?' invalid':''}" data-hay="${hay}" data-status="${g.status==='confirmed'?'confirmed':'not_confirmed'}" data-flag="${bad?1:0}">
      <tr class="main">
        <td class="c-g px-3 lg:px-4 py-4 text-sm align-middle"><div class="text-gray-900 font-medium break-words">${g.name}</div>${own?'<div class="text-xs text-gray-500">Your group</div>':''}</td>
        <td class="c-m px-3 lg:px-4 py-2 sm:py-4 align-middle">
          <button type="button" onclick="toggleRow('${g.id}',this)" aria-expanded="${open}" class="flex w-full items-center gap-3 min-w-0 text-left cursor-pointer ${TAP} rounded-md">
            <span class="flex sm:hidden xl:flex -space-x-1.5 shrink-0">${stackAv}</span>
            <span class="flex flex-wrap items-center gap-x-1.5 min-w-0 flex-1"><span class="text-sm text-gray-500">${countTxt}</span>${warn}</span>
            <span class="chev material-symbols-outlined text-[20px] text-gray-400 transition-transform duration-200 shrink-0${open?' rotate-180':''}">expand_more</span>
          </button>
        </td>
        <td class="c-s px-3 lg:px-4 py-4 align-middle text-right sm:text-left">${pill(g)}</td>
        <td class="c-a px-3 lg:px-4 py-4 text-sm text-gray-600 align-middle" ${act?'':'data-empty'}><div>${act}</div></td>
      </tr>
      <tr class="detail${open?'':' hidden'}"><td colspan="4" class="px-3 lg:px-4 py-4"><div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 pl-0 sm:pl-[10%]">${list}</div></td></tr>
    </tbody>`;
  }).join(''));
  filterRows();
}
function filterRows(){
  const q=$('search').value.trim().toLowerCase(), st=$('statusSel').value, empty=$('tableSel').value==='empty';
  let vis=0;
  document.querySelectorAll('#tbl tbody.grp').forEach(tb=>{
    const okSt=st==='all'||(st==='invalid'?tb.dataset.flag==='1':tb.dataset.status===st);
    const ok=(!q||tb.dataset.hay.includes(q))&&okSt;
    tb.style.display=ok?'':'none'; if(ok)vis++;
  });
  const total=empty?0:groups.length; if(empty)vis=0;
  $('noMatch').classList.toggle('hidden',empty||vis>0);
  $('tableBox').classList.toggle('hidden',empty||vis===0);
  $('showing').innerHTML=`Showing <span class="font-semibold text-gray-700">${vis}</span> of <span class="font-semibold text-gray-700">${total}</span> groups`;
}

/* ---------- Student actions ---------- */
function createGroup(){$('roleSel').value='leader';render();showMsg('G007 created. You’re the leader.','success')}
function tryConfirm(){
  const g=byId(mineId()), s=sizeState(g), n=g.members.length;
  if(s==='under')showMsg(`Needs ${plural(MIN-n,'more member')} to confirm.`,'warn');
  else if(s==='over')showMsg(`This group has ${n} members and the maximum is ${MAX}. Remove ${plural(n-MAX,'member')} to confirm.`,'warn');
  else showMsg('Confirming now would leave 1 student without a group. Ask them to join a group first, or add them yourself.','warn');
}
function reopen(){showMsg('Group reopened. Members can be changed again.','info')}
function joinFail(){showMsg('This group filled up. Choose another group.','error')}
function reqJoin(id){requested[id]=true;renderRows();showMsg('Request sent. The leader will be notified.','info')}
function cancelReq(id){delete requested[id];renderRows();showMsg('Request cancelled.','info')}
function clearReq(btn){btn.closest('section').querySelector('[data-req]').innerHTML='<p class="text-sm text-gray-500">No pending requests.</p>'}
function inviteSent(btn){btn.outerHTML='<span class="text-[13px] text-green-700 shrink-0">Invite sent</span>'}

/* ---------- Modals ---------- */
const DONE=`${B_FILL} w-full sm:w-auto sm:ml-auto ${TAP}`;
function openModal(title,body,left,btn){
  $('modalTitle').textContent=title;$('modalBody').innerHTML=body;
  $('modalFoot').innerHTML=(left?`<div class="foot-left flex flex-wrap gap-1">${left}</div>`:'')+btn;
  $('modalBody').scrollTop=0;
  show($('modal'));
}
function closeModal(k){hide($(k))}
document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>closeModal(b.dataset.close)));
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){
    if(!$('dlg').classList.contains('hidden'))closeModal('dlg');
    else{closeModal('modal');$('bellPop').classList.add('hidden');if(!isDesktop())closeSidebar()}
  }
  if(e.key==='/'&&!['INPUT','SELECT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('search').focus()}
});
function dialog(title,body,okLabel,danger,onOk){
  $('dlgTitle').textContent=title;$('dlgBody').innerHTML=body;
  const ok=$('dlgOk');ok.textContent=okLabel;
  ok.className=`flex-1 sm:flex-none min-h-[44px] sm:min-h-0 px-5 py-2 rounded-full text-white font-medium text-sm cursor-pointer ${danger?'bg-red-600 hover:bg-red-700':'bg-primary-strong hover:bg-primary-hover'}`;
  ok.onclick=()=>{closeModal('dlg');onOk&&onOk()};
  $('dlgBody').scrollTop=0;
  show($('dlg'));
}
const section=(t,inner)=>`<section class="py-4 border-b border-gray-200 last:border-0"><h3 class="dm text-[15px] font-medium text-gray-900 mb-2">${t}</h3>${inner}</section>`;
const INPUT_CLS='w-full bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-md px-3 py-2 outline-none focus:bg-white focus:ring-2 focus:ring-primary focus:border-transparent';

/* Browse list (ungrouped modal): full list, scrolls, search pinned at the top */
const searchBox=target=>`<div class="sticky top-0 bg-white pb-2 z-10"><input type="text" placeholder="Search students" oninput="filterList(this,'${target}')" class="${INPUT_CLS}"></div>`;
function filterList(input,id){const q=input.value.toLowerCase();document.querySelectorAll('#'+id+' [data-n]').forEach(r=>r.style.display=r.dataset.n.toLowerCase().includes(q)?'':'none')}

/* Picker (Invite / Add): shows the first 6 matches, empty search included. Server-side `limit 6` in the real app. */
function pickerRows(verb,gid,q){
  const hits=ungrouped.filter(u=>u.toLowerCase().includes(q)), shown=hits.slice(0,6);
  if(!hits.length)return `<p class="text-[13px] text-gray-500">No students match.</p>`;
  return shown.map(u=>`<div class="flex items-center justify-between gap-3 py-1.5">${person(u)}<button type="button" onclick="${verb==='Add'?`addStudent('${gid}','${u}')`:'inviteSent(this)'}" class="${B_SM} shrink-0">${verb}</button></div>`).join('')+
    `<p class="text-[13px] text-gray-500 pt-2">Showing ${shown.length} of ${hits.length}</p>`;
}
function picker(listId,verb,gid){
  return `<input type="text" placeholder="Search by name" oninput="$('${listId}').innerHTML=pickerRows('${verb}','${gid||''}',this.value.trim().toLowerCase())" class="${INPUT_CLS} mb-2">
    <div id="${listId}">${pickerRows(verb,gid||'','')}</div>`;
}
function addStudent(gid,name){
  byId(gid).members.push(name);
  ungrouped.splice(ungrouped.indexOf(name),1);
  renderHead();renderRows();
  openManage(gid,'staff',`${name} was added.`);
}

/* Manage group: leader, coordinator, lecturer.
   Leader (not confirmed) order: Join requests, Members, Invite link, Settings, Invite student. */
function openManage(id,mode,note=''){
  const g=byId(id), conf=g.status==='confirmed', staff=mode==='staff', can=staff&&canManage(), n=g.members.length, full=n>=MAX;
  const leaderEdit=!staff&&!conf;
  let body=note?`<p class="text-[13px] text-green-700 pb-2" role="status">${note}</p>`:'';

  if(leaderEdit){
    body+=section('Join requests',`<div data-req><div class="flex items-start justify-between gap-3">${person('Nadia Yusof')}<span class="flex gap-1 shrink-0"><button type="button" onclick="clearReq(this)" class="${B_SM}">Accept</button><button type="button" onclick="clearReq(this)" class="${B_TEXT} !py-1.5 !text-[13px]">Decline</button></span></div></div>`);
  }

  const memberRows=g.members.map((m,i)=>{
    const rm=can?`<button type="button" onclick="removeStaffDialog('${g.id}','${m}')" class="${B_DANGER} !py-1 !text-[13px]">Remove</button>`
      :(leaderEdit&&i>0)?`<button type="button" onclick="removeDialog('${g.id}','${m}')" class="${B_DANGER} !py-1 !text-[13px]">Remove from group</button>`:'';
    return `<div class="flex items-start justify-between gap-3 py-1.5">${person(m,i===0?leaderTag:'')}<div class="shrink-0">${rm}</div></div>`;
  }).join('');
  body+=section(`Members (${n} of ${MAX})`,memberRows+(conf&&!staff?`<p class="text-[13px] text-gray-500 mt-2">Reopen your group to change members.</p>`:''));

  if(leaderEdit){
    body+=section('Invite link',`<div class="flex gap-2"><input readonly value="propro.app/join/G004-8f3k2q" class="flex-1 min-w-0 bg-gray-50 border border-gray-200 rounded-md px-3 py-2 text-sm text-on-surface-variant">
      <button type="button" onclick="this.textContent='Copied'" class="${B_SM} shrink-0">Copy</button></div><p class="text-[13px] text-gray-500 mt-1.5">Link expires in 24 hours.</p>`);
    body+=section('Settings',`<label class="flex items-center justify-between gap-4 cursor-pointer"><span class="text-sm text-gray-900">Require approval to join<span class="block text-[13px] text-gray-500">Students send a request and you accept or decline.</span></span>
      <span class="relative inline-flex shrink-0"><input type="checkbox" class="peer sr-only"><span class="block w-10 h-6 rounded-full bg-gray-300 peer-checked:bg-primary-strong transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:bg-white after:rounded-full after:transition-all peer-checked:after:translate-x-4"></span></span></label>`);
    body+=section('Invite student',picker('inviteList','Invite'));
  }
  if(can)body+=section('Add student',full?`<p class="text-sm text-gray-500">This group is full.</p>`:picker('addList','Add',g.id));

  let left='';
  if(leaderEdit)left=`<button type="button" onclick="deleteDialog('${g.id}')" class="${B_DANGER}">Delete group</button><button type="button" onclick="leaveDialog('${g.id}')" class="${B_TEXT}">Leave group</button>`;
  if(can)left=`<button type="button" onclick="deleteDialog('${g.id}')" class="${B_DANGER}">Delete group</button>`+
    (role()==='coord'&&!conf?`<button type="button" onclick="confirmForLeader('${g.id}')" class="${B_TEXT}">Confirm for leader…</button>`:'');
  openModal(g.name,(staff?`<div class="pb-2">${pill(g)}</div>`:'')+body,left,
    `<button type="button" onclick="closeModal('modal')" class="${DONE}">Done</button>`);
}

/* Ungrouped students: reference list only */
function openUngrouped(){
  const hint=canManage()?'<p class="text-[13px] text-gray-500 mb-2">To place someone, open a group with Manage and add them there.</p>':'';
  const rows=ungrouped.map(n=>`<div data-n="${n}" class="py-2 border-b border-gray-200 last:border-0">${person(n)}</div>`).join('');
  openModal(`Students without a group (${ungrouped.length})`,`<div class="pb-4">${hint}${searchBox('ungList')}<div id="ungList">${rows}</div></div>`,'',
    `<button type="button" onclick="closeModal('modal')" class="${B_OUT} w-full sm:w-auto sm:ml-auto ${TAP}">Close</button>`);
}

/* ---------- Confirmation dialogs (destructive / consequential only) ---------- */
const nameList=names=>`<div class="flex flex-col gap-2 py-1">${names.map(n=>person(n)).join('')}</div>`;
function deleteDialog(id){
  const g=byId(id);
  dialog('Delete '+g.name+'?',`<p>These students will have no group:</p>${nameList(g.members)}`+
    (g.proposal?`<p>The proposal “${g.proposal}” will be lost.</p>`:'')+`<p>This can’t be undone.</p>`,
    'Delete group',true,()=>{closeModal('modal');if(isStudent()){$('roleSel').value='none';render()}showMsg(g.name+' was deleted.','success')});
}
function leaveDialog(id){
  const g=byId(id), lead=isLeader(), last=g.members.length===1;
  dialog('Leave '+g.name+'?',
    last?`<p>You’re the last member, so the group will be deleted.</p>`+(g.proposal?`<p>The proposal “${g.proposal}” will be lost.</p>`:'')+`<p>This can’t be undone.</p>`
        :lead?`<p>${g.members[1]} becomes the leader.</p>`:`<p>You can join another group while formation is open.</p>`,
    'Leave group',last,()=>{closeModal('modal');$('roleSel').value='none';render();showMsg('You left '+g.name+'.','info')});
}
function removeDialog(id,name){
  dialog('Remove '+name+'?',`<p>${name} will have no group.</p>`,'Remove from group',true,()=>{closeModal('modal');showMsg(name+' was removed from the group.','success')});
}
function removeStaffDialog(id,name){
  const g=byId(id), size=g.members.length, last=size===1, under=size-1<MIN;
  dialog('Remove '+name+'?',
    last?`<p>${name} is the last member, so ${g.name} will be deleted.</p>`+(g.proposal?`<p>The proposal “${g.proposal}” will be lost.</p>`:'')
        :`<p>${g.name} goes from ${size} to ${size-1} members.</p>`+(g.status==='confirmed'&&under?`<p>It becomes <span class="text-gray-900">Not confirmed</span> because it falls below the minimum of ${MIN}.</p>`:''),
    'Remove from group',true,()=>{closeModal('modal');showMsg(name+' was removed from '+g.name+'.','success')});
}
function confirmForLeader(id){
  const g=byId(id);
  dialog('Confirm '+g.name+' for its leader?',
    `<p>${g.name} will show as Confirmed, as if ${g.members[0]} had confirmed it. Members can’t be removed afterwards and the group can submit a proposal.</p><p>${g.members[0]} can still reopen the group.</p>`,
    'Confirm for leader',false,()=>{closeModal('modal');showMsg(g.name+' was confirmed for '+g.members[0]+'.','success')});
}

/* ---------- Wiring ---------- */
function render(){$('msg').innerHTML='';renderRules();renderHead();renderSlot();renderTableHead();renderRows()}
['roleSel','rulesSel','tableSel'].forEach(id=>$(id).addEventListener('change',render));
$('search').addEventListener('input',filterRows);
$('statusSel').addEventListener('change',filterRows);
$('bellBtn').addEventListener('click',e=>{e.stopPropagation();$('bellPop').classList.toggle('hidden')});
document.addEventListener('click',e=>{if(!$('bellWrap').contains(e.target))$('bellPop').classList.add('hidden')});

/* Sidebar: collapses to a rail at lg and up, slides in off-canvas below lg */
const sb=$('sidebar'), scrim=$('scrim');
const isDesktop=()=>window.matchMedia('(min-width:1024px)').matches;
function closeSidebar(){sb.classList.add('-translate-x-full');scrim.classList.add('hidden')}
$('menuBtn').addEventListener('click',()=>{
  if(isDesktop()){sb.dataset.collapsed=sb.dataset.collapsed==='true'?'false':'true'}
  else{const closed=sb.classList.contains('-translate-x-full');sb.classList.toggle('-translate-x-full',!closed);scrim.classList.toggle('hidden',!closed)}
});
scrim.addEventListener('click',closeSidebar);
window.addEventListener('resize',()=>{if(isDesktop())closeSidebar()});

/* Mockup controls start collapsed on phones so the first screen shows the real page */
if(window.matchMedia('(max-width:639px)').matches)$('ctrls').open=false;

renderNav();
render();
</script>
</body>
</html>