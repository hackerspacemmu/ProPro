  $('rules').innerHTML=`<div class="flex flex-wrap items-center gap-x-5 gap-y-1 mt-1.5 text-sm text-gray-500"><span class="inline-flex items-center gap-1.5"><span class="material-symbols-outlined text-[18px]">group</span>${size}</span>${date}</div>`;
