  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --spacing-header: 64px;
    }
  </style>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          borderRadius: {
            'panel': '1rem',
          },
          minHeight: {
            'header': 'var(--spacing-header)',
          },
          spacing: {
            'header': 'var(--spacing-header)',
          },
          colors: {
            'surface-tint': '#f8f9fa',
            'on-surface': '#1f2937',
            'on-surface-variant': '#4b5563',
            'primary-strong': '#2563eb',
            'surface-hover': '#f3f4f6',
            'outline-variant': '#e5e7eb',
            'primary-container': '#eff6ff',
            'primary-soft': '#3b82f6',
            'error-container': '#fef2f2',
            'error': '#ef4444',
            'warning-container-alt': '#fffbeb',
            'warning-strong': '#f59e0b',
            'success-container': '#f0fdf4',
            'success': '#22c55e',
          }
        }
      }
    }
  </script>
