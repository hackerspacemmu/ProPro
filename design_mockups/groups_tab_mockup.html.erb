<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>COMP6000 - Groups tab | ProPro (mockup)</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
  :root{--color-surface-tint:#f8f9fa;--color-surface:#ffffff;--color-surface-hover:#f1f3f4;--color-surface-variant:#f1f3f4;--color-on-surface:#1f1f1f;--color-on-surface-strong:#1f1f1f;--color-on-surface-variant:#5f6368;--color-outline:#dadce0;--color-outline-variant:#e0e0e0;--color-primary:#1a73e8;--color-primary-strong:#1967d2;--color-primary-container:#d2e3fc;--color-primary-container-alt:#e8f0fe;--color-on-primary:#ffffff;--spacing-header:64px}
  .rounded-tl-panel{border-top-left-radius:24px}
</style>
<script>
tailwind.config={theme:{extend:{spacing:{header:'var(--spacing-header)'},colors:{
'surface-tint':'var(--color-surface-tint)',surface:'var(--color-surface)','surface-hover':'var(--color-surface-hover)','surface-variant':'var(--color-surface-variant)','surface-variant-deep':'#e1e3e1',
'on-surface':'var(--color-on-surface)','on-surface-strong':'var(--color-on-surface-strong)','on-surface-variant':'var(--color-on-surface-variant)','on-surface-muted':'#80868b',
outline:'var(--color-outline)','outline-variant':'var(--color-outline-variant)',primary:'var(--color-primary)','primary-strong':'var(--color-primary-strong)','primary-hover':'#1557b0',
'primary-container':'var(--color-primary-container)','primary-container-alt':'var(--color-primary-container-alt)','primary-soft':'#3b82f6',
'success-container':'#d6f5e3',success:'#137333',error:'#d93025','error-container':'#fde7e9','warning-container-alt':'#fffbeb','warning-container':'#fff4e5','warning-strong':'#f59e0b',
warning:'#b06000','warning-border':'#fde68a','warning-on-container':'#7a4b00'}}}}
</script>
</head>
<body class="bg-surface-tint" style="font-family: 'Roboto', Arial, sans-serif;">

<!-- Mockup controls (not part of the app) -->
<details open class="fixed bottom-4 right-4 z-[60] w-64 rounded-lg border border-outline-variant bg-white p-3 text-sm shadow-lg">
  <summary class="cursor-pointer font-medium text-on-surface">Mockup controls</summary>
  <div class="mt-3 flex flex-col gap-3 text-on-surface-variant">
    <label class="flex items-center justify-between gap-2">Role<select id="role" class="rounded-md border border-outline bg-white px-2 py-1 text-on-surface"><option value="coordinator">Coordinator</option><option value="lecturer">Lecturer</option><option value="leader">Student (leader)</option><option value="member">Student (member)</option></select></label>
    <label class="flex items-center justify-between gap-2">Formation<select id="win" class="rounded-md border border-outline bg-white px-2 py-1 text-on-surface"><option value="open">Open</option><option value="closed">Window ended</option><option value="off">Grouping off</option></select></label>
    <label class="flex items-center justify-between gap-2">Leftovers<select id="data" class="rounded-md border border-outline bg-white px-2 py-1 text-on-surface"><option value="both">Groups + students</option><option value="students">Only students</option><option value="clean">None</option></select></label>
  </div>
</details>

<!-- Header (shared/_header) -->
<header class="sticky top-0 z-40 bg-surface-tint flex items-center justify-between gap-3 px-4 py-2" style="min-height: var(--spacing-header);">
  <div class="flex items-center gap-2 min-w-0 flex-1">
    <button type="button" aria-label="Toggle sidebar" aria-controls="app-sidebar" class="shrink-0 h-10 w-10 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant transition-colors">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <div class="hidden sm:flex sm:items-center sm:min-w-0">
      <a href="#" class="shrink-0 text-[1.5rem] leading-8 font-normal text-on-surface-variant hover:text-on-surface transition-colors no-underline whitespace-nowrap" style="font-family: 'DM Sans',Roboto,Arial,sans-serif">ProPro</a>
      <svg class="mx-2 text-on-surface-variant/60" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      <span class="text-[1rem] font-medium text-on-surface">COMP6000</span>
    </div>
    <span class="sm:hidden truncate text-[17px] text-on-surface font-medium min-w-0">COMP6000</span>
  </div>
  <div class="flex items-center gap-1 shrink-0">
    <button class="hidden sm:block text-[15px] font-medium text-on-surface-variant hover:text-on-surface transition-colors pr-2 bg-transparent border-0 cursor-pointer">Log out</button>
  </div>
</header>

<div class="text-on-surface font-['Roboto',sans-serif]">
  <div class="flex">
    <!-- Sidebar (shared/_sidebar) -->
    <aside id="app-sidebar" class="group/sidebar w-[280px] shrink-0 py-3 bg-surface-tint fixed top-0 left-0 h-full z-50 -translate-x-full transition-[transform,width] duration-200 ease-out lg:sticky lg:top-header lg:translate-x-0 lg:h-[calc(100vh-var(--spacing-header))] lg:self-start lg:overflow-y-auto" data-collapsed="false">
      <nav class="flex flex-col gap-1 pr-3">
        <a href="#" class="group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors rounded-r-full text-on-surface hover:bg-white/60" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;">
          <span class="material-symbols-outlined">home</span><span>Home</span>
        </a>
        <div>
          <div class="px-6 py-2 flex items-center justify-between text-on-surface-variant cursor-pointer">
            <span style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;">Enrolled</span>
            <span class="material-symbols-outlined text-sm">expand_less</span>
          </div>
          <a href="#" class="group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors rounded-r-full bg-white/70 text-on-surface" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" aria-label="COMP6000">
            <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold shrink-0">C</div>
            <span class="truncate">COMP6000</span>
          </a>
          <div class="py-2"><div class="border-t border-outline"></div></div>
        </div>
        <a href="#" class="group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors rounded-r-full text-on-surface hover:bg-white/60" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" aria-label="Edit profile">
          <span class="material-symbols-outlined text-on-surface-variant">person</span><span>Edit profile</span>
        </a>
        <form class="m-0 w-full" action="#" method="post" onsubmit="return false">
          <button type="submit" class="group/item relative flex items-center gap-4 px-6 py-3.5 transition-colors rounded-r-full text-on-surface hover:bg-white/60 w-full text-left bg-transparent border-0 cursor-pointer" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500; letter-spacing: 0; line-height: 1.25rem;" aria-label="Log out">
            <span class="material-symbols-outlined text-on-surface-variant">logout</span><span>Log out</span>
          </button>
        </form>
      </nav>
    </aside>

    <!-- Main -->
    <main class="flex-1 bg-white rounded-tl-panel overflow-x-hidden overflow-y-auto h-[calc(100vh-var(--spacing-header))]">
      <div class="border-b border-outline-variant px-4 sm:px-8 bg-white shrink-0 sticky top-0 z-20">
        <div class="flex items-center justify-between">
          <nav data-testid="content-tabs" id="tabs" class="flex flex-nowrap gap-x-2" aria-label="Course sections"></nav>
          <div id="tabtools" class="flex items-center gap-1 shrink-0"></div>
        </div>
      </div>
      <div class="max-w-5xl mx-auto px-6 py-8"><div id="flash"></div><div id="panel"></div></div>
    </main>
  </div>
</div>
<div id="modal"></div>
<script>
/* ============ GROUPS TAB MOCKUP: standalone. Sample data + state only; the markup mirrors courses/_groups_tab. ============ */
const MIN=3,MAX=5,UNGROUPED=4;
const S={role:'coordinator',win:'open',data:'both',filter:'all',sup:'all',q:''}, E=new Set();
let G=[
 {id:1,n:'Tmp001',c:0,i:0,m:['Aiman Hakim'],p:null,s:''},
 {id:2,n:'Tmp002',c:0,i:0,m:['Nur Sabrina','Daniel Tan','Mei Ling'],p:null,s:''},
 {id:3,n:'G001',c:1,i:0,m:['Raj Kumar','Farah Aziz','Lee Wei'],p:['Smart Home Automation','Pending'],s:'lecturer2'},
 {id:4,n:'G002',c:1,i:0,m:['Siti Balqis','Hana Mohd','Omar Zain','Ben Chong'],p:null,s:''},
 {id:5,n:'Team Alpha',c:1,i:1,m:['Ali Rahman','Jun Hao','Priya Nair'],p:null,s:''},
 {id:6,n:'G003',c:1,i:0,m:['Zack Lim','Amir Faiz','Nina Ooi'],p:['IoT Environmental Monitoring','Approved'],s:'lecturer1'},
 {id:7,n:'G004',c:1,i:0,m:['Kavin Raj','Lina Ong','Sam Yap'],p:['ML Stock Predictor','Redo'],s:'lecturer1'}];
const $=id=>document.getElementById(id), ic=(n,c='')=>`<span class="material-symbols-outlined ${c}" aria-hidden="true">${n}</span>`;
const pl=(n,w)=>n+' '+w+(n==1?'':'s');
const bad=g=>g.m.length<MIN||g.m.length>MAX, L=()=>S.data==='both'?G:G.filter(g=>g.c), ug=()=>S.data==='clean'?0:UNGROUPED, nc=()=>L().filter(g=>!g.c).length, isOpen=()=>S.win==='open';
const student=()=>S.role==='leader'||S.role==='member', staff=()=>S.role==='coordinator';
const vis=()=>isOpen()?G.filter(g=>g.c):L();              /* D30: Not confirmed groups are listed only when formation is not open */
const banner=()=>staff()&&!isOpen()&&(nc()>0||ug()>0);
const bMsg=()=>{const a=nc(),u=ug();let t='<b class="font-medium">Group formation is closed.</b>';if(a)t+=` ${a>1?a+' groups are':'1 group is'} not confirmed, so their members cannot submit a proposal. Review and confirm them.`;if(u)t+=(a?'<br>':' ')+`${pl(u,'student')} ${u>1?'are':'is'} not in a group.`;return t};
const stat=g=>!g.c?'notconf':g.p?g.p[1].toLowerCase():'not_submitted';
const warnText=g=>`Warning: ${g.n} has ${g.m.length} member${g.m.length>1?'s':''}; the allowed size is ${MIN}–${MAX} members.`;
const go=t=>`alert('→ ${t}')`;

const pill=c=>c?`<span class="inline-flex rounded bg-success-container px-2.5 py-0.5 text-[12px] font-medium tracking-wide text-green-700">Confirmed</span>`
 :`<span class="inline-flex whitespace-nowrap rounded bg-surface-variant px-2.5 py-0.5 text-[12px] font-medium tracking-wide text-on-surface-variant">Not confirmed</span>`;
const BTN='inline-flex items-center justify-center rounded-full font-medium transition-colors cursor-pointer ';
const FILL=BTN+'bg-primary-strong px-5 py-2 text-sm text-white hover:bg-primary-hover',
 SMALL=BTN+'border border-outline px-4 py-1.5 text-[13px] text-primary-strong hover:bg-primary-container', DANGER=BTN+'px-3 py-2 text-sm text-error hover:bg-error-container';
const alertBox=(h,act)=>`<div class="mb-5 flex flex-col gap-3 rounded-lg border border-warning-border bg-warning-container-alt p-4 text-warning-on-container sm:flex-row sm:items-center" role="status">
 ${ic('warning','shrink-0 text-[22px] text-warning')}<div class="min-w-0 flex-1 text-sm leading-5">${h}</div>${act||''}</div>`;
const bannerBtn=`<button onclick="S.filter='notconf';draw()" class="shrink-0 self-start rounded-full border border-warning-border bg-white px-4 py-1.5 text-[13px] font-medium text-warning-on-container hover:bg-amber-50 sm:self-center">Show not confirmed</button>`;

/* ===== table ===== */
function badge(g){const s=stat(g),m={notconf:['bg-surface-variant text-on-surface-variant','bg-gray-500','Not confirmed'],approved:['bg-success-container text-green-700','bg-success','Approved'],pending:['bg-primary-container text-primary-soft','bg-primary-soft','Pending'],
 redo:['bg-warning-container-alt text-warning-strong','bg-warning-strong','Redo'],not_submitted:['bg-gray-100 text-gray-600','bg-gray-500','Not Submitted']}[s];
 return `<span class="inline-flex items-center whitespace-nowrap rounded-full px-2.5 py-1 text-[11px] font-medium ${m[0]}"><span class="mr-1.5 h-1.5 w-1.5 rounded-full ${m[1]}"></span>${m[2]}</span>`}
function tbl(){
  const q=S.q.trim(), all=vis();
  const rows=all.filter(g=>(S.sup==='all'||g.s===S.sup)&&(S.filter==='all'||stat(g)===S.filter)&&(!q||(g.n+' '+g.m.join(' ')).toLowerCase().includes(q.toLowerCase())));
  const th='border-b border-gray-200 px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-on-surface-variant select-none';
  const open=g=>E.has(g.id)||q||S.filter!=='all'||S.sup!=='all';
  const body=rows.map(g=>{const y=banner()&&!g.c, bg=y?'bg-warning-container-alt':'bg-white hover:bg-gray-50', w=bad(g)?warnText(g):'';
   return `<tr class="${bg} cursor-pointer transition-colors" onclick="E.has(${g.id})?E.delete(${g.id}):E.add(${g.id});$('tbl').innerHTML=tbl()">
    <td class="px-4 py-4 text-sm"><span class="block truncate font-medium text-gray-900">${g.n}</span></td>
    <td class="px-4 py-4"><div class="flex min-w-0 items-center gap-3"><div class="flex shrink-0 -space-x-1.5">${g.m.slice(0,3).map(n=>`<div class="relative z-10 flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-gray-200 text-[11px] font-medium text-gray-700">${n[0]}</div>`).join('')}</div>
     ${w?`<span class="material-symbols-outlined shrink-0 text-[16px] leading-none text-warning" role="img" aria-label="${w}" title="${w}">warning</span>`:''}<span class="truncate text-sm text-gray-500">${pl(g.m.length,'member')}</span></div></td>
    <td class="px-4 py-4 text-sm">${g.p?`<span class="block truncate text-gray-900">${g.p[0]}</span>`:'<span class="text-xs italic text-gray-400">-</span>'}</td>
    <td class="px-4 py-4">${badge(g)}</td>
    <td class="px-4 py-4 text-sm text-gray-600"><div class="flex items-center justify-between gap-2"><span class="truncate">${g.s||'-'}</span>${ic('expand_more','shrink-0 text-[20px] text-gray-400 transition-transform '+(open(g)?'rotate-180':''))}</div></td>
    ${staff()?`<td class="sticky right-0 w-[104px] bg-inherit px-3 py-4 text-right"><button onclick="event.stopPropagation();openM(${g.id})" aria-label="Manage ${g.n}" class="${SMALL}">Manage</button></td>`:''}</tr>
    <tr class="${open(g)?'':'hidden'} ${y?'bg-warning-container-alt':'bg-gray-50'}"><td colspan="${staff()?6:5}" class="border-t border-gray-100 px-4 py-4"><div class="flex flex-col gap-3 pl-[10%]">${g.m.map(n=>`<div class="flex items-center gap-3"><div class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-200 text-[11px] font-medium text-gray-700">${n[0]}</div><span class="text-sm text-gray-700">${n}</span></div>`).join('')}</div></td></tr>`}).join('');
  return `<div id="tbl-in" class="overflow-x-auto rounded-lg border border-gray-200"><table class="w-full min-w-[760px] table-fixed"><thead class="bg-white"><tr>
   <th class="w-[13%] ${th}">Group</th><th class="w-[25%] ${th}">Members</th><th class="w-[20%] ${th}">Project Title</th><th class="w-[15%] ${th}">Status</th><th class="w-[17%] ${th}">Supervisor</th>${staff()?`<th class="w-[104px] bg-white ${th}"><span class="sr-only">Manage</span></th>`:''}</tr></thead>
   <tbody class="divide-y divide-gray-200">${body||`<tr><td colspan="6" class="py-12 text-center"><p class="text-base font-medium text-gray-900">No groups match your current filters.</p><p class="mt-1 text-sm text-on-surface-variant">Try adjusting your search or filters.</p></td></tr>`}</tbody></table>
   <div class="border-t border-gray-200 bg-white px-4 py-3 text-sm text-gray-500">Showing <b class="font-semibold text-gray-700">${rows.length}</b> of <b class="font-semibold text-gray-700">${all.length}</b> groups</div></div>`;
}
function groups(){
  const sel='block w-full cursor-pointer rounded-md border border-gray-200 bg-gray-50 px-4 py-2 text-sm text-gray-700 outline-none focus:bg-white focus:ring-2 focus:ring-primary sm:w-[190px]';
  const opts=[['all','All Statuses'],...(!isOpen()?[['notconf','Not confirmed']]:[]),['approved','Approved'],['pending','Pending'],['redo','Redo'],['rejected','Rejected'],['not_submitted','Not Submitted']];
  return `<div class="mb-4 flex flex-col gap-4 border-b border-gray-300 pb-4">
   <div class="flex flex-wrap items-start justify-between gap-3"><div><div class="flex items-baseline gap-4"><h2 style="font-family:'DM Sans',Roboto,Arial,sans-serif" class="text-3xl font-normal tracking-tight text-gray-900">Groups</h2><span class="text-sm font-medium text-gray-500">${pl(vis().length,'group')}</span></div></div>
    ${isOpen()?`<button onclick="${go('/group_formation')}" class="inline-flex h-10 items-center gap-2 rounded-full bg-primary-strong px-6 text-sm font-medium text-white shadow-sm transition-colors hover:bg-primary-hover hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 max-sm:w-full max-sm:justify-center">${ic('groups','text-[18px]')}Group formation</button>`:''}</div>
   <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center"><div class="flex w-full flex-col items-center gap-3 sm:flex-row md:w-auto">
    <div class="relative flex w-full items-center sm:w-[240px]">${ic('search','pointer-events-none absolute left-3 text-[18px] text-gray-400')}
     <input id="q" type="text" value="${S.q}" autocomplete="off" placeholder="Search groups or students..." oninput="S.q=this.value;$('tbl').innerHTML=tbl()" class="peer block w-full rounded-md border border-gray-200 bg-gray-50 py-2 pl-9 pr-9 text-sm text-gray-700 outline-none transition-all focus:border-transparent focus:bg-white focus:ring-2 focus:ring-primary">
     <kbd aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 hidden h-5 min-w-[1.25rem] -translate-y-1/2 items-center justify-center rounded border border-outline-variant bg-gray-50 px-1 font-mono text-[11px] text-gray-400 peer-focus:hidden md:flex">/</kbd></div>
    <select onchange="S.sup=this.value;$('tbl').innerHTML=tbl()" class="${sel}"><option value="all">All Supervisors</option><option ${S.sup==='lecturer1'?'selected':''}>lecturer1</option><option ${S.sup==='lecturer2'?'selected':''}>lecturer2</option></select>
    <select onchange="S.filter=this.value;$('tbl').innerHTML=tbl()" class="${sel}">${opts.map(o=>`<option value="${o[0]}" ${S.filter===o[0]?'selected':''}>${o[1]}</option>`).join('')}</select></div>
    <div class="flex w-full items-center justify-end gap-3 md:w-auto">${staff()?`<span class="flex h-10 w-10 items-center justify-center rounded-full text-gray-500">${ic('group_add')}</span><span class="flex h-10 w-10 items-center justify-center rounded-full text-gray-500">${ic('download')}</span>`:''}</div></div></div>
   ${banner()?alertBox(bMsg(),nc()?bannerBtn:''):''}<div id="tbl">${tbl()}</div>`;
}

/* ===== Manage dialog (coordinator) ===== */
function openM(id){
  const g=G.find(x=>x.id===id), canReopen=g.c&&!g.p&&!g.i;
  const status=!g.c?`<div class="flex flex-wrap items-center justify-between gap-3">${pill(0)}<button onclick="${bad(g)?`confirmAnyway(${id})`:`doConfirm(${id})`}" class="${FILL}">Confirm group</button></div>
    <p class="mt-2 text-[13px] text-on-surface-muted">Members can't start a proposal until the group is confirmed. Confirming renames it to a G number.</p>`
   :`<div class="flex flex-wrap items-center justify-between gap-3"><span class="flex items-center gap-2">${pill(1)}</span>${canReopen?`<button onclick="reopenAsk(${id})" class="${SMALL} !px-5 !py-2 !text-sm">Reopen group</button>`:''}</div>`;
  const sec='border-b border-outline-variant py-4 last:border-0', h3="mb-2 text-[15px] font-medium text-gray-900";
  $('modal').innerHTML=`<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/30 sm:p-4" onclick="if(event.target===this)closeM()"><div class="flex max-h-[85vh] w-full max-w-lg flex-col overflow-hidden rounded-lg bg-white shadow-xl max-sm:h-dvh max-sm:max-h-none max-sm:rounded-none" role="dialog" aria-label="Manage ${g.n}">
   <div class="flex items-center justify-between px-4 pb-2 pt-3 sm:px-6 sm:pt-5"><h2 style="font-family:'DM Sans',Roboto,Arial,sans-serif" class="text-xl font-medium text-gray-900">${g.n}</h2><button onclick="closeM()" aria-label="Close" class="flex h-11 w-11 items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant sm:h-9 sm:w-9">${ic('close')}</button></div>
   <div class="min-h-0 flex-1 overflow-y-auto px-4 sm:px-6">
    ${bad(g)?`<p class="flex items-start gap-1.5 pb-1 text-sm leading-5 text-warning-strong" role="status">${ic('warning','mt-0.5 text-[16px]')}${warnText(g)}</p>`:''}
    <section class="${sec}"><h3 class="${h3}">Status</h3>${status}</section>
    <section class="${sec}"><h3 class="${h3}">MEMBERS (${g.m.length} of ${MAX})</h3>${g.m.map(n=>`<div class="flex items-center justify-between gap-3 py-1.5"><span class="flex items-center gap-3 text-sm"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-gray-200 text-[11px] text-gray-700">${n[0]}</span>${n}</span><button class="rounded-full px-3 py-1 text-[13px] text-error hover:bg-error-container">Remove</button></div>`).join('')}</section>
    <section class="${sec}"><h3 class="${h3}">Add student</h3><input placeholder="Search students..." class="block w-full rounded-md border border-outline-variant bg-surface-tint px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-primary"></section></div>
   <div class="flex flex-col-reverse gap-3 border-t border-outline-variant px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-4"><button class="${DANGER}">Delete group</button><button onclick="closeM()" class="${FILL} w-full sm:w-auto">Done</button></div></div></div>`;
}
const closeM=()=>$('modal').innerHTML='';
const note=t=>$('flash').innerHTML=`<div class="mb-4 flex items-center gap-2 rounded-lg bg-primary-container-alt px-4 py-3 text-sm text-primary-strong" role="status">${ic('check_circle','text-[18px]')}${t}</div>`;
const nextFree=p=>{const t=G.map(g=>g.n);for(let i=1;;i++){const n=p+String(i).padStart(3,'0');if(!t.includes(n))return n}};
function ask(title,body,ok,fn){$('modal').insertAdjacentHTML('beforeend',`<div id="cd" class="fixed inset-0 z-[60] flex items-center justify-center bg-black/30 p-4"><div class="w-full max-w-sm rounded-lg bg-white p-6 shadow-xl" role="alertdialog"><h2 style="font-family:'DM Sans',Roboto,Arial,sans-serif" class="text-xl font-medium text-gray-900">${title}</h2>
 <p class="mt-3 whitespace-pre-line text-sm leading-5 text-on-surface-variant">${body}</p><div class="mt-6 flex justify-end gap-2"><button onclick="$('cd').remove()" class="${BTN}px-4 py-2 text-sm text-primary-strong hover:bg-primary-container">Cancel</button><button onclick="${fn}" class="${FILL}">${ok}</button></div></div></div>`)}
function doConfirm(id){const g=G.find(x=>x.id===id),o=g.n;g.c=1;g.n=nextFree('G');closeM();note(`${o} is now confirmed as ${g.n}.`);draw()}
function doReopen(id){const g=G.find(x=>x.id===id),o=g.n;g.c=0;g.n=nextFree('Tmp');closeM();note(`${o} is reopened as ${g.n}.`);draw()}
const confirmAnyway=id=>{const g=G.find(x=>x.id===id);ask(`Confirm ${g.n} anyway?`,`This group has ${pl(g.m.length,'member')}; the minimum is ${MIN}.\n\nConfirming overrides the size limit. The group will be renamed to a G number.`,'Confirm anyway',`doConfirm(${id})`)};
const reopenAsk=id=>{const g=G.find(x=>x.id===id);ask(`Reopen ${g.n}?`,`The group becomes Not confirmed and is renamed to a Tmp number. Members can't start a proposal until it is confirmed again.`,'Reopen group',`doReopen(${id})`)};

/* ===== shell ===== */
function draw(){
  if(S.filter==='notconf'&&isOpen())S.filter='all';
  const tab=(slug,name)=>{const sel=slug==='groups';return `<a href="#" id="tab-${slug}" ${sel?'aria-current="page"':''} onclick="return false" style="font-family: 'DM Sans', Roboto, Arial, sans-serif; font-size: .875rem; font-weight: 500;" class="group h-[3rem] pt-[0.125rem] px-3 sm:px-6 flex items-center justify-center relative box-border whitespace-nowrap tracking-wide antialiased transition-colors ${sel?'text-primary-strong':'text-on-surface-variant hover:bg-surface-hover hover:text-on-surface'}">${name}<div class="absolute bottom-0 left-0 w-full h-[3px] rounded-t-[3px] transition-colors ${sel?'bg-primary-strong':'bg-transparent'}"></div></a>`};
  $('tabs').innerHTML=tab('overview','Overview')+tab('topics','Topics')+tab('people','People')+tab('groups','Groups');
  $('tabtools').innerHTML=staff()?`<a href="#" class="hidden lg:flex h-[3rem] w-[2.5rem] items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant transition-colors shrink-0" title="Edit Project Templates"><span class="material-symbols-outlined">edit_note</span></a><a href="#" class="hidden lg:flex h-[3rem] w-[3rem] items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-variant transition-colors shrink-0" title="Settings"><span class="material-symbols-outlined">settings</span></a>`:'';
  $('panel').innerHTML=groups();
}
['role','win','data'].forEach(k=>$(k).onchange=e=>{S[k]=e.target.value;$('flash').innerHTML='';draw()});
draw();
</script>
</body>
</html>
